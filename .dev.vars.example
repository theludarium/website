# Copy to .dev.vars (ignored by git) for `npx wrangler pages dev`.
# Production values are set in the Cloudflare Pages dashboard, never here.

# IPinfo token (free Lite plan works): https://ipinfo.io/account/token
IPINFO_TOKEN=

# "lite" (default) or "core" if you upgrade.
IPINFO_PLAN=lite

# Any long random string. Changing it breaks the link between old and new visits.
#   openssl rand -hex 32
VISITOR_HASH_SALT=

# Your own IPs, separated by commas or spaces, so your visits are not logged.
VISITOR_IGNORE_IPS=

# Local only: pretend every request came from this IP, to exercise the lookup.
# Never set this in production.
VISITOR_TEST_IP=
