---
// Quiet offer for a printable teach-card pack, shown on an Academy course page
// when src/lib/teach-cards.ts has a pack for that course.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { TEACH_CARD_BUNDLE, type TeachCardPack } from '@/lib/teach-cards';

interface Props {
  pack: TeachCardPack;
}

const { pack } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/teach-cards/*.jpg', { eager: true });
const image = images[`/src/assets/teach-cards/${pack.slug}.jpg`]?.default;
---

<section class="section teach-cards" aria-labelledby="teach-cards-title">
  <div class="container">
    <div class="card teach-cards__card">
      {image && <Image src={image} alt={`A sheet of ${pack.game} teach cards`} widths={[320, 640]} sizes="(max-width: 40rem) 100vw, 20rem" />}
      <div>
        <p class="eyebrow">Printable teach cards</p>
        <h2 id="teach-cards-title">Put the rules in every hand</h2>
        <p>
          18 print-and-cut cards for {pack.game}. {pack.blurb} Unofficial, written in our own words, and checked
          against the current rules.
        </p>
        <div class="teach-cards__actions">
          <a class="button" href={pack.checkout} rel="noopener">Get the cards, {pack.price}</a>
          <a href={TEACH_CARD_BUNDLE.checkout} rel="noopener">All four games, {TEACH_CARD_BUNDLE.price}</a>
        </div>
        <p class="teach-cards__fine">Instant PDF download. The course and teach sheet stay free.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .teach-cards {
    padding-top: 0;
  }

  .teach-cards__card {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
  }

  .teach-cards__card img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .teach-cards h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .teach-cards .eyebrow {
    margin: 0 0 var(--space-2);
  }

  .teach-cards__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-5);
  }

  .teach-cards__fine {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 40rem) {
    .teach-cards__card {
      grid-template-columns: 1fr;
    }
  }
</style>
