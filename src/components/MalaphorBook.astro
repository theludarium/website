---
// The malaphor field guide, with a button to buy it on Amazon. Plain links,
// not affiliate links, so no disclosure is needed. A Walnut panel in both
// themes, so the Felt Green cover stands out and the block reads as its own.
import { Image } from 'astro:assets';
import cover from '@/assets/books/malaphors-cover.jpg';
import { MALAPHOR_BOOK_URL, MALAPHOR_KINDLE_URL } from '@/lib/config';
---

<section class="book" aria-labelledby="book-title">
  <a class="book__cover" href={MALAPHOR_BOOK_URL} rel="noopener" tabindex="-1" aria-hidden="true">
    <Image src={cover} alt="" widths={[240, 480]} sizes="(max-width: 40rem) 60vw, 240px" />
  </a>

  <div class="book__copy">
    <p class="book__eyebrow">The book</p>
    <h2 id="book-title">We'll Burn That Bridge When We Get to It</h2>
    <p class="book__sub">A Field Guide to Malaphors, and the Beautiful Mess Inside Your Head</p>
    <p class="book__desc">
      148 malaphors, each traced back to its two parent idioms, scored from Bronze Bear to Golden Pope, and acted out
      in a comic strip by four old friends at a game table who never let one slide. Funny, honest about where the
      sayings really came from, and quietly smart about how your brain builds a sentence.
    </p>
    <div class="book__actions">
      <a class="button book__buy" href={MALAPHOR_BOOK_URL} rel="noopener">Buy on Amazon</a>
      <a class="book__kindle" href={MALAPHOR_KINDLE_URL} rel="noopener">Or get the Kindle edition</a>
    </div>
    <p class="book__meta">Paperback and Kindle. By Levi JA Wilson.</p>
  </div>
</section>

<style>
  .book {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
    padding: var(--space-7);
    border-radius: var(--radius-card);
    border: 1px solid rgb(246 239 227 / 0.08);
    background: var(--brand-walnut);
    color: var(--brand-parchment);
    box-shadow: var(--shadow-lg);
  }

  .book__cover {
    display: block;
    transform: rotate(-3deg);
    transition: transform var(--transition);
  }

  .book__cover:hover {
    transform: rotate(0deg) translateY(-4px);
  }

  .book__cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 18px 36px rgb(0 0 0 / 0.35), 0 3px 8px rgb(0 0 0 / 0.25);
  }

  .book__eyebrow {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-lamplight);
  }

  .book h2 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    color: var(--brand-parchment);
  }

  .book__sub {
    margin: var(--space-2) 0 var(--space-5);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: rgb(246 239 227 / 0.85);
  }

  .book__desc {
    max-width: 38rem;
    margin: 0 0 var(--space-6);
    color: rgb(246 239 227 / 0.9);
  }

  .book__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .book__buy {
    background: var(--brand-lamplight);
    border-color: var(--brand-lamplight);
    color: var(--brand-walnut);
  }

  .book__buy:hover {
    background: var(--brand-parchment);
    border-color: var(--brand-parchment);
    color: var(--brand-walnut);
  }

  .book__kindle {
    color: var(--brand-parchment);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .book__kindle:hover {
    color: var(--brand-lamplight);
  }

  .book a:focus-visible {
    outline: 3px solid var(--brand-lamplight);
    outline-offset: 3px;
  }

  .book__meta {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: rgb(246 239 227 / 0.75);
  }

  @media (max-width: 48rem) {
    .book {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding: var(--space-6) var(--space-5);
      text-align: center;
    }

    .book__cover {
      width: min(60%, 13rem);
      margin-inline: auto;
    }

    .book h2,
    .book__desc {
      margin-inline: auto;
    }

    .book__actions {
      flex-direction: column;
    }

    .book__buy {
      align-self: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book__cover,
    .book__cover:hover {
      transform: none;
    }
  }
</style>
