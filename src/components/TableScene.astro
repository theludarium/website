---
// Top-down illustration of a game night table. Placeholder hero art until
// real footage exists. Pieces lift on hover; after a pause the scene "comes
// alive" (steam, a die settles, a meeple hops). Hero.astro controls timing.
const meeple =
  'M50 0C62 0 70 9 70 21c0 6-2 10-5 13l30 12c5 2 5 10 0 12l-23 4 16 34c2 4-1 8-5 8H60L50 84l-10 20H17c-4 0-7-4-5-8l16-34-23-4c-5-2-5-10 0-12l30-12c-3-3-5-7-5-13C30 9 38 0 50 0Z';
---

<svg
  class="scene"
  viewBox="0 0 1600 900"
  preserveAspectRatio="xMidYMid slice"
  role="img"
  aria-label="A game night table seen from above: a board game in progress, cards, dice, colorful player pieces, and coffee mugs at each seat."
>
  <defs>
    <radialGradient id="ts-wood" cx="62%" cy="45%" r="75%">
      <stop offset="0" stop-color="#5c3f2b" />
      <stop offset="0.55" stop-color="#2b1e16" />
      <stop offset="1" stop-color="#160f0b" />
    </radialGradient>
    <radialGradient id="ts-light" cx="65%" cy="40%" r="45%">
      <stop offset="0" stop-color="#e0a23b" stop-opacity="0.22" />
      <stop offset="1" stop-color="#e0a23b" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="ts-coffee" cx="45%" cy="40%" r="60%">
      <stop offset="0" stop-color="#6a3f22" />
      <stop offset="1" stop-color="#2b170b" />
    </radialGradient>
    <pattern id="ts-card-back" width="16" height="16" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="16" height="16" fill="#2f5d50" />
      <rect width="8" height="16" fill="#284f44" />
    </pattern>
    <filter id="ts-shadow" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="6" dy="10" stdDeviation="8" flood-color="#000" flood-opacity="0.45" />
    </filter>
    <symbol id="ts-meeple" viewBox="0 0 100 104">
      <path d={meeple} />
    </symbol>
    <symbol id="ts-pip" viewBox="0 0 10 10">
      <circle cx="5" cy="5" r="5" />
    </symbol>
  </defs>

  <!-- Table -->
  <rect width="1600" height="900" fill="url(#ts-wood)" />
  <g fill="none" stroke="#000" stroke-opacity="0.12" stroke-width="2">
    <path d="M0 120 C400 100 900 150 1600 110" />
    <path d="M0 260 C500 240 1000 290 1600 250" />
    <path d="M0 410 C450 395 1100 440 1600 400" />
    <path d="M0 560 C500 545 1000 590 1600 555" />
    <path d="M0 720 C420 700 1050 745 1600 705" />
  </g>
  <g fill="none" stroke="#fff" stroke-opacity="0.04" stroke-width="1.5">
    <path d="M0 190 C380 175 980 215 1600 180" />
    <path d="M0 480 C520 470 980 505 1600 478" />
    <path d="M0 800 C460 785 1040 820 1600 790" />
  </g>

  <!-- Board -->
  <g transform="translate(1110 400) rotate(-7)">
    <g class="piece">
      <g filter="url(#ts-shadow)">
        <rect x="-300" y="-250" width="600" height="500" rx="18" fill="#f6efe3" />
      </g>
      <rect x="-262" y="-212" width="524" height="424" rx="6" fill="none" stroke="#e6dac6" stroke-width="30" stroke-dasharray="30 6" />
      <rect x="-262" y="-212" width="524" height="424" rx="6" fill="none" stroke="#2f5d50" stroke-opacity="0.18" stroke-width="30" stroke-dasharray="30 150" />
      <rect x="-230" y="-180" width="230" height="180" fill="#2f5d50" fill-opacity="0.12" />
      <rect x="0" y="-180" width="230" height="180" fill="#2f5d50" fill-opacity="0.12" />
      <rect x="-230" y="0" width="230" height="180" fill="#e0a23b" fill-opacity="0.14" />
      <rect x="0" y="0" width="230" height="180" fill="#b9ad9c" fill-opacity="0.12" />
      <circle r="78" fill="#f6efe3" stroke="#cdbfa9" stroke-width="3" />
      <circle r="58" fill="none" stroke="#cdbfa9" stroke-width="2" stroke-dasharray="4 8" />
      <path d="M0 -48 L12 0 L0 48 L-12 0 Z" fill="#2f5d50" fill-opacity="0.7" />
      <path d="M-48 0 L0 -10 L48 0 L0 10 Z" fill="#160f0b" fill-opacity="0.35" />
    </g>
  </g>

  <!-- Meeples on the board -->
  <g transform="translate(905 210) rotate(-20)">
    <g class="piece"><use href="#ts-meeple" width="58" height="60" x="-29" y="-30" fill="#b9ad9c" filter="url(#ts-shadow)" /></g>
  </g>
  <g transform="translate(1290 160) rotate(12)">
    <g class="piece alive-hop"><use href="#ts-meeple" width="58" height="60" x="-29" y="-30" fill="#e0a23b" filter="url(#ts-shadow)" /></g>
  </g>
  <g transform="translate(1370 560) rotate(-8)">
    <g class="piece"><use href="#ts-meeple" width="58" height="60" x="-29" y="-30" fill="#6e9c8d" filter="url(#ts-shadow)" /></g>
  </g>
  <g transform="translate(1010 470) rotate(25)">
    <g class="piece"><use href="#ts-meeple" width="58" height="60" x="-29" y="-30" fill="#f6efe3" filter="url(#ts-shadow)" /></g>
  </g>

  <!-- Card fan, bottom center -->
  <g transform="translate(560 870)">
    <g class="piece">
      <g transform="rotate(-24)"><rect x="-55" y="-150" width="110" height="160" rx="10" fill="#f6efe3" stroke="#cdbfa9" filter="url(#ts-shadow)" /><rect x="-43" y="-138" width="86" height="56" rx="5" fill="#2f5d50" fill-opacity="0.75" /><rect x="-43" y="-72" width="86" height="6" rx="3" fill="#cdbfa9" /><rect x="-43" y="-60" width="60" height="6" rx="3" fill="#cdbfa9" /></g>
      <g transform="rotate(-6)"><rect x="-55" y="-150" width="110" height="160" rx="10" fill="#f6efe3" stroke="#cdbfa9" filter="url(#ts-shadow)" /><rect x="-43" y="-138" width="86" height="56" rx="5" fill="#e0a23b" fill-opacity="0.8" /><rect x="-43" y="-72" width="86" height="6" rx="3" fill="#cdbfa9" /><rect x="-43" y="-60" width="52" height="6" rx="3" fill="#cdbfa9" /></g>
      <g transform="rotate(12)"><rect x="-55" y="-150" width="110" height="160" rx="10" fill="#f6efe3" stroke="#cdbfa9" filter="url(#ts-shadow)" /><rect x="-43" y="-138" width="86" height="56" rx="5" fill="#2f5d50" fill-opacity="0.8" /><rect x="-43" y="-72" width="86" height="6" rx="3" fill="#cdbfa9" /><rect x="-43" y="-60" width="66" height="6" rx="3" fill="#cdbfa9" /></g>
    </g>
  </g>

  <!-- Card deck, face down -->
  <g transform="translate(1500 330) rotate(14)">
    <g class="piece">
      <rect x="-58" y="-82" width="116" height="164" rx="10" fill="#1f3d35" filter="url(#ts-shadow)" />
      <rect x="-55" y="-86" width="116" height="164" rx="10" fill="#22463c" />
      <rect x="-52" y="-90" width="116" height="164" rx="10" fill="url(#ts-card-back)" stroke="#f6efe3" stroke-width="5" />
    </g>
  </g>

  <!-- Dice -->
  <g transform="translate(905 700) rotate(18)">
    <g class="piece">
      <g class="alive-roll">
        <rect x="-34" y="-34" width="68" height="68" rx="14" fill="#f6efe3" filter="url(#ts-shadow)" />
        <g fill="#2b1e16">
          <use href="#ts-pip" x="-21" y="-21" width="12" height="12" />
          <use href="#ts-pip" x="9" y="-21" width="12" height="12" />
          <use href="#ts-pip" x="-6" y="-6" width="12" height="12" />
          <use href="#ts-pip" x="-21" y="9" width="12" height="12" />
          <use href="#ts-pip" x="9" y="9" width="12" height="12" />
        </g>
      </g>
    </g>
  </g>
  <g transform="translate(1000 742) rotate(-22)">
    <g class="piece">
      <rect x="-30" y="-30" width="60" height="60" rx="12" fill="#2f5d50" filter="url(#ts-shadow)" />
      <g fill="#f6efe3">
        <use href="#ts-pip" x="-18" y="-18" width="11" height="11" />
        <use href="#ts-pip" x="-5.5" y="-5.5" width="11" height="11" />
        <use href="#ts-pip" x="7" y="7" width="11" height="11" />
      </g>
    </g>
  </g>

  <!-- Mugs at each seat -->
  <g transform="translate(560 130)">
    <g class="piece">
      <path d="M58 -22 C96 -22 96 22 58 22" fill="none" stroke="#ede3d3" stroke-width="16" stroke-linecap="round" filter="url(#ts-shadow)" />
      <circle r="62" fill="#ede3d3" filter="url(#ts-shadow)" />
      <circle r="50" fill="url(#ts-coffee)" />
      <ellipse cx="-14" cy="-16" rx="18" ry="9" fill="#fff" fill-opacity="0.12" />
    </g>
    <g class="steam" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round">
      <path d="M-12 -10 C-30 -40 6 -60 -12 -95" />
      <path d="M14 -6 C-4 -36 30 -58 12 -92" />
    </g>
  </g>
  <g transform="translate(1500 760)">
    <g class="piece">
      <path d="M-58 -22 C-96 -22 -96 22 -58 22" fill="none" stroke="#2f5d50" stroke-width="16" stroke-linecap="round" filter="url(#ts-shadow)" />
      <circle r="60" fill="#2f5d50" filter="url(#ts-shadow)" />
      <circle r="48" fill="url(#ts-coffee)" />
      <ellipse cx="-14" cy="-16" rx="17" ry="8" fill="#fff" fill-opacity="0.12" />
    </g>
    <g class="steam" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round">
      <path d="M-10 -8 C-28 -38 8 -58 -10 -92" />
      <path d="M16 -4 C-2 -34 32 -56 14 -90" />
    </g>
  </g>
  <g transform="translate(1530 90)">
    <g class="piece">
      <circle r="56" fill="#e0a23b" filter="url(#ts-shadow)" />
      <circle r="44" fill="url(#ts-coffee)" />
    </g>
  </g>

  <!-- Score pad and pencil -->
  <g transform="translate(1210 815) rotate(-10)">
    <g class="piece">
      <rect x="-70" y="-90" width="140" height="180" rx="8" fill="#f6efe3" filter="url(#ts-shadow)" />
      <g stroke="#cdbfa9" stroke-width="2">
        <path d="M-52 -50H52M-52 -20H52M-52 10H52M-52 40H52M-52 70H52" />
        <path d="M-10 -70V80M30 -70V80" />
      </g>
      <g fill="#2f5d50" font-family="Georgia, serif" font-size="18">
        <text x="-48" y="-27">12</text><text x="-48" y="3">27</text><text x="-48" y="33">41</text>
        <text x="-6" y="-27">9</text><text x="-6" y="3">22</text>
      </g>
      <g transform="translate(95 -10) rotate(28)">
        <rect x="-6" y="-80" width="12" height="150" rx="3" fill="#e0a23b" />
        <path d="M-6 70 L0 90 L6 70 Z" fill="#ede3d3" />
      </g>
    </g>
  </g>

  <!-- Warm overhead light -->
  <rect class="scene-light" width="1600" height="900" fill="url(#ts-light)" pointer-events="none" />
</svg>

<style>
  .scene {
    display: block;
    width: 100%;
    height: 100%;
  }

  .piece {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1), filter 240ms ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .piece:hover {
      transform: scale(1.06);
      filter: brightness(1.06) drop-shadow(0 18px 18px rgb(0 0 0 / 0.35));
      cursor: grab;
    }
  }

  .steam path {
    opacity: 0;
  }

  .alive-roll,
  .alive-hop {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* The scene comes alive once Hero.astro sets data-alive. */
  :global([data-alive]) .steam path {
    animation: steam 4.5s ease-in-out infinite;
  }

  :global([data-alive]) .steam path:last-child {
    animation: steam 4.5s ease-in-out 1.6s infinite;
  }

  :global([data-alive]) .alive-roll {
    animation: roll 1.1s cubic-bezier(0.2, 0.7, 0.3, 1) 0.4s both;
  }

  :global([data-alive]) .alive-hop {
    animation: hop 6s ease-in-out 2s infinite;
  }

  :global([data-alive]) .scene-light {
    animation: flicker 7s ease-in-out infinite;
  }

  :global([data-paused]) .steam path,
  :global([data-paused]) .alive-roll,
  :global([data-paused]) .alive-hop,
  :global([data-paused]) .scene-light {
    animation-play-state: paused;
  }

  @keyframes steam {
    0% { opacity: 0; transform: translateY(0); }
    30% { opacity: 0.22; }
    100% { opacity: 0; transform: translateY(-28px); }
  }

  @keyframes roll {
    0% { transform: translate(-140px, -60px) rotate(-260deg); }
    70% { transform: translate(6px, 2px) rotate(8deg); }
    100% { transform: none; }
  }

  @keyframes hop {
    0%, 86%, 100% { transform: none; }
    90% { transform: translateY(-14px) scale(1.08); }
    94% { transform: none; }
  }

  @keyframes flicker {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }
</style>
