---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// Section headings (h2) with their h3 children, for long articles.
const { headings } = Astro.props;
const sections: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = [];
for (const h of headings) {
  if (h.depth === 2) sections.push({ heading: h, children: [] });
  else if (h.depth === 3 && sections.length) sections[sections.length - 1].children.push(h);
}
---

<nav class="toc" aria-labelledby="toc-title">
  <details class="toc__details" open>
    <summary class="toc__title" id="toc-title">In this article</summary>
    <ol class="toc__list">
      {
        sections.map(({ heading, children }) => (
          <li>
            <a href={`#${heading.slug}`}>{heading.text}</a>
            {children.length > 0 && (
              <ol>
                {children.map((child) => (
                  <li>
                    <a href={`#${child.slug}`}>{child.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))
      }
    </ol>
  </details>
</nav>

<style>
  .toc {
    font-size: var(--text-sm);
  }

  .toc__details {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .toc__title {
    cursor: pointer;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .toc__list,
  .toc__list ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__list {
    margin-top: var(--space-3);
  }

  .toc__list ol {
    padding-left: var(--space-4);
  }

  .toc__list a {
    display: block;
    padding: var(--space-1) 0;
    color: var(--color-text);
    line-height: var(--leading-snug);
    text-decoration: none;
  }

  .toc__list a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
