---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<section class="page-intro">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-intro {
    padding-block: var(--space-8) var(--space-6);
  }

  .page-intro h1 {
    max-width: 18ch;
    font-size: var(--text-3xl);
  }
</style>
