---
import Logo from '@/components/Logo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { FOOTER_NAV, SITE, SOCIAL } from '@/lib/site';

const ICONS = {
  linkedin:
    'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z',
  pinterest:
    'M12.02 0C5.4 0 .03 5.37.03 11.99c0 5.08 3.16 9.42 7.62 11.17-.1-.95-.2-2.4.04-3.44l1.4-5.96s-.36-.72-.36-1.78c0-1.66.97-2.9 2.17-2.9 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 4-.28 1.2.6 2.17 1.78 2.17 2.13 0 3.77-2.25 3.77-5.49 0-2.86-2.06-4.87-5-4.87-3.4 0-5.4 2.56-5.4 5.2 0 1.03.39 2.14.89 2.74.1.12.11.22.08.34l-.33 1.36c-.05.22-.18.27-.4.16-1.5-.7-2.43-2.89-2.43-4.65 0-3.78 2.75-7.26 7.92-7.26 4.16 0 7.39 2.97 7.39 6.93 0 4.13-2.6 7.46-6.22 7.46-1.21 0-2.36-.63-2.75-1.38l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15A12 12 0 0 0 24 12C24 5.37 18.63 0 12.02 0z',
};

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo />
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <a class="button" href="/newsletter/">Join the newsletter</a>
        <ul class="site-footer__social" aria-label="The Ludarium on social media">
          {
            SOCIAL.map((s) => (
              <li>
                <a href={s.href} rel="me noopener" target="_blank" aria-label={`The Ludarium on ${s.name} (opens in a new tab)`}>
                  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d={ICONS[s.icon]} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {
        FOOTER_NAV.map((group) => (
          <nav class="site-footer__group" aria-label={group.title}>
            <h2 class="site-footer__heading">{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {SITE.name}. {SITE.shortMtp}</p>
      <div class="site-footer__legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        <button type="button" class="site-footer__linkbtn" data-consent-open hidden>Cookie settings</button>
        <ThemeToggle />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-block: var(--space-8) var(--space-5);
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--space-6);
  }

  .site-footer__tagline {
    max-width: 22rem;
    margin-block: var(--space-4) var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-2);
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-primary);
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .site-footer__social a:hover {
    background: var(--color-primary);
    color: var(--color-surface);
  }

  .site-footer__social a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .site-footer__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .site-footer__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__group li + li {
    margin-top: var(--space-1);
  }

  .site-footer__group a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__group a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .site-footer__bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .site-footer__linkbtn {
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .site-footer__legal a {
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .site-footer__top {
      grid-template-columns: repeat(3, 1fr);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
