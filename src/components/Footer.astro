---
import Logo from '@/components/Logo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import { FOOTER_NAV, SITE } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo />
        <p class="site-footer__tagline">{SITE.tagline}</p>
        <a class="button" href="/newsletter/">Join the newsletter</a>
      </div>

      {
        FOOTER_NAV.map((group) => (
          <nav class="site-footer__group" aria-label={group.title}>
            <h2 class="site-footer__heading">{group.title}</h2>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {SITE.name}. {SITE.shortMtp}</p>
      <div class="site-footer__legal">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
        <ThemeToggle />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    padding-block: var(--space-8) var(--space-5);
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-sm);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: var(--space-6);
  }

  .site-footer__tagline {
    max-width: 22rem;
    margin-block: var(--space-4) var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .site-footer__heading {
    margin: 0 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .site-footer__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer__group li + li {
    margin-top: var(--space-1);
  }

  .site-footer__group a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__group a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .site-footer__bottom {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .site-footer__legal a {
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .site-footer__top {
      grid-template-columns: repeat(3, 1fr);
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
