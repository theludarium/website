---
import { MARK_PATH, MARK_VIEWBOX } from '@/lib/brand';
---

<a class="logo" href="/" aria-label="The Ludarium, home">
  <svg class="logo__mark" viewBox={MARK_VIEWBOX} width="34" height="34" aria-hidden="true">
    <path fill="currentColor" fill-rule="evenodd" d={MARK_PATH} />
  </svg>
  <span class="logo__text"><span class="logo__the">The</span> Ludarium</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--color-text);
  }

  .logo__mark {
    color: var(--color-primary);
    flex: none;
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* A hex tile turns one step, the way a tile turns on the table */
  @media (prefers-reduced-motion: no-preference) {
    .logo:hover .logo__mark {
      transform: rotate(60deg);
    }
  }

  .logo__text {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .logo__the {
    font-weight: 400;
    font-style: italic;
  }
</style>
