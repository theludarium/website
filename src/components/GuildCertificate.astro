---
// The Expert Game Guide certificate. On the Guild page it is a preview (the
// hero image: proof of what a student earns). On /academy/guild/certificate/
// Levi fills in a name, date and number and prints it to PDF for a student
// whose capstone he accepted.
import { MARK_PATH } from '@/lib/brand';

interface Props {
  name?: string;
  date?: string;
  number?: string;
  /** Smaller, decorative version for the program page hero. */
  preview?: boolean;
}

const { name = 'Your name here', date = '', number = '', preview = false } = Astro.props;
---

<figure class:list={['cert', { 'cert--preview': preview }]} aria-label={preview ? 'A preview of the Expert Game Guide certificate' : undefined}>
  <div class="cert__frame">
    <svg class="cert__seal" viewBox="0 0 64 64" aria-hidden="true">
      <circle cx="32" cy="32" r="31" class="cert__seal-hex" />
      <circle cx="32" cy="32" r="27.5" class="cert__seal-inner" />
      <path d={MARK_PATH} fill-rule="evenodd" transform="translate(12.8 12.8) scale(0.6)" class="cert__seal-mark" />
    </svg>
    <p class="cert__org">The Ludarium Guild of Game Guides</p>
    <p class="cert__line">This certifies that</p>
    <p class="cert__name" data-cert-name>{name}</p>
    <p class="cert__line">has completed the Guild’s training and capstone, taught a newcomer who said yes to the next game, and is an</p>
    <p class="cert__title">Expert Game Guide</p>
    <div class="cert__foot">
      <span><strong>Date</strong> <span data-cert-date>{date || ' '}</span></span>
      <span class="cert__motto">The game is the reason. The people are the point.</span>
      <span><strong>No.</strong> <span data-cert-number>{number || ' '}</span></span>
    </div>
  </div>
</figure>

<style>
  .cert {
    margin: 0;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .cert__frame {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 2px solid #b9ad9c;
    border-radius: calc(var(--radius-card) - 8px);
    background: #f6efe3;
    color: #2b1e16;
    text-align: center;
  }

  .cert__seal {
    width: 4.5rem;
    height: auto;
  }

  .cert__seal-hex {
    fill: #e0a23b;
  }

  .cert__seal-inner {
    fill: none;
    stroke: #2b1e16;
    stroke-width: 2;
  }

  .cert__seal-mark {
    fill: #2b1e16;
  }

  .cert p {
    margin: 0;
  }

  .cert__org {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2f5d50;
  }

  .cert__line {
    max-width: 30ch;
    font-size: 0.9rem;
    color: #5a4a3c;
  }

  .cert__name {
    padding: 0 var(--space-4) var(--space-1);
    border-bottom: 1px solid #b9ad9c;
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-style: italic;
    line-height: 1.2;
  }

  .cert__title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.15;
    color: #2f5d50;
  }

  .cert__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid #d8cdbb;
    font-size: 0.78rem;
    color: #5a4a3c;
  }

  .cert__motto {
    font-style: italic;
  }

  .cert--preview {
    transform: rotate(-1.5deg);
  }

  .cert--preview .cert__name {
    color: #8a7a6a;
  }
</style>
