---
// The unofficial-content notice every course page, lesson, and teach sheet carries.
interface Props {
  text: string;
}
const { text } = Astro.props;
---

<p class="course-notice" data-pagefind-ignore>{text}</p>

<style>
  .course-notice {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
