---
// Shared list for the articles index and category pages: category filter
// pills, the newest article featured large, then a grid of the rest.
import ArticleCard from '@/components/ArticleCard.astro';
import CategoryFilters from '@/components/CategoryFilters.astro';
import type { Article } from '@/lib/articles';

interface Props {
  articles: Article[];
  /** Slug of the category being shown, or undefined for all articles. */
  current?: string;
}

const { articles, current } = Astro.props;
const [featured, ...rest] = articles;
---

<CategoryFilters current={current} />

{
  featured ? (
    <>
      <div class="featured">
        <ArticleCard article={featured} variant="featured" headingLevel="h2" />
      </div>
      {rest.length > 0 && (
        <div class="article-grid">
          {rest.map((article) => (
            <ArticleCard article={article} headingLevel="h2" />
          ))}
        </div>
      )}
    </>
  ) : (
    <div class="empty">
      <h2>The first articles are on the way.</h2>
      <p>Join the newsletter and we will send them to you as soon as they are published.</p>
      <a class="button" href="/newsletter/">Join the newsletter</a>
    </div>
  )
}

<style>
  .featured {
    margin-bottom: var(--space-6);
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }

  .empty {
    max-width: var(--width-content);
    padding: var(--space-7) var(--space-6);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .empty h2 {
    margin-top: 0;
    font-size: var(--text-2xl);
  }

  .empty p {
    color: var(--color-text-muted);
  }
</style>
