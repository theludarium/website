---
// One game course lesson. Same reading layout as articles and the Catan
// lessons: the lesson badge, the one idea, the body, the "at your next game"
// line, the next-lesson teaser, the pager, the signup, and the unofficial
// notice. Lessons past the course's public ones are noindex (they are reached
// from the emails), and stay out of the sitemap and site search.
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseForm from '@/components/CourseForm.astro';
import CourseNotice from '@/components/CourseNotice.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import {
  courseLessonGames,
  courseLessonMinutes,
  courseLessonSlug,
  courseLessonUrl,
  courseUrl,
  getCourseLessons,
  getGameCourses,
  lessonHasPage,
  lessonIsPublic,
  type CourseLesson,
  type GameCourse,
} from '@/lib/courses';
import { formatDate } from '@/lib/articles';
import { SITE } from '@/lib/site';
import '@/styles/prose.css';
import '@/styles/reading.css';

export async function getStaticPaths() {
  const paths = [];
  for (const course of await getGameCourses()) {
    const all = await getCourseLessons(course.id);
    for (const lesson of all.filter(lessonHasPage)) {
      paths.push({ params: { course: course.id, lesson: courseLessonSlug(lesson) }, props: { lesson, all, course } });
    }
  }
  return paths;
}

interface Props {
  lesson: CourseLesson;
  all: CourseLesson[];
  course: GameCourse;
}

const { lesson, all, course } = Astro.props;
const { title, description, pubDate, updatedDate, draft, order, oneIdea, tryThis, nextTeaser } = lesson.data;
const { Content, headings } = await render(lesson);
const d = course.data;

const index = all.findIndex((l) => l.id === lesson.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;
const total = all.length;
const minutes = courseLessonMinutes(lesson);
const showToc = headings.filter((h) => h.depth === 2).length >= 3;
const home = courseUrl(course);
const isPublic = lessonIsPublic(course, lesson);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = `/og/academy/${course.id}/${courseLessonSlug(lesson)}.png`;
// A neighbor is linked when it has a page and is public, or when this lesson is itself email-only (the reader has the course).
const linkable = (l: CourseLesson) => lessonHasPage(l) && (lessonIsPublic(course, l) || !isPublic || l.data.draft);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: title,
    description,
    url: canonical,
    learningResourceType: 'Lesson',
    teaches: oneIdea,
    timeRequired: `PT${minutes}M`,
    position: order,
    inLanguage: 'en-US',
    isAccessibleForFree: true,
    about: d.game,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: new URL(image, Astro.site).href,
    isPartOf: { '@type': 'Course', name: d.title, url: new URL(home, SITE.url).href },
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Academy', item: `${SITE.url}/academy/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: new URL(home, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={`${d.title}, lesson ${order}: ${title}`}
  noindex={draft || d.draft || !isPublic}
  games={courseLessonGames(course, lesson)}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="article lesson">
    <header class="container article__header">
      <nav class="article__crumbs" aria-label="Breadcrumb">
        <a href="/academy/">Academy</a>
        <span aria-hidden="true">/</span>
        <a href={home} data-pagefind-meta="category">{d.title}</a>
      </nav>
      {draft && <p class="article__draft"><span class="draft-badge">Draft</span> Only visible on previews. Set <code>draft: false</code> to publish.</p>}
      <p class="lesson__badge" data-pagefind-ignore>
        <span class="lesson__level">{d.game}</span>
        <span>Lesson {order} of {total}</span>
      </p>
      <h1>{title}</h1>
      <p class="article__lede">{description}</p>
      <p class="article__meta">
        <span>{minutes} min read</span>
        <span aria-hidden="true">&middot;</span>
        <span>Rules as of {d.tcg?.rulesAsOf ?? d.rulesEdition}</span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={(updatedDate ?? pubDate).toISOString()}>{updatedDate ? 'Updated ' : ''}{formatDate(updatedDate ?? pubDate)}</time>
      </p>
    </header>

    <div class:list={['container', 'article__layout', { 'has-toc': showToc }]}>
      {
        showToc && (
          <aside class="article__toc" data-pagefind-ignore>
            <TableOfContents headings={headings} title="In this lesson" />
          </aside>
        )
      }
      <div class="article__body">
        <aside class="lesson__idea" aria-label="The one idea">
          <p class="eyebrow">The one idea</p>
          <p class="lesson__idea-text">{oneIdea}</p>
        </aside>
        <div class="prose-article">
          <Content />
        </div>
        <aside class="lesson__try" aria-label="At your next game">
          <p class="eyebrow">At your next game</p>
          <p>{tryThis}</p>
        </aside>
        {
          next && (
            <section class="lesson__next" aria-labelledby="lesson-next-title" data-pagefind-ignore>
              <p class="eyebrow">Next lesson</p>
              <h2 id="lesson-next-title">{linkable(next) ? <a href={courseLessonUrl(next)}>{next.data.title}</a> : next.data.title}</h2>
              {nextTeaser && <p>{nextTeaser}</p>}
              {!linkable(next) && <p class="lesson__soon">Lessons {next.data.order} to {total} arrive by email. Sign up below and lesson one arrives right away.</p>}
            </section>
          )
        }
        <nav class="lesson__pager" aria-label="Lessons" data-pagefind-ignore>
          {
            prev && linkable(prev) ? (
              <div class="lesson__pager-item">
                <span class="lesson__pager-label">Previous</span>
                <a href={courseLessonUrl(prev)}>{prev.data.title}</a>
              </div>
            ) : (
              <div class="lesson__pager-item">
                <span class="lesson__pager-label">Course</span>
                <a href={home}>All {total} lessons</a>
              </div>
            )
          }
          {
            next && linkable(next) ? (
              <div class="lesson__pager-item lesson__pager-item--next">
                <span class="lesson__pager-label">Next</span>
                <a href={courseLessonUrl(next)}>{next.data.title}</a>
              </div>
            ) : (
              <div class="lesson__pager-item lesson__pager-item--next">
                <span class="lesson__pager-label">Course</span>
                <a href={home}>Back to the course</a>
              </div>
            )
          }
        </nav>
        <section class="article__signup lesson__signup" aria-labelledby="lesson-signup-title" data-pagefind-ignore>
          <h2 id="lesson-signup-title">{d.format === 'tcg' ? 'Want the course by email?' : 'Get every lesson by email.'}</h2>
          <p>{d.promise} Free, one short lesson at a time.</p>
          <CourseForm course={course.id} id="lesson-signup" buttonLabel={d.format === 'tcg' ? 'Send me the course' : 'Send me the lessons'} />
        </section>
        <CourseNotice text={d.notice} />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .lesson__badge {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .lesson__badge span {
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
  }

  .lesson__badge .lesson__level {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .lesson__idea,
  .lesson__try {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-md);
  }

  .lesson__idea {
    margin: 0 0 var(--space-7);
    border-left: 4px solid var(--color-cta);
    background: var(--color-accent-soft);
  }

  .lesson__try {
    margin: var(--space-7) 0 0;
    border: 1px solid var(--color-primary);
    background: var(--color-surface);
  }

  .lesson__idea .eyebrow,
  .lesson__try .eyebrow {
    margin-bottom: var(--space-2);
  }

  .lesson__idea-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .lesson__try p:last-child {
    margin: 0;
    font-size: var(--text-lg);
  }

  .lesson__next {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .lesson__next h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .lesson__next p:last-child {
    margin-bottom: 0;
  }

  .lesson__soon {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .lesson__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .lesson__pager-item {
    display: grid;
    gap: var(--space-1);
  }

  .lesson__pager-item--next {
    text-align: right;
  }

  .lesson__pager-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .lesson__signup {
    margin-top: var(--space-8);
  }
</style>
