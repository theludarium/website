---
// One game course page (every Academy course except Catan and the Game Shelf,
// which have their own static pages). Follows the course blueprint in
// docs/academy/COURSES.md: hero with the signup and the teach sheet, outcomes
// after lesson 3 and lesson 8, the lesson list, the video slot, who it is for,
// the FAQ (with FAQPage schema), related articles, and the unofficial notice.
// Every lesson is a public page; the emails pace the same lessons over time.
// TCG pages add a set-alerts form and a local-play link.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseForm from '@/components/CourseForm.astro';
import CourseNotice from '@/components/CourseNotice.astro';
import {
  FORMAT_LABEL,
  courseLessonUrl,
  getCourseLessons,
  getGameCourses,
  lessonHasPage,
  setupDiagramUrl,
  teachSheetPdfUrl,
  teachSheetUrl,
  type CourseLesson,
  type GameCourse,
} from '@/lib/courses';
import { articleUrl } from '@/lib/articles';
import { SITE } from '@/lib/site';

export async function getStaticPaths() {
  const courses = await getGameCourses();
  return Promise.all(
    courses.map(async (course) => ({ params: { course: course.id }, props: { course, lessons: await getCourseLessons(course.id) } })),
  );
}

interface Props {
  course: GameCourse;
  lessons: CourseLesson[];
}

const { course, lessons } = Astro.props;
const d = course.data;
const isTcg = d.format === 'tcg';
const first = lessons.find((l) => l.data.order === 1);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const articles = await getCollection('articles', ({ data }) => !data.draft);
const related = d.related.map((slug) => articles.find((a) => a.id === slug)).filter((a) => a !== undefined);
const lessonCount = lessons.length;
const pdf = teachSheetPdfUrl(course);
// With a level ladder, lessons are grouped by level like the Catan course.
const levels = d.levels?.map((level) => ({ ...level, lessons: lessons.filter((l) => l.data.level === level.level) }));
const levelWords = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'];
// The layout appends " | The Ludarium"; take the first title that keeps the whole under 70 characters.
const pageTitle =
  [`${d.title}: Free ${d.game} Course`, `Free ${d.game} Course: ${d.title}`, `${d.title}: A Free Course`, d.title].find((t) => t.length <= 55) ?? d.title;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: d.title,
    description: d.description,
    url: canonical,
    inLanguage: 'en-US',
    isAccessibleForFree: true,
    about: d.game,
    numberOfLessons: lessonCount,
    provider: { '@id': `${SITE.url}/#organization` },
    offers: { '@type': 'Offer', category: 'Free', price: 0, priceCurrency: 'USD' },
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'Online', courseWorkload: `PT${Math.max(1, lessonCount) * 6}M` },
    hasPart: lessons
      .filter((l) => !l.data.draft)
      .map((l) => ({ '@type': 'LearningResource', name: l.data.title, url: new URL(courseLessonUrl(l), SITE.url).href, position: l.data.order })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Academy', item: `${SITE.url}/academy/` },
      { '@type': 'ListItem', position: 2, name: d.title, item: canonical },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={d.description} noindex={d.draft} games={d.games}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="course-hero">
    <div class="container course-hero__grid">
      <div>
        <p class="eyebrow">The Ludarium Academy &middot; {FORMAT_LABEL[d.format]} &middot; Free</p>
        {d.draft && <p><span class="draft-badge">Draft</span> Only visible on previews.</p>}
        <h1>{d.title}</h1>
        <p class="course-hero__game">An unofficial {d.game} course{isTcg ? ' for beginners' : ''}</p>
        <p class="course-hero__sub">{d.promise}</p>
        <CourseForm
          course={course.id}
          id="course-signup"
          buttonLabel={isTcg ? 'Send me the course' : d.format === 'teach-tonight' ? 'Send me the teach sheet' : 'Send me lesson one, free'}
          note={isTcg ? 'Optional: every lesson is free to read right here. Unsubscribe anytime.' : 'Free, one short lesson at a time. Unsubscribe anytime.'}
        />
      </div>
      <a class="course-sheet" href={teachSheetUrl(course)}>
        <img src={setupDiagramUrl(course)} alt={d.diagramAlt} width="480" height="320" loading="eager" />
        <span class="course-sheet__label">
          <strong>Free printable teach sheet</strong>
          <span>Setup, a turn, scoring, and three tips on one page.</span>
        </span>
      </a>
    </div>
  </section>

  {
    !levels && d.format !== 'teach-tonight' && (
      <section class="section course-outcomes" aria-labelledby="course-outcomes-title">
        <div class="container">
          <h2 id="course-outcomes-title" class="visually-hidden">What you will be able to do</h2>
          <div class="course-outcomes__grid">
            <div class="card">
              <p class="eyebrow">After lesson 3</p>
              <p>{d.afterLesson3}</p>
            </div>
            <div class="card">
              <p class="eyebrow">After lesson {lessonCount || '8'}</p>
              <p>{d.afterLesson8}</p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section course-lessons" aria-labelledby="course-lessons-title">
    <div class="container">
      <div class="section-head">
        <h2 id="course-lessons-title">
          {levels ? `${levelWords[levels.length]} levels, ${lessonCount} lessons` : `${lessonCount} ${lessonCount === 1 ? 'lesson' : 'lessons'}`}
        </h2>
        {first && lessonHasPage(first) && <a class="text-link" href={courseLessonUrl(first)}>Start with lesson one</a>}
      </div>
      {
        levels && (
          <ol class="course-levels__list">
            {levels.map((level) => (
              <li class="course-level" id={`level-${level.level}`}>
                <div class="course-level__head">
                  <p class="eyebrow">
                    Level {level.level} &middot; {level.label}
                  </p>
                  <h3>{level.name}</h3>
                  <p class="course-level__outcome">
                    <strong>After this level:</strong> {level.outcome}
                  </p>
                </div>
                <ol class="course-level__lessons" data-pagefind-ignore>
                  {level.lessons.map((lesson) => (
                    <li>
                      <span class="course-level__num">{String(lesson.data.order).padStart(2, '0')}</span>
                      {lessonHasPage(lesson) ? <a href={courseLessonUrl(lesson)}>{lesson.data.title}</a> : <span>{lesson.data.title}</span>}
                      {lesson.data.draft && lessonHasPage(lesson) && <span class="draft-badge">Draft</span>}
                    </li>
                  ))}
                </ol>
              </li>
            ))}
          </ol>
        )
      }
      <ol class="course-lessons__list" hidden={!!levels}>
        {
          lessons.map((lesson) => {
            const linked = lessonHasPage(lesson);
            return (
              <li>
                <span class="course-lessons__num">{lesson.data.order}</span>
                <span class="course-lessons__text">
                  {linked ? <a href={courseLessonUrl(lesson)}>{lesson.data.title}</a> : <span>{lesson.data.title}</span>}
                  {lesson.data.draft && lessonHasPage(lesson) && <span class="draft-badge">Draft</span>}
                </span>
              </li>
            );
          })
        }
      </ol>
      <p class="course-lessons__note">
        Every lesson is free to read here, any time. Sign up and they also arrive by email, one at a time, so the
        course keeps you learning between game nights.
      </p>
    </div>
  </section>

  {
    d.videoId && (
      <section class="section course-video" aria-labelledby="course-video-title">
        <div class="container">
          <h2 id="course-video-title">Watch the teach</h2>
          <div class="course-video__frame">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${d.videoId}`}
              title={`How to play ${d.game}, from The Ludarium`}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        </div>
      </section>
    )
  }

  <section class="section course-for" aria-labelledby="course-for-title">
    <div class="container course-for__grid">
      <div>
        <h2 id="course-for-title">Who it is for</h2>
        <ul class="course-for__list">
          {d.audience.map((line) => <li>{line}</li>)}
        </ul>
      </div>
      <dl class="course-facts">
        <div><dt>Players</dt><dd>{d.players}</dd></div>
        <div><dt>Play time</dt><dd>{d.playTime}</dd></div>
        {d.ages && <div><dt>Ages</dt><dd>{d.ages}</dd></div>}
        <div><dt>Rules as of</dt><dd>{d.tcg?.rulesAsOf ?? d.rulesEdition}</dd></div>
        {d.tcg && <div><dt>Start with</dt><dd>{d.tcg.starter}</dd></div>}
        {d.tcg && <div><dt>First store event</dt><dd>{d.tcg.firstEvent}</dd></div>}
      </dl>
    </div>
  </section>

  {
    isTcg && (
      <section class="section course-tcg" aria-labelledby="course-tcg-title">
        <div class="container course-tcg__grid">
          <div class="card">
            <h2 id="course-tcg-title">Set alerts</h2>
            <p>Release dates, a prerelease checklist, and beginner buying notes before every new {d.game} set.</p>
            <CourseForm course={course.id} id="course-alerts" kind="alerts" buttonLabel="Send me set alerts" />
          </div>
          <div class="card">
            <h2>Play near me</h2>
            <p>
              Learning in Indianapolis? Join the Indianapolis list for first word on local learn-to-play nights as The
              Ludarium grows toward its first lounge.
            </p>
            <a class="button button--ghost" href="/lounges/indianapolis/">Join the Indianapolis list</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="section course-faq" aria-labelledby="course-faq-title">
    <div class="container">
      <h2 id="course-faq-title">Questions</h2>
      <div class="course-faq__list">
        {
          d.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section course-related" aria-labelledby="course-related-title" data-pagefind-ignore>
        <div class="container">
          <h2 id="course-related-title">Read next</h2>
          <ul class="course-related__list">
            {related.map((a) => (
              <li>
                <a href={articleUrl(a)}>{a.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="container course-notice-wrap">
    <p class="course-sheet-links">
      <a href={teachSheetUrl(course)}>Teach sheet</a> &middot;{' '}
      <a href={pdf} download data-ott-event="download" data-ott-game={d.games.join(',') || undefined}>PDF</a> &middot; Rules as described in
      the {d.rulesEdition}; <a href={d.rulesSource} rel="noopener">official rules</a>.
    </p>
    <CourseNotice text={d.notice} />
  </section>
</BaseLayout>

<style>
  .course-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .course-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: start;
    gap: var(--space-7);
  }

  .course-hero h1 {
    margin-bottom: var(--space-2);
    font-size: var(--text-4xl);
  }

  .course-hero__game {
    margin: 0 0 var(--space-4);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .course-hero__sub {
    max-width: 36rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .course-sheet {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }

  .course-sheet img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: var(--brand-parchment);
  }

  .course-sheet__label {
    display: grid;
    gap: var(--space-1);
    padding-inline: var(--space-2);
  }

  .course-sheet__label span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .course-sheet:hover strong {
    text-decoration: underline;
  }

  .course-outcomes {
    padding-top: 0;
  }

  .course-outcomes__grid,
  .course-tcg__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }

  .course-outcomes .card p:last-child {
    margin: 0;
    font-size: var(--text-lg);
  }

  .course-levels__list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-level {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    scroll-margin-top: var(--space-6);
  }

  .course-level h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .course-level__outcome {
    margin: 0;
    color: var(--color-text-muted);
  }

  .course-level__lessons {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-level__lessons li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .course-level__num {
    flex: none;
    min-width: 2ch;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .course-lessons__list[hidden] {
    display: none;
  }

  .course-lessons__list {
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .course-lessons__list li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .course-lessons__num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
  }

  .course-lessons__text {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-lg);
  }

  .course-lessons__text > span:first-child {
    color: var(--color-text);
  }


  .course-lessons__note {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .course-video__frame {
    position: relative;
    max-width: 56rem;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .course-video__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .course-for__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: var(--space-7);
    align-items: start;
  }

  .course-for__list {
    display: grid;
    gap: var(--space-3);
    padding-left: 1.2em;
    font-size: var(--text-lg);
  }

  .course-facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
  }

  .course-facts div {
    display: grid;
    gap: 2px;
  }

  .course-facts dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .course-facts dd {
    margin: 0;
  }

  .course-tcg h2 {
    margin-top: 0;
    font-size: var(--text-2xl);
  }

  .course-faq__list {
    display: grid;
    gap: var(--space-3);
    max-width: 48rem;
  }

  .course-faq details {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .course-faq summary {
    font-weight: 650;
    cursor: pointer;
  }

  .course-faq details p {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }

  .course-related__list {
    display: grid;
    gap: var(--space-2);
    padding-left: 1.2em;
  }

  .course-notice-wrap {
    padding-bottom: var(--space-8);
  }

  .course-sheet-links {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .course-hero__grid,
    .course-for__grid,
    .course-level {
      grid-template-columns: 1fr;
    }
  }
</style>
