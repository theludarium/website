---
// The Game Shelf course: the six-series Game Shelf article cluster, read in
// order. Like the Catan course page: the series email signup above the fold,
// then every series in reading order with its articles numbered and
// summarized. The articles themselves live in the articles collection (most
// in the Game Shelf category, a few in Game Night and Magic & Cube). Drafts
// hold their place as plain titles until they publish. This static route
// wins over [course]/index.astro, which only knows lesson-based courses.
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { KIT_OFFER_FORMS } from '@/lib/config';
import { articleUrl, categoryUrl, SHOW_DRAFTS } from '@/lib/articles';
import { GAME_SHELF_CATEGORY_SLUG, GAME_SHELF_COURSE, GAME_SHELF_SERIES } from '@/lib/game-shelf';
import { CATEGORIES, SITE } from '@/lib/site';

const category = CATEGORIES.find((c) => c.slug === GAME_SHELF_CATEGORY_SLUG);
if (!category) throw new Error(`No category with slug ${GAME_SHELF_CATEGORY_SLUG}`);
const offer = KIT_OFFER_FORMS['game-shelf'];

// Every article, drafts included, so an unpublished one can hold its place as a plain title.
const everything = await getCollection('articles');
const bySlug = new Map(everything.map((a) => [a.id, a]));
const series = GAME_SHELF_SERIES.map((s, i) => ({
  ...s,
  number: i + 1,
  articles: s.articles.map((entry, j) => {
    const article = bySlug.get(entry.slug);
    if (!article) throw new Error(`Game Shelf series "${s.name}" lists an unknown article: ${entry.slug}`);
    const draft = article.data.draft;
    return { ...entry, number: j + 1, article, draft, hasPage: !draft || SHOW_DRAFTS };
  }),
}));
const total = series.reduce((n, s) => n + s.articles.length, 0);
const firstArticle = series[0].articles[0];

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: GAME_SHELF_COURSE.title,
    description: category.description,
    url: canonical,
    isPartOf: { '@id': `${SITE.url}/#website` },
    hasPart: series.map((s) => ({
      '@type': 'ItemList',
      name: s.name,
      description: s.summary,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: s.articles
        .filter((a) => !a.draft)
        .map((a) => ({
          '@type': 'ListItem',
          position: a.number,
          name: a.article.data.title,
          url: new URL(articleUrl(a.article), SITE.url).href,
        })),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Academy', item: `${SITE.url}/academy/` },
      { '@type': 'ListItem', position: 2, name: GAME_SHELF_COURSE.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={`${GAME_SHELF_COURSE.title}: Six Series on Building a Game Library`}
  description="A free course in six article series on building, sharing, and organizing a board game collection: one copy per group, cost per play, smart buying, and more."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="hub-hero">
    <div class="container hub-hero__grid">
      <div>
        <p class="eyebrow">The Ludarium Academy &middot; Free course</p>
        <h1>{GAME_SHELF_COURSE.title}</h1>
        <p class="hub-hero__sub">
          {category.description} Six series and {total} short articles, in an order that builds. Read them here, or
          get one per email on Tuesday and Friday mornings.
        </p>
        <NewsletterForm
          id="hub-signup"
          buttonLabel={offer.buttonLabel}
          formAction={offer.action}
          note="Free. Two short emails a week, with the full article one click away. Unsubscribe anytime."
        />
      </div>
      <nav class="hub-map" aria-labelledby="hub-map-title">
        <p class="eyebrow" id="hub-map-title">The six series</p>
        <ol class="hub-map__list">
          {
            series.map((s) => (
              <li>
                <a href={`#${s.slug}`}>
                  <span class="hub-map__num">{s.number}</span>
                  <span class="hub-map__name">{s.name}</span>
                  <span class="hub-map__count">{s.articles.length} articles</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <section class="section hub-series" aria-labelledby="hub-series-title">
    <div class="container">
      <div class="section-head">
        <h2 id="hub-series-title">Six series, {total} articles</h2>
        {firstArticle.hasPage && <a class="text-link" href={articleUrl(firstArticle.article)}>Start with the first one</a>}
      </div>
      <ol class="hub-series__list">
        {
          series.map((s) => (
            <li class="series" id={s.slug}>
              <div class="series__head">
                <p class="eyebrow">
                  Series {s.number} &middot; {s.articles.length} articles
                </p>
                <h3>{s.name}</h3>
                <p class="series__summary">{s.summary}</p>
              </div>
              <ol class="series__articles">
                {s.articles.map((a) => (
                  <li class:list={['series__article', { 'series__article--draft': !a.hasPage }]}>
                    <span class="series__num" aria-hidden="true">
                      {a.number}
                    </span>
                    <div class="series__text">
                      <p class="series__title">
                        {a.hasPage ? <a href={articleUrl(a.article)}>{a.article.data.title}</a> : <span>{a.article.data.title}</span>}
                        {a.draft && a.hasPage && <span class="draft-badge">Draft</span>}
                        {!a.hasPage && <span class="series__soon">Coming soon</span>}
                      </p>
                      <p class="series__line">{a.summary}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>
      <p class="hub-series__more">
        Want the newest first instead? <a href={categoryUrl(category.name)}>Browse the {category.name} category</a>.
      </p>
    </div>
  </section>

  <section class="section hub-signup" aria-labelledby="hub-signup-title">
    <div class="container hub-signup__inner">
      <h2 id="hub-signup-title">Read them in order, by email.</h2>
      <p>
        {offer.lede}
      </p>
      <NewsletterForm id="hub-signup-end" buttonLabel={offer.buttonLabel} formAction={offer.action} />
    </div>
  </section>
</BaseLayout>

<style>
  .hub-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .hub-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: start;
    gap: var(--space-7);
  }

  .hub-hero h1 {
    font-size: var(--text-4xl);
  }

  .hub-hero__sub {
    max-width: 36rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hub-map {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
  }

  .hub-map .eyebrow {
    color: var(--color-text);
  }

  .hub-map__list {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hub-map__list a {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid rgb(43 30 22 / 0.12);
  }

  .hub-map__list li:last-child a {
    border-bottom: 0;
  }

  .hub-map__list a:hover .hub-map__name {
    text-decoration: underline;
  }

  .hub-map__num {
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .hub-map__name {
    font-weight: 600;
  }

  .hub-map__count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .hub-series__list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hub-series__more {
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
  }

  .series {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    scroll-margin-top: var(--space-6);
  }

  .series h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .series__summary {
    margin: 0;
    color: var(--color-text-muted);
  }

  .series__articles {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series__article {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr);
    gap: var(--space-3);
  }

  .series__num {
    padding-top: 0.15em;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .series__text p {
    margin: 0;
  }

  .series__title {
    font-weight: 650;
  }

  .series__title a {
    text-decoration: none;
  }

  .series__title a:hover {
    text-decoration: underline;
  }

  .series__title .draft-badge,
  .series__soon {
    margin-left: var(--space-2);
    vertical-align: middle;
  }

  .series__article--draft .series__title span:first-child {
    color: var(--color-text-muted);
  }

  .series__soon {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .series__line {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }

  .hub-signup {
    padding-bottom: var(--space-8);
  }

  .hub-signup__inner {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    max-width: calc(var(--width-content) + 2 * var(--gutter));
  }

  .hub-signup h2 {
    margin: 0;
    font-size: var(--text-3xl);
  }

  .hub-signup p {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .hub-hero__grid,
    .series {
      grid-template-columns: 1fr;
    }
  }
</style>
