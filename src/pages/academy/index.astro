---
// The Ludarium Academy landing page: what the Academy is, then the course
// catalog. Each course has its own page with its signup, so this page carries
// no form. Lesson-based courses come from COURSES (src/lib/academy.ts); the
// Game Shelf course is the Game Shelf article series (src/lib/game-shelf.ts).
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { COURSES, getAllLessons, lessonUrl } from '@/lib/academy';
import { articleUrl, SHOW_DRAFTS } from '@/lib/articles';
import { GAME_SHELF_COURSE, GAME_SHELF_SERIES } from '@/lib/game-shelf';
import { GUILD } from '@/lib/guild';
import { FORMAT_LABEL, courseLessonUrl, courseTrack, courseUrl, getCourseLessons, getGameCourses, lessonHasPage } from '@/lib/courses';

interface CatalogCard {
  /** The course slug, used to pick the Start here cards. */
  slug: string;
  /** The game's name, for the Start here cards. */
  game: string;
  /** Catalog section the card sits in. */
  group: 'Board games' | 'Trading card games' | 'Game library';
  track: string;
  title: string;
  href: string;
  description: string;
  /** Lesson counts, as a sentence. */
  meta: string;
  /** The first lesson, when it has a page. */
  first?: { label: string; href: string };
  /** Original card art at public/academy/<slug>/card.svg, shown across the top of the card. */
  image?: string;
}

/** A course's card art, when its file exists. */
const cardArt = (slug: string) => (fs.existsSync(`public/academy/${slug}/card.svg`) ? `/academy/${slug}/card.svg` : undefined);

const lessonCourses: CatalogCard[] = await Promise.all(
  COURSES.map(async (course) => {
    const lessons = await getAllLessons(course.slug);
    const live = lessons.filter((l) => !l.data.draft);
    const first = live[0];
    return {
      slug: course.slug,
      game: course.shortTitle,
      group: 'Board games' as const,
      track: 'Game strategy',
      title: course.title,
      href: `/academy/${course.slug}/`,
      description: course.description,
      meta: `${lessons.length} lessons in six levels${live.length < lessons.length ? `. ${live.length} ready to read now, more added as they are written.` : '.'}`,
      first: first && { label: 'Read lesson one', href: lessonUrl(first) },
      image: cardArt(course.slug),
    };
  }),
);

const articles = await getCollection('articles');
const shelfSlugs = GAME_SHELF_SERIES.flatMap((s) => s.articles.map((a) => a.slug));
const shelfLive = shelfSlugs.filter((slug) => articles.find((a) => a.id === slug && !a.data.draft));
const shelfFirst = articles.find((a) => a.id === shelfSlugs[0]);
const shelfCourse: CatalogCard = {
  slug: GAME_SHELF_COURSE.slug,
  game: GAME_SHELF_COURSE.title,
  group: 'Game library',
  track: GAME_SHELF_COURSE.track,
  title: GAME_SHELF_COURSE.title,
  href: `/academy/${GAME_SHELF_COURSE.slug}/`,
  description: GAME_SHELF_COURSE.description,
  meta: `${shelfSlugs.length} articles in ${GAME_SHELF_SERIES.length} series${shelfLive.length < shelfSlugs.length ? `. ${shelfLive.length} ready to read now, more as they publish.` : '.'}`,
  first:
    shelfFirst && (!shelfFirst.data.draft || SHOW_DRAFTS)
      ? { label: 'Read the first article', href: articleUrl(shelfFirst) }
      : undefined,
  image: cardArt(GAME_SHELF_COURSE.slug),
};

const gameCourses: CatalogCard[] = await Promise.all(
  (await getGameCourses()).map(async (course) => {
    const lessons = await getCourseLessons(course.id);
    const first = lessons.find((l) => l.data.order === 1);
    const d = course.data;
    return {
      slug: course.id,
      game: d.game,
      group: courseTrack(course),
      track: `${d.game} · ${FORMAT_LABEL[d.format]}`,
      title: d.title,
      href: courseUrl(course),
      description: d.description,
      meta:
        d.format === 'teach-tonight'
          ? 'A printable teach sheet and two short emails.'
          : d.levels
            ? `${lessons.length} lessons in ${['zero', 'one', 'two', 'three', 'four', 'five', 'six'][d.levels.length]} levels, and a printable teach sheet.`
            : `${lessons.length} lessons and a printable teach sheet.`,
      first: first && lessonHasPage(first) ? { label: 'Read lesson one', href: courseLessonUrl(first) } : undefined,
      image: cardArt(course.id),
    };
  }),
);

const catalog = [...lessonCourses, ...gameCourses, shelfCourse];

// The Start here row: the games with the biggest audiences, including the two
// largest card games, so newcomers see them first. Each still appears in its group.
const START_HERE = ['catan', 'ticket-to-ride', 'wingspan', 'codenames', 'pokemon-tcg', 'magic'];
const startHere = START_HERE.map((slug) => catalog.find((c) => c.slug === slug)).filter((c): c is CatalogCard => Boolean(c));
const groups = (['Board games', 'Trading card games', 'Game library'] as const)
  .map((name) => ({ name, cards: catalog.filter((c) => c.group === name) }))
  .filter((g) => g.cards.length > 0);
---

<BaseLayout
  title="The Ludarium Academy: Free Courses for Tabletop Players"
  description="Free courses from The Ludarium, one short lesson at a time by email and on the site: Catan strategy from table to championship, and building a game library."
>
  <section class="academy-hero">
    <div class="container academy-hero__grid">
      <div class="academy-hero__text">
        <p class="eyebrow">The Ludarium Academy</p>
        <h1>Get good at the games you love.</h1>
        <p class="academy-hero__sub">
          Free courses for tabletop players, taught one short lesson at a time, by email and on the site. Strategy for
          the games you keep coming back to, and the craft around the table: building a game library, running a play
          group, and soon, designing games. Pick a course, start with lesson one, and go at your own pace.
        </p>
      </div>
      <img
        class="academy-hero__art"
        src="/academy/hero.svg"
        alt="Six hex tiles climbing from level 0 to level 5, with a meeple at the start and a trophy at the top: six levels from first game to championship, one lesson at a time."
        width="560"
        height="480"
        fetchpriority="high"
      />
    </div>
  </section>

  <section class="container academy-guild" aria-labelledby="academy-guild-title">
    <a class="academy-guild__art" href="/academy/guild/" tabindex="-1" aria-hidden="true">
      <img src="/academy/guild/card.svg" alt="" width="640" height="360" loading="lazy" />
    </a>
    <div class="academy-guild__text">
      <p class="eyebrow">Free training program &middot; Earn a certificate</p>
      <h2 id="academy-guild-title"><a href="/academy/guild/">{GUILD.title}</a></h2>
      <p>
        The skill under every course here: teaching a game so newcomers love it. 35 short lessons, a printable toolkit,
        and a capstone that makes you an {GUILD.credential}.
      </p>
      <a class="button" href="/academy/guild/">Start the training</a>
    </div>
  </section>

  <section class="section academy-catalog" aria-labelledby="academy-catalog-title">
    <div class="container">
      <div class="section-head">
        <h2 id="academy-catalog-title">Courses</h2>
        <p>Every course is free to read, start to finish.</p>
      </div>
      {
        startHere.length > 0 && (
          <div class="academy-start">
            <h3 class="academy-group__title">Start here</h3>
            <p class="academy-start__sub">The games most players already own, each from lesson one.</p>
            <ul class="academy-start__grid">
              {startHere.map((course) => (
                <li class="card academy-start__card">
                  {course.image && (
                    <a class="academy-art-link" href={course.href} tabindex="-1" aria-hidden="true">
                      <img class="academy-start__art" src={course.image} alt="" width="640" height="360" loading="lazy" />
                    </a>
                  )}
                  <p class="eyebrow">{course.game}</p>
                  <h4>
                    <a href={course.href}>{course.title}</a>
                  </h4>
                  {course.first && (
                    <a class="text-link" href={course.first.href}>
                      {course.first.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        groups.map((group) => (
          <div class="academy-group">
            {groups.length > 1 && <h3 class="academy-group__title">{group.name}</h3>}
            <div class="academy-catalog__grid">
              {group.cards.map((course) => (
                <article class="card academy-course">
                  {course.image && (
                    <a class="academy-art-link" href={course.href} tabindex="-1" aria-hidden="true">
                      <img class="academy-course__art" src={course.image} alt="" width="640" height="360" loading="lazy" />
                    </a>
                  )}
                  <p class="eyebrow">
                    {course.track} &middot; Free
                  </p>
                  <h3>
                    <a href={course.href}>{course.title}</a>
                  </h3>
                  <p>{course.description}</p>
                  <p class="academy-course__meta">{course.meta}</p>
                  {course.first && (
                    <a class="text-link" href={course.first.href}>
                      {course.first.label}
                    </a>
                  )}
                </article>
              ))}
            </div>
          </div>
        ))
      }
      <p class="academy-catalog__note">
        More courses are in the works, in game strategy, game libraries, and game design. Subscribers hear first.
      </p>
    </div>
  </section>

  <section class="section academy-how" aria-labelledby="academy-how-title">
    <div class="container">
      <h2 id="academy-how-title">How the Academy works</h2>
      <ul class="academy-how__list">
        <li>
          <h3>One idea per lesson.</h3>
          <p>Each lesson is a short read with one thing to try at your next game night. No lectures, no homework you will not do.</p>
        </li>
        <li>
          <h3>By email, at your pace.</h3>
          <p>Sign up on a course page and the lessons arrive on a schedule. Pause from any email when life gets busy, and pick up where you left off.</p>
        </li>
        <li>
          <h3>Every lesson, right here.</h3>
          <p>Every lesson of every course is free to read on the site, any time. Read ahead, go back, or work through a course on your own.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section academy-faq" aria-labelledby="academy-faq-title">
    <div class="container">
      <h2 id="academy-faq-title" class="visually-hidden">Common questions</h2>
      <ul class="academy-faq__list">
        <li>
          <h3>Is it really free?</h3>
          <p>Yes. Every lesson is free, on the site or by email. No card, no trial.</p>
        </li>
        <li>
          <h3>I am new to this. Is it for me?</h3>
          <p>Yes. Each course starts with the first thing a newcomer needs and builds from there. If you already know the basics, the early lessons go quickly.</p>
        </li>
        <li>
          <h3>How much email will I get?</h3>
          <p>Only from the courses you join: a few short lessons a week at most. Every email has a link to pause, and you can unsubscribe anytime.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .academy-guild {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: var(--space-6);
    margin-block: var(--space-6);
    padding: var(--space-5);
    border: 2px solid var(--color-cta);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
  }

  .academy-guild__art img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-card) - 8px);
  }

  .academy-guild h2 {
    margin: var(--space-2) 0;
    font-size: var(--text-2xl);
  }

  .academy-guild h2 a {
    color: inherit;
    text-decoration: none;
  }

  .academy-guild__text p:not(.eyebrow) {
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .academy-guild {
      grid-template-columns: 1fr;
    }
  }
  .academy-hero {
    padding-block: var(--space-8) var(--space-4);
  }

  .academy-hero h1 {
    max-width: 18ch;
    font-size: var(--text-4xl);
  }

  /* Text on the left, the level ladder art on the right; stacked on small screens. */
  .academy-hero__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .academy-hero__art {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    border-radius: var(--radius-card);
  }

  @media (min-width: 56rem) {
    .academy-hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 30rem);
      gap: var(--space-8);
    }

    .academy-hero__art {
      max-width: none;
      justify-self: end;
    }
  }

  .academy-hero__sub {
    max-width: 40rem;
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  /* The card art links to the course too. It is skipped by keyboard and screen
     readers, since the title link right below goes to the same page. */
  .academy-art-link {
    display: block;
  }

  .academy-art-link img {
    transition: opacity 0.2s ease;
  }

  .academy-art-link:hover img {
    opacity: 0.9;
  }

  .academy-start {
    margin-bottom: var(--space-7);
  }

  .academy-start__sub {
    margin: calc(-1 * var(--space-2)) 0 var(--space-4);
    color: var(--color-text-muted);
  }

  /* Six picks: one, two, or three across, so the rows always come out even. */
  .academy-start__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 34rem) {
    .academy-start__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 52rem) {
    .academy-start__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .academy-start__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .academy-start__card .eyebrow {
    margin: 0;
  }

  .academy-start__card h4 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .academy-start__card h4 a {
    text-decoration: none;
  }

  .academy-start__card h4 a:hover {
    text-decoration: underline;
  }

  .academy-start__card .text-link {
    margin-top: auto;
  }

  .academy-start__art {
    display: block;
    width: calc(100% + 2 * var(--space-6));
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    margin: calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) var(--space-3);
    border-radius: calc(var(--radius-card) - 1px) calc(var(--radius-card) - 1px) 0 0;
    object-fit: cover;
  }

  .academy-group + .academy-group {
    margin-top: var(--space-7);
  }

  .academy-group__title {
    margin: 0 0 var(--space-4);
    font-size: var(--text-2xl);
  }

  .academy-catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }

  .academy-course__art {
    display: block;
    width: calc(100% + 2 * var(--space-6));
    max-width: none;
    height: auto;
    aspect-ratio: 16 / 9;
    margin: calc(-1 * var(--space-6)) calc(-1 * var(--space-6)) var(--space-5);
    border-radius: calc(var(--radius-card) - 1px) calc(var(--radius-card) - 1px) 0 0;
    object-fit: cover;
  }

  .academy-course h3 {
    margin: 0 0 var(--space-3);
  }

  .academy-course h3 a {
    text-decoration: none;
  }

  .academy-course h3 a:hover {
    text-decoration: underline;
  }

  .academy-course__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .academy-catalog__note {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .academy-how h2 {
    margin-bottom: var(--space-6);
    font-size: var(--text-3xl);
  }

  .academy-how__list,
  .academy-faq__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .academy-how__list h3,
  .academy-faq__list h3 {
    margin-top: 0;
    font-size: var(--text-xl);
  }

  .academy-how__list p,
  .academy-faq__list p {
    color: var(--color-text-muted);
  }
</style>
