---
// The Ludarium Academy landing page. One job: start someone on a free course.
// Follows the landing page rules in CLAUDE.md: headline, subheadline, proof,
// one form, three objections below the fold, legal links in the form.
import BaseLayout from '@/layouts/BaseLayout.astro';
import AcademyForm from '@/components/AcademyForm.astro';
import { COURSES, getAllLessons, lessonUrl } from '@/lib/academy';

const catalog = await Promise.all(
  COURSES.map(async (course) => {
    const lessons = await getAllLessons(course.slug);
    const live = lessons.filter((l) => !l.data.draft);
    return { course, total: lessons.length, live: live.length, first: live[0] };
  }),
);
const featured = catalog[0];
---

<BaseLayout
  title="The Ludarium Academy: Free Game Strategy Courses"
  description="Free game strategy courses from The Ludarium, one short lesson at a time by email. Start with Road to the Catan Championship, from kitchen table to tournament table."
>
  <section class="academy-hero">
    <div class="container academy-hero__grid">
      <div>
        <p class="eyebrow">The Ludarium Academy</p>
        <h1>Get good at the games you love.</h1>
        <p class="academy-hero__sub">
          Free strategy courses, one short lesson at a time by email. The first one takes you from the kitchen
          table to the tournament table in Catan, one level at a time.
        </p>
        <AcademyForm course={featured.course.slug} id="academy-signup" buttonLabel="Start the Catan course, free" />
      </div>

      <a class="academy-card" href={`/academy/${featured.course.slug}/`}>
        <p class="eyebrow">Free course &middot; {featured.total} lessons</p>
        <h2>{featured.course.title}</h2>
        <p>{featured.course.promise}</p>
        <ol class="academy-card__levels">
          {featured.course.levels.map((level) => (
            <li>
              <span>{level.level}</span> {level.name}
            </li>
          ))}
        </ol>
        <span class="academy-card__more">See the course</span>
      </a>
    </div>
  </section>

  <section class="section academy-catalog" aria-labelledby="academy-catalog-title">
    <div class="container">
      <h2 id="academy-catalog-title">Courses</h2>
      <div class="academy-catalog__grid">
        {
          catalog.map(({ course, total, live, first }) => (
            <article class="card academy-course">
              <p class="eyebrow">Game strategy &middot; Free</p>
              <h3>
                <a href={`/academy/${course.slug}/`}>{course.title}</a>
              </h3>
              <p>{course.description}</p>
              <p class="academy-course__meta">
                {total} lessons in six levels{live < total ? `. ${live} ready to read now, more added as they are written.` : '.'}
              </p>
              {first && (
                <a class="text-link" href={lessonUrl(first)}>
                  Read lesson one
                </a>
              )}
            </article>
          ))
        }
      </div>
      <p class="academy-catalog__note">More courses in game strategy and game design are in the works. Subscribers hear first.</p>
    </div>
  </section>

  <section class="section academy-faq" aria-labelledby="academy-faq-title">
    <div class="container">
      <h2 id="academy-faq-title" class="visually-hidden">Common questions</h2>
      <ul class="academy-faq__list">
        <li>
          <h3>Is it really free?</h3>
          <p>Yes. Every lesson is free to read on the site, and the emails are free too. No card, no trial.</p>
        </li>
        <li>
          <h3>I have barely played. Is this for me?</h3>
          <p>Yes. The course starts with how to set up the board and builds from there. If you already know the basics, the first level goes quickly.</p>
        </li>
        <li>
          <h3>How much email will I get?</h3>
          <p>A few short lessons a week at most. Every email has a link to pause, and you can unsubscribe anytime.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .academy-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .academy-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: start;
    gap: var(--space-7);
  }

  .academy-hero h1 {
    font-size: var(--text-4xl);
  }

  .academy-hero__sub {
    max-width: 36rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .academy-card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-primary);
    color: var(--color-on-primary);
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transition: transform var(--transition);
  }

  .academy-card:hover {
    transform: translateY(-2px);
  }

  .academy-card .eyebrow,
  .academy-card h2,
  .academy-card p {
    margin: 0;
    color: inherit;
  }

  .academy-card h2 {
    font-size: var(--text-2xl);
  }

  .academy-card__levels {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0;
    padding: 0;
    list-style: none;
  }

  .academy-card__levels li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 600;
  }

  .academy-card__levels span {
    display: inline-grid;
    place-items: center;
    width: 1.9em;
    height: 1.9em;
    clip-path: polygon(25% 5%, 75% 5%, 100% 50%, 75% 95%, 25% 95%, 0 50%);
    background: var(--color-cta);
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .academy-card__more {
    font-weight: 600;
    text-decoration: underline;
  }

  .academy-catalog__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
  }

  .academy-course h3 a {
    text-decoration: none;
  }

  .academy-course__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .academy-catalog__note {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }

  .academy-faq__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .academy-faq__list h3 {
    margin-top: 0;
    font-size: var(--text-xl);
  }

  .academy-faq__list p {
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .academy-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
