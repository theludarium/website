---
// The Guild register: every Expert Game Guide who asked to be listed, by
// certificate number. Employers and friends can check a certificate here, and
// the LinkedIn link from the certificate maker points to each entry.
// To add someone: append { number, name, date, game } to src/data/guild-register.json.
// Kept out of search while the list is empty.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import register from '@/data/guild-register.json';

type Entry = { number: string; name: string; date: string; game?: string };
const entries = ([...register] as Entry[]).sort((a, b) => a.number.localeCompare(b.number));
const dateLabel = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title="The Guild Register: Expert Game Guides"
  description="Every Expert Game Guide certified by The Ludarium Guild of Game Guides, listed by certificate number. Use it to check a certificate."
  noindex={entries.length === 0}
>
  <PageIntro
    eyebrow="The Ludarium Guild of Game Guides"
    title="The Guild register."
    lede="Every person listed here taught a board game to someone new, sent in their capstone, and heard yes to a second game. Use the certificate number to check a certificate."
  />

  <section class="container register">
    {
      entries.length === 0 ? (
        <p class="register__empty">The first Expert Game Guides will be listed here.</p>
      ) : (
        <ol class="register__list">
          {entries.map((e) => (
            <li class="register__card" id={`cert-${e.number}`}>
              <span class="register__number">No. {e.number}</span>
              <strong class="register__name">{e.name}</strong>
              <span class="register__meta">
                Certified {dateLabel(e.date)}
                {e.game && <> &middot; taught {e.game}</>}
              </span>
            </li>
          ))}
        </ol>
      )
    }
    <p class="register__cta">
      Want your name here? <a href="/academy/guild/">Start the free training</a>, then send in <a href="/academy/guild/capstone/">your capstone</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .register {
    max-width: 48rem;
    padding-bottom: var(--space-8);
  }

  .register__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .register__card {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .register__card:target {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 2px var(--color-primary);
  }

  .register__number {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .register__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .register__meta,
  .register__empty {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .register__empty {
    margin: 0 0 var(--space-6);
    padding: var(--space-5);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    text-align: center;
  }
</style>
