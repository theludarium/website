---
// Levi's certificate maker. Open /academy/guild/certificate/?name=Sam%20Rivera&date=November%203,%202026&no=0001
// (or type into the fields), then print to PDF and reply to the student's capstone email.
// Not in search results or the sitemap.
import BaseLayout from '@/layouts/BaseLayout.astro';
import GuildCertificate from '@/components/GuildCertificate.astro';
---

<BaseLayout title="Expert Game Teacher certificate" description="Certificate maker for The Ludarium Guild of Game Teachers. For The Ludarium's own use when a capstone is accepted." noindex>
  <section class="container cert-tool" data-pagefind-ignore>
    <h1>Certificate maker</h1>
    <p>Fill in the student, then Print and choose Save as PDF. Landscape, no headers or footers.</p>
    <div class="cert-tool__fields">
      <label>Name <input data-field="name" /></label>
      <label>Date <input data-field="date" /></label>
      <label>Number <input data-field="number" placeholder="0001" /></label>
      <button class="button" type="button" onclick="window.print()">Print</button>
    </div>
  </section>
  <div class="container cert-page">
    <GuildCertificate />
  </div>
</BaseLayout>

<script>
  const params = new URLSearchParams(location.search);
  const fields: Record<string, string> = { name: params.get('name') ?? '', date: params.get('date') ?? '', number: params.get('no') ?? '' };
  for (const key of Object.keys(fields)) {
    const input = document.querySelector<HTMLInputElement>(`[data-field="${key}"]`);
    const target = document.querySelector<HTMLElement>(`[data-cert-${key}]`);
    if (!input || !target) continue;
    input.value = fields[key];
    const show = () => (target.textContent = input.value || (key === 'name' ? 'Your name here' : ' '));
    show();
    input.addEventListener('input', show);
  }
</script>

<style>
  .cert-tool {
    padding-block: var(--space-6) var(--space-4);
  }

  .cert-tool__fields {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-3);
  }

  .cert-tool label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .cert-tool input {
    padding: 0.5em 0.7em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font: inherit;
  }

  .cert-page {
    max-width: 52rem;
    padding-bottom: var(--space-8);
  }

  @media print {
    @page {
      size: letter landscape;
      margin: 0.4in;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.consent),
    :global(.skip-link),
    .cert-tool {
      display: none !important;
    }

    .cert-page {
      max-width: none;
      padding: 0;
    }

    :global(.cert) {
      box-shadow: none !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }
</style>
