---
// One Guild of Game Teachers lesson. Same reading layout as the Academy's
// Catan lessons: the module badge, the one idea, the lesson, the toolkit box,
// the drill, the self-check, the next-lesson teaser, previous and next links,
// and the program signup. See docs/academy/GUILD.md.
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseForm from '@/components/CourseForm.astro';
import LevelCheck from '@/components/LevelCheck.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import {
  GUILD,
  getGuildLessons,
  guildHasPage,
  guildLessonCode,
  guildLessonMinutes,
  guildLessonSlug,
  guildLessonUrl,
  moduleOf,
  type GuildLesson,
} from '@/lib/guild';
import { guildTool, guildToolUrl } from '@/lib/guild-tools';
import { formatDate } from '@/lib/articles';
import { SITE } from '@/lib/site';
import '@/styles/prose.css';
import '@/styles/reading.css';

export async function getStaticPaths() {
  const all = await getGuildLessons();
  return all.filter(guildHasPage).map((lesson) => ({ params: { lesson: guildLessonSlug(lesson) }, props: { lesson, all } }));
}

interface Props {
  lesson: GuildLesson;
  all: GuildLesson[];
}

const { lesson, all } = Astro.props;
const { title, description, pubDate, updatedDate, draft, module, order, oneIdea, drill, nextTeaser, tool, check, games } = lesson.data;
const { Content, headings } = await render(lesson);

const mod = moduleOf(module);
const code = guildLessonCode(lesson, all);
const index = all.findIndex((l) => l.id === lesson.id);
const prev = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;
const total = all.length;
const minutes = guildLessonMinutes(lesson);
const showToc = headings.filter((h) => h.depth === 2).length >= 3;
const home = '/academy/guild/';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const slug = guildLessonSlug(lesson);
const image = `/og/academy/guild/${slug}.png`;
const toolInfo = tool ? guildTool(tool) : undefined;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: title,
    description,
    url: canonical,
    learningResourceType: 'Lesson',
    educationalLevel: `Module ${module}: ${mod.name}`,
    teaches: oneIdea,
    timeRequired: `PT${minutes}M`,
    position: order,
    inLanguage: 'en-US',
    isAccessibleForFree: true,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    image: new URL(image, Astro.site).href,
    isPartOf: { '@type': 'Course', name: GUILD.title, url: new URL(home, SITE.url).href },
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Academy', item: `${SITE.url}/academy/` },
      { '@type': 'ListItem', position: 2, name: GUILD.title, item: new URL(home, SITE.url).href },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={`${GUILD.title}, lesson ${code}: ${title}`}
  noindex={draft}
  games={games}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="article lesson">
    <header class="container article__header">
      <nav class="article__crumbs" aria-label="Breadcrumb">
        <a href="/academy/">Academy</a>
        <span aria-hidden="true">/</span>
        <a href={home} data-pagefind-meta="category">{GUILD.shortTitle}</a>
      </nav>
      {draft && <p class="article__draft"><span class="draft-badge">Draft</span> Only visible on previews. Set <code>draft: false</code> to publish.</p>}
      <p class="lesson__badge" data-pagefind-ignore>
        <span class="lesson__level">Module {module} &middot; {mod.name}</span>
        <span>Lesson {code}</span>
        <span>{order} of {total}</span>
      </p>
      <h1>{title}</h1>
      <p class="article__lede">{description}</p>
      <p class="article__meta">
        <span>{mod.label}</span>
        <span aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
        <span aria-hidden="true">&middot;</span>
        <time datetime={(updatedDate ?? pubDate).toISOString()}>{updatedDate ? 'Updated ' : ''}{formatDate(updatedDate ?? pubDate)}</time>
      </p>
    </header>

    <div class:list={['container', 'article__layout', { 'has-toc': showToc }]}>
      {
        showToc && (
          <aside class="article__toc" data-pagefind-ignore>
            <TableOfContents headings={headings} title="In this lesson" />
          </aside>
        )
      }
      <div class="article__body">
        <aside class="lesson__idea" aria-label="The one idea">
          <p class="eyebrow">The one idea</p>
          <p class="lesson__idea-text">{oneIdea}</p>
        </aside>

        <div class="prose-article">
          <Content />
        </div>

        <section class="lesson__drill" aria-labelledby="lesson-drill-title">
          <p class="eyebrow">Your drill</p>
          <h2 id="lesson-drill-title">Before the next lesson</h2>
          <p>{drill}</p>
          {
            toolInfo && (
              <div class="lesson__tool" data-pagefind-ignore>
                <p class="lesson__tool-name">
                  <strong>{toolInfo.name}.</strong> {toolInfo.blurb}
                </p>
                {toolInfo.access === 'public' ? (
                  <a class="button button--ghost" href={guildToolUrl(toolInfo.slug)}>
                    Open it
                  </a>
                ) : (
                  <p class="lesson__tool-kit">It comes with the free email course, printable and ready to use. Sign up below and it arrives with lesson one.</p>
                )}
              </div>
            )
          }
        </section>

        <LevelCheck questions={check} lesson={`guild-${slug}`} label="Self-check" />

        {
          next && (
            <section class="lesson__next" aria-labelledby="lesson-next-title" data-pagefind-ignore>
              <p class="eyebrow">Next lesson</p>
              <h2 id="lesson-next-title">{guildHasPage(next) ? <a href={guildLessonUrl(next)}>{next.data.title}</a> : next.data.title}</h2>
              {nextTeaser && <p>{nextTeaser}</p>}
            </section>
          )
        }
        {
          !next && (
            <section class="lesson__next" aria-labelledby="lesson-next-title" data-pagefind-ignore>
              <p class="eyebrow">Your last step</p>
              <h2 id="lesson-next-title">
                <a href="/academy/guild/capstone/">Send in your capstone</a>
              </h2>
              <p>Teach one newcomer, then tell us how it went. If they said yes to another game, you earn the title {GUILD.credential}.</p>
            </section>
          )
        }

        <nav class="lesson__pager" aria-label="Lessons" data-pagefind-ignore>
          {
            prev ? (
              <div class="lesson__pager-item">
                <span class="lesson__pager-label">Previous</span>
                {guildHasPage(prev) ? <a href={guildLessonUrl(prev)}>{prev.data.title}</a> : <span>{prev.data.title}</span>}
              </div>
            ) : (
              <div class="lesson__pager-item">
                <span class="lesson__pager-label">Program</span>
                <a href={home}>All {total} lessons</a>
              </div>
            )
          }
          {
            next ? (
              <div class="lesson__pager-item lesson__pager-item--next">
                <span class="lesson__pager-label">Next</span>
                {guildHasPage(next) ? <a href={guildLessonUrl(next)}>{next.data.title}</a> : <span>{next.data.title}</span>}
              </div>
            ) : (
              <div class="lesson__pager-item lesson__pager-item--next">
                <span class="lesson__pager-label">Program</span>
                <a href={home}>Back to the program</a>
              </div>
            )
          }
        </nav>

        <section class="article__signup lesson__signup" aria-labelledby="lesson-signup-title" data-pagefind-ignore>
          <h2 id="lesson-signup-title">Get every lesson, and the toolkit, by email.</h2>
          <p>{GUILD.promise} Free, one short lesson each weekday, with the printable toolkit.</p>
          <CourseForm course="guild" id="lesson-signup" buttonLabel="Start the training, free" />
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .lesson__badge {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .lesson__badge span {
    padding: 4px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-muted);
  }

  .lesson__badge .lesson__level {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .lesson__idea {
    margin: 0 0 var(--space-7);
    padding: var(--space-5) var(--space-6);
    border-left: 4px solid var(--color-cta);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .lesson__idea .eyebrow {
    margin-bottom: var(--space-2);
  }

  .lesson__idea-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .lesson__drill {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-card);
  }

  .lesson__drill h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .lesson__drill > p:last-of-type {
    margin-bottom: 0;
  }

  .lesson__tool {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-top: var(--space-5);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .lesson__tool p {
    margin: 0;
  }

  .lesson__tool-kit {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .lesson__next {
    margin-top: var(--space-8);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .lesson__next h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .lesson__next p:last-child {
    margin-bottom: 0;
  }

  .lesson__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  .lesson__pager-item {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .lesson__pager-item--next {
    text-align: right;
  }

  .lesson__pager-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .lesson__signup p {
    margin-bottom: var(--space-4);
  }

  @media (max-width: 40rem) {
    .lesson__pager {
      grid-template-columns: 1fr;
    }

    .lesson__pager-item--next {
      text-align: left;
    }
  }
</style>
