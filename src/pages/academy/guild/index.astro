---
// The Ludarium Guild of Game Teachers: the program page. Hero with the signup
// and the certificate (the hero image is proof of what a student earns), three
// objections, the method, the ranks, every lesson grouped by module, the
// toolkit, and the FAQ. Follows the landing page rules in CLAUDE.md above the
// fold. See docs/academy/GUILD.md and src/lib/guild.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseForm from '@/components/CourseForm.astro';
import GuildCertificate from '@/components/GuildCertificate.astro';
import {
  GUILD,
  MODULES,
  PRINCIPLES,
  RANKS,
  getGuildLessons,
  guildHasPage,
  guildLessonCode,
  guildLessonUrl,
} from '@/lib/guild';
import { GUILD_TOOLS, guildToolUrl } from '@/lib/guild-tools';
import { SITE } from '@/lib/site';

const lessons = await getGuildLessons();
const published = lessons.filter((l) => !l.data.draft);
const first = published[0];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const byModule = MODULES.map((m) => ({ ...m, lessons: lessons.filter((l) => l.data.module === m.module) }));
const moves = MODULES.filter((m) => m.module >= 1 && m.module <= 5);

const faq = [
  {
    q: 'Do I need to be good at games to take this?',
    a: 'No. You need to be the person who wants to play more. The training is about the people at the table, not about winning. Strong players often have the most to unlearn.',
  },
  {
    q: 'What does it mean to be certified?',
    a: 'Finish the lessons, teach one person who does not play board games, and send in your capstone: your own scores and the newcomer’s answers. The Ludarium reviews it by hand. If your newcomer said yes to another game, you receive the Expert Game Teacher certificate by email.',
  },
  {
    q: 'How long does it take?',
    a: 'Each lesson is a five to eight minute read with one short drill. By email, one lesson arrives each weekday, so the 35 lessons take about seven weeks. Read ahead on the site anytime. The capstone takes one game night.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes. Every lesson is free to read on this page, and the email course, the printable toolkit and the certificate review are free too. No card, no trial.',
  },
  {
    q: 'Which games does it use?',
    a: 'Games most people can find: Ticket to Ride, Azul, Carcassonne, Codenames, Wingspan, Pandemic and Catan, among others. The method works for any game, and the Teach Library has finished one-page teach sheets for many of them.',
  },
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: GUILD.title,
    description: GUILD.description,
    url: canonical,
    inLanguage: 'en-US',
    isAccessibleForFree: true,
    educationalLevel: 'Beginner',
    numberOfLessons: lessons.length,
    provider: { '@id': `${SITE.url}/#organization` },
    offers: { '@type': 'Offer', category: 'Free', price: 0, priceCurrency: 'USD' },
    educationalCredentialAwarded: GUILD.credential,
    hasCourseInstance: { '@type': 'CourseInstance', courseMode: 'Online', courseWorkload: 'PT5H' },
    syllabusSections: MODULES.map((m) => ({ '@type': 'Syllabus', name: `Module ${m.module}: ${m.name}`, description: m.outcome })),
    hasPart: published.map((lesson) => ({
      '@type': 'LearningResource',
      name: lesson.data.title,
      url: new URL(guildLessonUrl(lesson), SITE.url).href,
      position: lesson.data.order,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Academy', item: `${SITE.url}/academy/` },
      { '@type': 'ListItem', position: 2, name: GUILD.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title="How to Teach a Board Game: Free Training and Certificate"
  description={GUILD.description}
  image="/og/academy/guild.png"
  imageAlt="The Ludarium Guild of Game Teachers: teach any board game in five minutes"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="guild-hero">
    <div class="container guild-hero__grid">
      <div>
        <p class="eyebrow">The Ludarium Academy &middot; {GUILD.title}</p>
        <h1>Teach any board game in five minutes.</h1>
        <p class="guild-hero__sub">
          A free training program for the person who always wants to play more. Learn to pick the right game, teach
          it fast, and run a first game that ends with a yes to the next one. Then teach one newcomer and earn the
          title Expert Game Teacher.
        </p>
        <CourseForm course="guild" id="guild-signup" buttonLabel="Start the training, free" note="35 short lessons by email, plus the printable toolkit. Free. Unsubscribe anytime." />
      </div>
      <GuildCertificate preview />
    </div>
  </section>

  <section class="section guild-objections" aria-labelledby="guild-objections-title">
    <div class="container">
      <h2 id="guild-objections-title" class="visually-hidden">Before you start</h2>
      <ul class="guild-objections__list">
        <li>
          <h3>You do not need to be a rules expert.</h3>
          <p>Great teachers do not know more rules. They know which five things to say first, and which to save for later.</p>
        </li>
        <li>
          <h3>Your people do not have to like games yet.</h3>
          <p>The training is built for newcomers who think board games are not for them. Most of them have just had a bad teach.</p>
        </li>
        <li>
          <h3>A few minutes a lesson.</h3>
          <p>Each lesson is a short read with one drill for your next game night. Read here anytime, or get them by email.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section guild-method" aria-labelledby="guild-method-title">
    <div class="container">
      <div class="section-head">
        <h2 id="guild-method-title">Five moves, one score</h2>
        <p>The only score that counts: did the newcomer say yes to the next game?</p>
      </div>
      <ol class="guild-moves">
        {
          moves.map((m, i) => (
            <li class="guild-move">
              <span class="guild-move__num">{i + 1}</span>
              <h3>{m.name}</h3>
              <p>{m.outcome}</p>
            </li>
          ))
        }
      </ol>
      <div class="guild-principles">
        <p class="eyebrow">Five principles under every lesson</p>
        <ul>
          {
            PRINCIPLES.map((p) => (
              <li>
                <strong>{p.name}.</strong> {p.text}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section guild-ranks" aria-labelledby="guild-ranks-title">
    <div class="container">
      <h2 id="guild-ranks-title">From Apprentice to Expert Game Teacher</h2>
      <ol class="guild-ranks__list">
        {
          RANKS.map((r, i) => (
            <li class:list={['guild-rank', { 'guild-rank--top': i === RANKS.length - 1 }]}>
              <p class="eyebrow">After {r.after}</p>
              <h3>{r.name}</h3>
              <p>{r.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section guild-modules" aria-labelledby="guild-modules-title">
    <div class="container">
      <div class="section-head">
        <h2 id="guild-modules-title">Eight modules, {lessons.length} lessons</h2>
        {first && <a class="text-link" href={guildLessonUrl(first)}>Start with lesson one</a>}
      </div>
      <ol class="guild-modules__list">
        {
          byModule.map((m) => (
            <li class="guild-module" id={`module-${m.module}`}>
              <div class="guild-module__head">
                <p class="eyebrow">
                  Module {m.module} &middot; {m.label}
                </p>
                <h3>{m.name}</h3>
                <p class="guild-module__outcome">
                  <strong>After this module:</strong> {m.outcome}
                </p>
              </div>
              <ol class="guild-module__lessons" data-pagefind-ignore>
                {m.lessons.map((lesson) => (
                  <li>
                    <span class="guild-module__num">{guildLessonCode(lesson, lessons)}</span>
                    {guildHasPage(lesson) ? <a href={guildLessonUrl(lesson)}>{lesson.data.title}</a> : <span>{lesson.data.title}</span>}
                    {lesson.data.draft && guildHasPage(lesson) && <span class="draft-badge">Draft</span>}
                  </li>
                ))}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section guild-toolkit" aria-labelledby="guild-toolkit-title">
    <div class="container">
      <div class="section-head">
        <h2 id="guild-toolkit-title">The toolkit</h2>
        <p>Printables and tools the drills run on. The starred ones come with the email course.</p>
      </div>
      <ul class="guild-toolkit__grid">
        {
          GUILD_TOOLS.map((tool) => (
            <li class="card guild-tool">
              <h3>
                {tool.access === 'public' ? <a href={guildToolUrl(tool.slug)}>{tool.name}</a> : <span>{tool.name}</span>}
                {tool.access === 'kit' && <span class="guild-tool__star" title="Comes with the email course">&#9733;</span>}
              </h3>
              <p>{tool.blurb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section guild-faq" aria-labelledby="guild-faq-title">
    <div class="container">
      <h2 id="guild-faq-title">Common questions</h2>
      <ul class="guild-faq__list">
        {
          faq.map((f) => (
            <li>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </li>
          ))
        }
      </ul>
      <p class="guild-faq__origin">
        The training grew out of our short guide, <a href={GUILD.article.href}>{GUILD.article.title}</a>.
      </p>
    </div>
  </section>

  <section class="section guild-final" aria-labelledby="guild-final-title">
    <div class="container guild-final__inner">
      <h2 id="guild-final-title">Get the next game on the calendar.</h2>
      <p>{GUILD.promise}</p>
      <CourseForm course="guild" id="guild-signup-end" buttonLabel="Start the training, free" />
    </div>
  </section>
</BaseLayout>

<style>
  .guild-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .guild-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: var(--space-7);
  }

  .guild-hero h1 {
    max-width: 16ch;
    font-size: var(--text-4xl);
  }

  .guild-hero__sub {
    max-width: 36rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .guild-objections__list,
  .guild-faq__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guild-objections h3,
  .guild-faq__list h3 {
    margin-top: 0;
    font-size: var(--text-xl);
  }

  .guild-objections p,
  .guild-faq__list p {
    color: var(--color-text-muted);
  }

  .guild-moves {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .guild-move {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .guild-move__num {
    display: inline-grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-weight: 700;
  }

  .guild-move h3 {
    margin: var(--space-3) 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .guild-move p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .guild-principles {
    padding: var(--space-5) var(--space-6);
    border-left: 4px solid var(--color-cta);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .guild-principles ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding-left: 1.2em;
  }

  .guild-ranks__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guild-rank {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }

  .guild-rank h3 {
    margin: var(--space-2) 0;
    font-size: var(--text-2xl);
  }

  .guild-rank p:last-child {
    margin: 0;
    color: var(--color-text-muted);
  }

  .guild-rank--top {
    border: 2px solid var(--color-cta);
    background: var(--color-accent-soft);
  }

  .guild-modules__list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guild-module {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .guild-module h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-2xl);
  }

  .guild-module__outcome {
    margin: 0;
    color: var(--color-text-muted);
  }

  .guild-module__lessons {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guild-module__lessons li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .guild-module__num {
    flex: none;
    min-width: 2.6ch;
    font-variant-numeric: tabular-nums;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .guild-toolkit__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guild-tool h3 {
    margin-top: 0;
    font-size: var(--text-lg);
  }

  .guild-tool p {
    margin-bottom: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .guild-tool__star {
    margin-left: var(--space-2);
    color: var(--color-cta-text, var(--color-primary));
  }

  .guild-faq__origin {
    margin-top: var(--space-6);
    color: var(--color-text-muted);
  }

  .guild-final__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    padding: var(--space-7) var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
    text-align: center;
  }

  .guild-final h2 {
    margin: 0;
  }

  .guild-final p {
    max-width: 36rem;
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }

  @media (max-width: 64rem) {
    .guild-moves {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    }
  }

  @media (max-width: 56rem) {
    .guild-hero__grid,
    .guild-module,
    .guild-ranks__list {
      grid-template-columns: 1fr;
    }
  }
</style>
