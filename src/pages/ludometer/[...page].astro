---
// The Ludometer pages: this week's index (/ludometer/), one game's history
// (/ludometer/game/?id=BGG_ID), and the About page (/ludometer/about/).
// They build only on previews until LUDOMETER.live is true (src/lib/config.ts),
// because the attention layer uses BGG data and needs BGG's commercial license.
// Data comes from the ludometer Worker (workers/ludometer/) in the browser, so
// the Tuesday update needs no site rebuild.
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import PreviewNote from '@/components/PreviewNote.astro';
import { LUDOMETER } from '@/lib/config';
import { IS_PREVIEW } from '@/lib/env';

export function getStaticPaths() {
  if (!LUDOMETER.live && !IS_PREVIEW) return [];
  return [
    { params: { page: undefined }, props: { view: 'week' as const } },
    { params: { page: 'game' }, props: { view: 'game' as const } },
    { params: { page: 'about' }, props: { view: 'about' as const } },
  ];
}

interface Props {
  view: 'week' | 'game' | 'about';
}

const { view } = Astro.props;
const titles = {
  week: 'The Ludometer: What Players Are Learning and Playing',
  game: 'The Ludometer: Game History',
  about: 'About the Ludometer',
};
const descriptions = {
  week: 'The Ludometer is The Ludarium’s weekly index of the games people are learning and playing, with BoardGameGeek’s Hotness rank shown beside it.',
  game: 'One game’s week-by-week history on the Ludometer, The Ludarium’s weekly index of what tabletop players are learning and playing.',
  about: 'How the Ludometer works: three families of signals, a weekly update every Tuesday, and BoardGameGeek’s Hotness credited as a source beside our own data.',
};
---

<BaseLayout title={titles[view]} description={descriptions[view]} noindex={!LUDOMETER.live}>
  <section class="ludo-hero">
    <div class="container">
      <p class="eyebrow"><a href="/ludometer/">The Ludometer</a>{view === 'about' ? ' · About' : view === 'game' ? ' · Game' : ' · Updated every Tuesday'}</p>
      {
        view === 'week' && (
          <>
            <h1>What tabletop players are learning and playing.</h1>
            <p class="lede">
              The Ludometer ranks games by what people do, not only what they click: courses started, teach sheets
              printed, games logged at the table. BoardGameGeek’s Hotness rank sits beside it, credited, so you can see
              hot against played.
            </p>
          </>
        )
      }
      {view === 'game' && <h1 data-ludo-game-title>Game history</h1>}
      {
        view === 'about' && (
          <>
            <h1>How the Ludometer works.</h1>
            <p class="lede">A weekly index of the games people are learning and playing, built from our own data.</p>
          </>
        )
      }
      {
        !LUDOMETER.live && (
          <PreviewNote>
            The Ludometer is not public yet. These pages build only on previews until LUDOMETER.live is true in
            src/lib/config.ts, which waits on BGG’s written approval of the commercial license.
            {!LUDOMETER.api && ' The Worker address (LUDOMETER.api) is not set yet, so the table below stays empty.'}
          </PreviewNote>
        )
      }
    </div>
  </section>

  {
    view === 'week' && (
      <section class="container ludo-body">
        <div class="ludo-table-wrap" data-ludo-week data-api={LUDOMETER.api}>
          <p class="ludo-status" data-ludo-status aria-live="polite">Loading this week’s Ludometer…</p>
          <table class="ludo-table" hidden>
            <caption class="visually-hidden">This week’s Ludometer</caption>
            <thead>
              <tr>
                <th scope="col">Rank</th>
                <th scope="col">Move</th>
                <th scope="col">Game</th>
                <th scope="col">Weeks on list</th>
                <th scope="col" class="ludo-bgg">BGG Hotness</th>
              </tr>
            </thead>
            <tbody data-ludo-rows />
          </table>
          <p class="ludo-credit">
            BGG Hotness rank from <a href="https://boardgamegeek.com" rel="noopener">BoardGameGeek</a>. Powered by BGG.
            The Ludometer rank is The Ludarium’s own. <a href="/ludometer/about/">How it works</a>.
          </p>
        </div>
        <aside class="ludo-signup">
          <h2>Get the Ludometer every Tuesday.</h2>
          <p>The week’s movers, what is hot against what is played, and next week’s triggers, in Ludarium Letters.</p>
          <NewsletterForm id="ludo-weekly" formAction={LUDOMETER.weeklyForm} buttonLabel="Send me the Ludometer" />
        </aside>
      </section>
    )
  }

  {
    view === 'game' && (
      <section class="container ludo-body" data-ludo-game data-api={LUDOMETER.api}>
        <p class="ludo-status" data-ludo-status aria-live="polite">Loading…</p>
        <div class="ludo-game" hidden>
          <svg class="ludo-spark" viewBox="0 0 320 80" role="img" aria-label="Weekly rank over time" data-ludo-spark />
          <dl class="ludo-facts" data-ludo-facts />
          <p class="ludo-credit">
            BGG figures from <a href="https://boardgamegeek.com" rel="noopener">BoardGameGeek</a>. Powered by BGG.
          </p>
        </div>
        <aside class="ludo-signup">
          <h2>Watch this game.</h2>
          <p>One email when it graduates, gets a printable teach sheet, or gets an Academy course.</p>
          <NewsletterForm id="ludo-watch" formAction={LUDOMETER.watchForm} buttonLabel="Watch this game" />
        </aside>
      </section>
    )
  }

  {
    view === 'about' && (
      <section class="container ludo-body prose">
        <h2>Three kinds of signal</h2>
        <ul>
          <li>
            <strong>Attention.</strong> BoardGameGeek’s Hotness list, which we record every day, and how fast each game’s
            rating count is growing. We show BGG’s rank as it comes, credited, in its own column.
          </li>
          <li>
            <strong>Interest.</strong> What happens on theludarium.com: visits to a game’s pages, teach sheets printed,
            Academy courses started, and Watch this game signups.
          </li>
          <li>
            <strong>Play.</strong> Games logged at the table by readers who track their plays with us, games added to
            shelves, and tables seated at Ludarium game nights once they begin.
          </li>
        </ul>
        <h2>When it updates</h2>
        <p>
          Every Tuesday morning. Snapshots run daily; the week is scored on Monday. The weekly newsletter section,
          Ludometer Reading, goes out the same Tuesday.
        </p>
        <h2>What we do not publish</h2>
        <p>
          The weights. Like BGG with its own list, we keep the formula private, because a published formula invites
          people to game it. While play data is thin, attention and interest carry most of the weight; play counts for
          more as more games are logged.
        </p>
        <h2>Credit</h2>
        <p>
          BGG Hotness ranks and game statistics come from <a href="https://boardgamegeek.com" rel="noopener">BoardGameGeek</a>{' '}
          through its XML API, shown unmodified and credited. Powered by BGG. The Ludometer rank is The Ludarium’s own and is
          not endorsed by BoardGameGeek.
        </p>
      </section>
    )
  }
</BaseLayout>

<script>
  type Row = { rank: number; prev_rank: number | null; name: string; game_id: number; days_on_list: number; bgg_hot_rank: number | null };

  const text = (tag: string, value: string, className?: string) => {
    const node = document.createElement(tag);
    node.textContent = value;
    if (className) node.className = className;
    return node;
  };

  const move = (r: Row) => {
    if (r.prev_rank == null) return { label: 'New', cls: 'ludo-move--new' };
    const d = r.prev_rank - r.rank;
    if (d > 0) return { label: `Up ${d}`, cls: 'ludo-move--up' };
    if (d < 0) return { label: `Down ${-d}`, cls: 'ludo-move--down' };
    return { label: 'Same', cls: '' };
  };

  async function load(api: string, path: string) {
    const res = await fetch(`${api}${path}`, { headers: { Accept: 'application/json' } });
    if (!res.ok) throw new Error(String(res.status));
    return res.json();
  }

  const week = document.querySelector<HTMLElement>('[data-ludo-week]');
  if (week) {
    const status = week.querySelector<HTMLElement>('[data-ludo-status]')!;
    const table = week.querySelector<HTMLTableElement>('table')!;
    const rows = week.querySelector<HTMLElement>('[data-ludo-rows]')!;
    const api = week.dataset.api ?? '';
    if (!api) status.textContent = 'The Ludometer’s data source is not connected yet.';
    else
      load(api, '/api/ludometer/week')
        .then((data: { week: string; games: Row[] }) => {
          for (const r of data.games) {
            const tr = document.createElement('tr');
            tr.append(text('td', String(r.rank), 'ludo-rank'));
            const m = move(r);
            tr.append(text('td', m.label, `ludo-move ${m.cls}`));
            const name = document.createElement('td');
            const a = document.createElement('a');
            a.href = `/ludometer/game/?id=${r.game_id}`;
            a.textContent = r.name;
            name.append(a);
            tr.append(name);
            tr.append(text('td', String(Math.max(1, Math.round(r.days_on_list / 7)))));
            tr.append(text('td', r.bgg_hot_rank ? `#${r.bgg_hot_rank}` : '·', 'ludo-bgg'));
            rows.append(tr);
          }
          status.textContent = `Week of ${data.week}`;
          table.hidden = false;
        })
        .catch(() => (status.textContent = 'This week’s Ludometer could not be loaded. Try again in a minute.'));
  }

  const game = document.querySelector<HTMLElement>('[data-ludo-game]');
  if (game) {
    const status = game.querySelector<HTMLElement>('[data-ludo-status]')!;
    const id = new URLSearchParams(location.search).get('id');
    const api = game.dataset.api ?? '';
    if (!api || !id) status.textContent = !api ? 'The Ludometer’s data source is not connected yet.' : 'No game chosen.';
    else
      load(api, `/api/ludometer/game/${encodeURIComponent(id)}`)
        .then((data: { name: string; history: { week: string; rank: number }[]; plays: number; days_on_list: number }) => {
          document.title = `${data.name}: The Ludometer | The Ludarium`;
          const h1 = document.querySelector('[data-ludo-game-title]');
          if (h1) h1.textContent = data.name;
          const facts = game.querySelector<HTMLElement>('[data-ludo-facts]')!;
          for (const [k, v] of [
            ['Weeks on the Ludometer', String(data.history.length)],
            ['Days on BGG’s Hotness', String(data.days_on_list)],
            ['Plays logged with The Ludarium', String(data.plays)],
          ]) {
            const div = document.createElement('div');
            div.append(text('dt', k), text('dd', v));
            facts.append(div);
          }
          const svg = game.querySelector<SVGSVGElement>('[data-ludo-spark]')!;
          const h = data.history;
          if (h.length > 1) {
            const max = Math.max(...h.map((p) => p.rank));
            const pts = h.map((p, i) => `${(i / (h.length - 1)) * 316 + 2},${((p.rank - 1) / Math.max(1, max - 1)) * 70 + 5}`).join(' ');
            svg.innerHTML = `<polyline points="${pts}" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />`;
          }
          status.textContent = '';
          game.querySelector<HTMLElement>('.ludo-game')!.hidden = false;
        })
        .catch(() => (status.textContent = 'This game’s history could not be loaded.'));
  }
</script>

<style>
  .ludo-hero {
    padding-block: var(--space-8) var(--space-5);
  }

  .ludo-hero h1 {
    max-width: 20ch;
    font-size: var(--text-4xl);
  }

  .ludo-body {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: start;
    padding-bottom: var(--space-8);
  }

  .ludo-body.prose {
    display: block;
  }

  .ludo-table {
    width: 100%;
    border-collapse: collapse;
  }

  .ludo-table th,
  .ludo-table :global(td) {
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  .ludo-table th {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .ludo-table :global(.ludo-rank) {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .ludo-table :global(.ludo-move--up) {
    color: var(--color-primary);
    font-weight: 600;
  }

  .ludo-table :global(.ludo-move--down) {
    color: var(--color-text-muted);
  }

  .ludo-table :global(.ludo-move--new) {
    color: var(--color-accent);
    font-weight: 700;
  }

  .ludo-table .ludo-bgg,
  .ludo-table :global(td.ludo-bgg) {
    color: var(--color-text-muted);
  }

  .ludo-status,
  .ludo-credit {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .ludo-signup {
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
  }

  .ludo-signup h2 {
    margin-top: 0;
    font-size: var(--text-2xl);
  }

  .ludo-spark {
    width: 100%;
    max-width: 32rem;
    height: auto;
    color: var(--color-primary);
  }

  .ludo-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: var(--space-4);
  }

  .ludo-facts :global(dt) {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ludo-facts :global(dd) {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
  }

  @media (max-width: 56rem) {
    .ludo-body {
      grid-template-columns: 1fr;
    }
  }
</style>
