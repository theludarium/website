---
// Press kit: what The Ludarium is, quick facts, a boilerplate paragraph,
// the founder's bio, logos and photos to download, and a contact. Journalists,
// podcast hosts, and bloggers link to the page they used, so this page is also
// a quiet link magnet. Counts update with each build.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import LinkSnippet from '@/components/LinkSnippet.astro';
import { FOUNDER, SITE } from '@/lib/site';
import { getArticles } from '@/lib/articles';
import { getGameCourses } from '@/lib/courses';

const articleCount = (await getArticles()).filter((a) => !a.data.draft).length;
const courseCount = (await getGameCourses()).filter((c) => !c.data.draft).length;
const roundDown = (n: number, step: number) => (n >= step ? `${Math.floor(n / step) * step}+` : String(n));

const boilerplate = `The Ludarium is a tabletop gaming brand from Indianapolis, built on one idea: the game is the reason, the people are the point. It publishes free guides to board games, card games, and role-playing games, free Academy courses that teach specific games, and free tools for game night. Its next step is The Ludarium Game Lounge, a membership space in Indianapolis where every kind of tabletop group can meet and play.`;

const facts = [
  { label: 'Based in', value: FOUNDER.city },
  { label: 'Founder', value: FOUNDER.name },
  { label: 'Articles', value: `${roundDown(articleCount, 50)} free guides and essays` },
  { label: 'Academy', value: `${courseCount} free game courses, each with a printable teach sheet` },
  { label: 'Tools', value: 'The Card Catalogue, the RPG Demo Library, and Game Night Madness' },
  { label: 'Coming next', value: 'The Ludarium Game Lounge, Indianapolis (waitlist open)' },
];

const topics = [
  'Togethering: why adults need a regular table and how games make friendship easier',
  'How to teach a board game to someone new',
  'Hosting a game night people come back to',
  'Leadership and team training through tabletop games',
  'Board game gift ideas for every kind of player',
  'Magic: The Gathering, cube drafting, and trading card games',
  'Game lounges and third places: where communities meet to play',
];

const logos = [
  { file: 'ludarium-mark-felt-green.svg', name: 'Felt Green', note: 'for light backgrounds' },
  { file: 'ludarium-mark-walnut.svg', name: 'Walnut', note: 'for light backgrounds' },
  { file: 'ludarium-mark-parchment.svg', name: 'Parchment', note: 'for dark backgrounds' },
  { file: 'ludarium-mark-lamplight.svg', name: 'Lamplight', note: 'for dark backgrounds' },
];

const photos = [
  { src: FOUNDER.photo, alt: `${FOUNDER.name}, founder of The Ludarium, in a blue suit with his arms crossed, smiling`, name: 'Portrait' },
  { src: '/images/about/levi-at-magicfest.webp', alt: `${FOUNDER.name} grinning at a crowded MagicFest table next to a sleeved deck`, name: 'At the table' },
];
---

<BaseLayout
  title="Press Kit"
  description="The Ludarium press kit: quick facts, a ready-to-use description, the founder's bio, logos and photos to download, interview topics, and how to reach us."
>
  <PageIntro
    eyebrow="Press and media"
    title="Writing about The Ludarium?"
    lede="Everything you need in one place: the facts, a paragraph you can use as is, logos, photos, and a direct line to the founder."
  >
    <a class="button press__cta" href={`mailto:${FOUNDER.email}?subject=Press%20inquiry`}>Email {FOUNDER.name.split(' ')[0]}</a>
  </PageIntro>

  <section class="container press" aria-labelledby="press-facts">
    <h2 id="press-facts">Quick facts</h2>
    <dl class="press__facts">
      {
        facts.map((f) => (
          <div class="card press__fact">
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container press" aria-labelledby="press-about">
    <h2 id="press-about">About The Ludarium</h2>
    <p class="press__boilerplate">{boilerplate}</p>
    <p class="press__note">Free to use as written. Please link to <a href={SITE.url}>theludarium.com</a> when you do.</p>
  </section>

  <section class="container press press__founder" aria-labelledby="press-founder">
    <div>
      <h2 id="press-founder">The founder</h2>
      <p>
        {FOUNDER.name} founded The Ludarium in {FOUNDER.city}, to build a place where tabletop games are about
        playing them, not owning them. He built the site's first tools himself, created the Guild of Game Guides
        to train people to teach games to new players, and brings The Ludarium's team training to workplaces.
        He is also the author of <a href="/books/well-burn-that-bridge/"><em>We'll Burn That Bridge When We Get to It</em></a>,
        a field guide to mixed-up sayings.
      </p>
      <p><a class="text-link" href="/about/#founder">Longer bio</a> &middot; <a class="text-link" href={FOUNDER.linkedin} rel="noopener" target="_blank">LinkedIn</a></p>
    </div>
  </section>

  <section class="container press" aria-labelledby="press-topics">
    <h2 id="press-topics">Topics Levi can speak to</h2>
    <ul class="press__topics">
      {topics.map((t) => <li>{t}</li>)}
    </ul>
    <p class="press__note">Available for interviews, podcasts, expert quotes, and panels.</p>
  </section>

  <section class="container press" aria-labelledby="press-assets">
    <h2 id="press-assets">Logos and photos</h2>
    <p class="press__note">
      The mark is a game tile with a round table and six chairs cut into it. Use it as supplied: no recoloring,
      stretching, or effects.
    </p>
    <ul class="press__logos">
      {
        logos.map((l) => (
          <li class={`card press__logo${l.note.includes('dark') ? ' press__logo--dark' : ''}`}>
            <img src={`/brand/${l.file}`} alt={`The Ludarium mark in ${l.name}`} width="96" height="96" loading="lazy" />
            <span>
              <strong>{l.name}</strong> <small>{l.note}</small>
            </span>
            <a class="text-link" href={`/brand/${l.file}`} download>Download SVG</a>
          </li>
        ))
      }
    </ul>
    <ul class="press__photos">
      {
        photos.map((p) => (
          <li class="card press__photo">
            <img src={p.src} alt={p.alt} width="400" height="480" loading="lazy" decoding="async" />
            <span>{p.name}</span>
            <a class="text-link" href={p.src} download>Download</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container press press--last">
    <LinkSnippet path="/" label="The Ludarium" title="Linking to us">
      <p>The easiest way to credit The Ludarium. Copy this link into your article, show notes, or newsletter.</p>
    </LinkSnippet>
  </section>
</BaseLayout>

<style>
  .press {
    max-width: calc(var(--width-content) + 2 * var(--gutter));
    padding-bottom: var(--space-7);
  }

  .press h2 {
    margin: 0 0 var(--space-4);
    font-size: var(--text-2xl);
  }

  .press__cta {
    margin-top: var(--space-5);
  }

  .press__facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .press__fact dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .press__fact dd {
    margin: var(--space-1) 0 0;
  }

  .press__boilerplate {
    margin: 0;
    padding: var(--space-5);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .press__note {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .press__topics {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.2em;
  }

  .press__logos,
  .press__photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .press__logo,
  .press__photo {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .press__logo img {
    width: 4rem;
    height: 4rem;
  }

  .press__logo--dark img {
    padding: var(--space-2);
    border-radius: var(--radius-md);
    background: var(--brand-walnut);
    box-sizing: content-box;
  }

  .press__logo small {
    display: block;
    color: var(--color-text-muted);
  }

  .press__photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 6;
    object-fit: cover;
    border-radius: var(--radius-md);
  }

  .press--last {
    padding-bottom: var(--space-8);
  }
</style>
