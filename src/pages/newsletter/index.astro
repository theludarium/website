---
// Landing page: follows the landing page rules in CLAUDE.md.
// One outcome, one action, three objections, legal links. Nothing else.
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import PreviewNote from '@/components/PreviewNote.astro';
import { KIT_NEWSLETTER_FORM } from '@/lib/config';
import { MARK_PATH, MARK_VIEWBOX } from '@/lib/brand';
---

<BaseLayout
  title="The Newsletter"
  description="Join The Ludarium newsletter for tabletop game picks, game night hosting ideas, new guides, and first word on our Indianapolis game lounge. Free."
>
  <section class="nl-hero">
    <div class="container nl-hero__grid">
      <div class="nl-hero__copy">
        <p class="eyebrow">The Ludarium newsletter</p>
        <h1>Never wonder what to play again.</h1>
        <p class="nl-hero__sub">
          Game picks, game night ideas, and quick guides, sent to your inbox. Free, with first word on
          our game lounge coming to Indianapolis.
        </p>
        <NewsletterForm id="newsletter-page" />
        <p class="nl-hero__why">
          Every issue: one game worth trying, one idea for your next night, and the newest guides.
        </p>
        {
          !KIT_NEWSLETTER_FORM.action && (
            <PreviewNote>
              The Kit form is not connected yet, so signups go nowhere. Paste Kit's HTML embed code to
              Claude to finish it. Do not merge to main until this note is gone.
            </PreviewNote>
          )
        }
      </div>

      <div class="nl-issue" aria-label="Example of what an issue looks like">
        <div class="nl-issue__bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="nl-issue__head">
          <svg viewBox={MARK_VIEWBOX} width="28" height="28" aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d={MARK_PATH} />
          </svg>
          <div>
            <p class="nl-issue__from">The Ludarium</p>
            <p class="nl-issue__subject">Three games for four players, under an hour</p>
          </div>
        </div>
        <div class="nl-issue__body">
          <p class="nl-issue__label">Game to try</p>
          <p class="nl-issue__line nl-issue__line--wide"></p>
          <p class="nl-issue__line"></p>
          <p class="nl-issue__label">For your next game night</p>
          <p class="nl-issue__line nl-issue__line--wide"></p>
          <p class="nl-issue__line nl-issue__line--short"></p>
          <p class="nl-issue__label">New on the site</p>
          <div class="nl-issue__cards" aria-hidden="true"><span></span><span></span></div>
        </div>
        <p class="nl-issue__caption">What an issue looks like</p>
      </div>
    </div>
  </section>

  <section class="section nl-faq" aria-labelledby="nl-faq-title">
    <div class="container">
      <h2 id="nl-faq-title" class="visually-hidden">Common questions</h2>
      <ul class="nl-faq__list">
        <li>
          <h3>Will you fill my inbox?</h3>
          <p>No. Short issues, only when we have something worth your time. Unsubscribe in one click, anytime.</p>
        </li>
        <li>
          <h3>I am new to board games. Is this for me?</h3>
          <p>Yes. We write for first-timers and longtime players alike, and we never assume you know the jargon.</p>
        </li>
        <li>
          <h3>What do you do with my email?</h3>
          <p>Send you the newsletter. We never sell or share it. Read the <a href="/privacy/">privacy policy</a>.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nl-hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .nl-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: var(--space-8);
  }

  .nl-hero h1 {
    max-width: 14ch;
    font-size: var(--text-4xl);
  }

  .nl-hero__sub {
    max-width: 34rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .nl-hero__why {
    max-width: 34rem;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The proof: a sketch of an issue */
  .nl-issue {
    position: relative;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    transform: rotate(1.5deg);
  }

  .nl-issue__bar {
    display: flex;
    gap: 6px;
    margin-bottom: var(--space-4);
  }

  .nl-issue__bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .nl-issue__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .nl-issue__from {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
  }

  .nl-issue__subject {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  .nl-issue__body {
    padding-top: var(--space-4);
  }

  .nl-issue__label {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .nl-issue__label:first-child {
    margin-top: 0;
  }

  .nl-issue__line {
    height: 10px;
    width: 70%;
    margin: 0 0 8px;
    border-radius: 5px;
    background: var(--color-surface-alt);
  }

  .nl-issue__line--wide {
    width: 92%;
  }

  .nl-issue__line--short {
    width: 45%;
  }

  .nl-issue__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .nl-issue__cards span {
    height: 64px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--brand-felt) 18%, var(--color-surface-alt));
  }

  .nl-issue__cards span + span {
    background: color-mix(in srgb, var(--brand-lamplight) 28%, var(--color-surface-alt));
  }

  .nl-issue__caption {
    margin: var(--space-4) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  .nl-faq {
    padding-top: var(--space-6);
  }

  .nl-faq__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nl-faq__list li {
    padding: var(--space-5);
    border-top: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
  }

  .nl-faq__list h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .nl-faq__list p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .nl-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .nl-issue {
      transform: none;
    }
  }
</style>
