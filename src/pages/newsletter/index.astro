---
// Landing page: follows the landing page rules in CLAUDE.md.
// One outcome and one action above the fold (the General letter), then the
// four letters with a form each (the welcome emails link to #cube and friends),
// three objections, legal links. Nothing else.
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import PreviewNote from '@/components/PreviewNote.astro';
import { KIT_NEWSLETTER_FORM, type LettersKey } from '@/lib/config';
import { MARK_PATH, MARK_VIEWBOX } from '@/lib/brand';

// The four Ludarium Letters. Send days are also named in the welcome emails
// (docs/newsletter/letters-welcome-emails.md); change both together.
const LETTERS: { key: LettersKey; title: string; day: string; blurb: string }[] = [
  {
    key: 'general',
    title: 'The General letter',
    day: 'Friday',
    blurb:
      'The big picture. One idea about playing together, one game and who it is for, the best of what we published, and the week\'s highlights from the other three letters.',
  },
  {
    key: 'tabletop',
    title: 'The Tabletop letter',
    day: 'Tuesday',
    blurb:
      'The games themselves. One game worth trying and who it is for, one hosting or teaching idea, the newest guides, and new free Academy lessons.',
  },
  {
    key: 'cube',
    title: 'The Cube letter',
    day: 'Wednesday',
    blurb:
      'Magic Cube, every week. What\'s new from us, one Cube or creator worth your attention, what moved in the Cube world, and Cube Commonwealth news.',
  },
  {
    key: 'industry',
    title: 'The Industry letter',
    day: 'Thursday',
    blurb:
      'The business of tabletop. The week\'s news and what it means, one number worth knowing, one company or creator doing something smart, and open jobs when we find them.',
  },
];
---

<BaseLayout
  title="Ludarium Letters"
  description="Ludarium Letters: four weekly emails on tabletop games, Magic Cube, and the tabletop industry, plus the big-picture General letter. Pick what you want. Free."
>
  <section class="nl-hero">
    <div class="container nl-hero__grid">
      <div class="nl-hero__copy">
        <p class="eyebrow">Ludarium Letters</p>
        <h1>Never wonder what to play again.</h1>
        <p class="nl-hero__sub">
          Game picks, game night ideas, and quick guides, sent to your inbox. Free, with first word on
          our game lounge coming to Indianapolis.
        </p>
        <NewsletterForm id="newsletter-page" />
        <p class="nl-hero__why">
          Every issue: one game worth trying, one idea for your next night, and the newest guides.
        </p>
        <p class="nl-hero__why">
          This is the General letter, every Friday. Want just Cube, tabletop games, or the industry?{' '}
          <a href="#letters">Pick your letters below.</a>
        </p>
        {
          !KIT_NEWSLETTER_FORM.action && (
            <PreviewNote>
              The Kit form is not connected yet, so signups go nowhere. Paste Kit's HTML embed code to
              Claude to finish it. Do not merge to main until this note is gone.
            </PreviewNote>
          )
        }
      </div>

      <div class="nl-issue" aria-label="Example of what an issue looks like">
        <div class="nl-issue__bar" aria-hidden="true"><span></span><span></span><span></span></div>
        <div class="nl-issue__head">
          <svg viewBox={MARK_VIEWBOX} width="28" height="28" aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d={MARK_PATH} />
          </svg>
          <div>
            <p class="nl-issue__from">The Ludarium</p>
            <p class="nl-issue__subject">Three games for four players, under an hour</p>
          </div>
        </div>
        <div class="nl-issue__body">
          <p class="nl-issue__label">Game to try</p>
          <p class="nl-issue__line nl-issue__line--wide"></p>
          <p class="nl-issue__line"></p>
          <p class="nl-issue__label">For your next game night</p>
          <p class="nl-issue__line nl-issue__line--wide"></p>
          <p class="nl-issue__line nl-issue__line--short"></p>
          <p class="nl-issue__label">New on the site</p>
          <div class="nl-issue__cards" aria-hidden="true"><span></span><span></span></div>
        </div>
        <p class="nl-issue__caption">What an issue looks like</p>
      </div>
    </div>
  </section>

  <section class="section nl-letters" id="letters" aria-labelledby="nl-letters-title">
    <div class="container">
      <div class="section-head">
        <h2 id="nl-letters-title">Four letters. Pick yours.</h2>
        <p>Each one is its own weekly email. Sign up for one or all four, and you only get what you pick.</p>
      </div>
      <ul class="nl-letters__list">
        {
          LETTERS.map((letter) => (
            <li class="nl-letter" id={letter.key}>
              <p class="eyebrow">Every {letter.day}</p>
              <h3>{letter.title}</h3>
              <p>{letter.blurb}</p>
              <NewsletterForm id={`letter-${letter.key}`} letters={letter.key} note="Free. Unsubscribe anytime." />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section nl-faq" aria-labelledby="nl-faq-title">
    <div class="container">
      <h2 id="nl-faq-title" class="visually-hidden">Common questions</h2>
      <ul class="nl-faq__list">
        <li>
          <h3>Will you fill my inbox?</h3>
          <p>No. Each letter is one short email a week, and you only get the letters you picked. Unsubscribe in one click, anytime.</p>
        </li>
        <li>
          <h3>I am new to board games. Is this for me?</h3>
          <p>Yes. We write for first-timers and longtime players alike, and we never assume you know the jargon.</p>
        </li>
        <li>
          <h3>What do you do with my email?</h3>
          <p>Send you the newsletter. We never sell or share it. Read the <a href="/privacy/">privacy policy</a>.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nl-hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .nl-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: var(--space-8);
  }

  .nl-hero h1 {
    max-width: 14ch;
    font-size: var(--text-4xl);
  }

  .nl-hero__sub {
    max-width: 34rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .nl-hero__why {
    max-width: 34rem;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The proof: a sketch of an issue */
  .nl-issue {
    position: relative;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    transform: rotate(1.5deg);
  }

  .nl-issue__bar {
    display: flex;
    gap: 6px;
    margin-bottom: var(--space-4);
  }

  .nl-issue__bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .nl-issue__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
  }

  .nl-issue__from {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
  }

  .nl-issue__subject {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text);
  }

  .nl-issue__body {
    padding-top: var(--space-4);
  }

  .nl-issue__label {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .nl-issue__label:first-child {
    margin-top: 0;
  }

  .nl-issue__line {
    height: 10px;
    width: 70%;
    margin: 0 0 8px;
    border-radius: 5px;
    background: var(--color-surface-alt);
  }

  .nl-issue__line--wide {
    width: 92%;
  }

  .nl-issue__line--short {
    width: 45%;
  }

  .nl-issue__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .nl-issue__cards span {
    height: 64px;
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--brand-felt) 18%, var(--color-surface-alt));
  }

  .nl-issue__cards span + span {
    background: color-mix(in srgb, var(--brand-lamplight) 28%, var(--color-surface-alt));
  }

  .nl-issue__caption {
    margin: var(--space-4) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  .nl-letters {
    padding-top: var(--space-6);
  }

  .nl-letters__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nl-letter {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    /* Room for the sticky header when a welcome email links to #cube and friends. */
    scroll-margin-top: 6rem;
  }

  .nl-letter .eyebrow {
    margin: 0;
  }

  .nl-letter h3 {
    margin: var(--space-2) 0;
    font-size: var(--text-lg);
  }

  .nl-letter p:not(.eyebrow) {
    margin: 0 0 var(--space-4);
    color: var(--color-text-muted);
  }

  .nl-faq {
    padding-top: var(--space-6);
  }

  .nl-faq__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nl-faq__list li {
    padding: var(--space-5);
    border-top: 3px solid var(--color-primary);
    background: var(--color-surface);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
  }

  .nl-faq__list h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .nl-faq__list p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .nl-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .nl-issue {
      transform: none;
    }
  }
</style>
