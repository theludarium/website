---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
---

<BaseLayout
  title="Check your inbox"
  description="One more step: open the email from The Ludarium and click the button to confirm your subscription to the newsletter."
  noindex
>
  <PageIntro
    eyebrow="Almost there"
    title="Check your inbox."
    lede="We just sent you an email. Click the button inside to confirm, and you are in."
  >
    <ul class="thanks-tips">
      <li>Do not see it? Check your spam or promotions folder.</li>
      <li>It comes from hello@theludarium.com. Add that address to your contacts so game night ideas never land in spam.</li>
    </ul>
    <div class="thanks-actions">
      <a class="button" href="/articles/">Read while you wait</a>
      <a class="button button--ghost" href="/play/">Try the free tools</a>
    </div>
  </PageIntro>
</BaseLayout>

<style>
  .thanks-tips {
    max-width: var(--width-content);
    padding-left: 1.2em;
    color: var(--color-text-muted);
  }

  .thanks-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
