---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import ArticleList from '@/components/ArticleList.astro';
import { getArticles } from '@/lib/articles';
import { CATEGORIES } from '@/lib/site';

export async function getStaticPaths() {
  const articles = await getArticles();
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category, articles: articles.filter((a) => a.data.category === category.name) },
  }));
}

const { category, articles } = Astro.props;
---

<BaseLayout
  title={`${category.name} articles`}
  description={`${category.name} articles from The Ludarium. ${category.description}`}
>
  <PageIntro eyebrow="Articles" title={category.name} lede={category.description} />
  {
    category.course && (
      <section class="container">
        <aside class="course-band">
          <p>
            <strong>Reading in order?</strong> {category.course.title} is a free Academy course that puts every series
            in sequence, with the articles numbered and summarized, and sends them two a week by email.
          </p>
          <a class="button button--ghost" href={category.course.href}>
            Open the course
          </a>
        </aside>
      </section>
    )
  }
  <section class="container list-section">
    <ArticleList articles={articles} current={category.slug} />
  </section>
</BaseLayout>

<style>
  .course-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
    padding: var(--space-5) var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
  }

  .course-band p {
    flex: 1 1 24rem;
    margin: 0;
  }

  .course-band .button {
    flex: none;
  }

  .list-section {
    padding-bottom: var(--space-8);
  }
</style>
