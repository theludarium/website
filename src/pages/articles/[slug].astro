---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import {
  categoryUrl,
  formatDate,
  getArticles,
  readingMinutes,
  relatedArticles,
  wordCount,
  type Article,
} from '@/lib/articles';
import { SITE } from '@/lib/site';
import '@/styles/prose.css';
import '@/styles/reading.css';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article, all: articles },
  }));
}

interface Props {
  article: Article;
  all: Article[];
}

const { article, all } = Astro.props;
const { title, description, pubDate, updatedDate, category, tags, heroImage, heroAlt, draft } = article.data;
const { Content, headings } = await render(article);

const minutes = readingMinutes(article);
const showToc = headings.filter((h) => h.depth === 2).length >= 3;
const related = relatedArticles(article, all);
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    mainEntityOfPage: canonical,
    articleSection: category,
    keywords: tags.join(', '),
    wordCount: wordCount(article),
    image: new URL(heroImage?.src ?? `/og/articles/${article.id}.png`, Astro.site).href,
    author: { '@id': `${SITE.url}/#organization` },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Articles', item: `${SITE.url}/articles/` },
      { '@type': 'ListItem', position: 2, name: category, item: new URL(categoryUrl(category), SITE.url).href },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage?.src ?? `/og/articles/${article.id}.png`}
  imageAlt={heroImage ? heroAlt : `${category}: ${title}`}
  noindex={draft}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, section: category, tags }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <article class="article">
    <header class="container article__header">
      <nav class="article__crumbs" aria-label="Breadcrumb">
        <a href="/articles/">Articles</a>
        <span aria-hidden="true">/</span>
        <a href={categoryUrl(category)}>{category}</a>
      </nav>
      {draft && <p class="article__draft"><span class="draft-badge">Draft</span> Only visible on previews. Set <code>draft: false</code> to publish.</p>}
      <h1>{title}</h1>
      <p class="article__lede">{description}</p>
      <p class="article__meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>
                Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
        <span aria-hidden="true">&middot;</span>
        <span>{minutes} min read</span>
      </p>
    </header>

    {
      heroImage && (
        <div class="container article__hero">
          <Image src={heroImage} alt={heroAlt ?? ''} widths={[640, 960, 1280, 1600]} sizes="(min-width: 72rem) 72rem, 100vw" loading="eager" fetchpriority="high" />
        </div>
      )
    }

    <div class:list={['container', 'article__layout', { 'has-toc': showToc }]}>
      {
        showToc && (
          <aside class="article__toc">
            <TableOfContents headings={headings} />
          </aside>
        )
      }
      <div class="article__body">
        <div class="prose-article">
          <Content />
        </div>

        {
          tags.length > 0 && (
            <ul class="article__tags" aria-label="Tags">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }

        <section class="article__signup" aria-labelledby="article-signup-title">
          <h2 id="article-signup-title">Get the next one in your inbox.</h2>
          <p>Free guides, game picks, and hosting ideas from The Ludarium.</p>
          <NewsletterForm id="article-signup" />
        </section>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section related" aria-labelledby="related-title">
        <div class="container">
          <div class="section-head">
            <h2 id="related-title">Keep reading</h2>
            <a class="text-link" href={categoryUrl(category)}>
              More {category}
            </a>
          </div>
          <div class="related__grid">
            {related.map((item) => (
              <ArticleCard article={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>
