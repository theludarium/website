---
// The articles hub: search, reader paths by what someone came to do, one tile per category
// with its first reads, the newest articles, then every article. Data: src/lib/series.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import ArticleList from '@/components/ArticleList.astro';
import { articleUrl, getArticles } from '@/lib/articles';
import { CATEGORIES } from '@/lib/site';
import { READER_PATHS, START_HERE, bySlugs } from '@/lib/series';

const articles = await getArticles();
const paths = READER_PATHS.map((p) => ({ ...p, articles: bySlugs(p.slugs, articles) }));
const tiles = CATEGORIES.map((c) => ({
  ...c,
  count: articles.filter((a) => a.data.category === c.name).length,
  picks: bySlugs(START_HERE[c.slug] ?? [], articles).slice(0, 3),
})).filter((c) => c.count > 0);
const newest = articles.slice(0, 6);
---

<BaseLayout
  title="Articles"
  description="Articles about tabletop games: what to play, how to play, game night ideas, and why playing together matters. Start with a reading path or a topic."
>
  <PageIntro
    eyebrow="Read"
    title="Articles"
    lede={`${articles.length} guides, game night ideas, and stories about why we play together. Start with what you came for.`}
  >
    <form class="hub-search" role="search" action="/search/" method="get">
      <label class="visually-hidden" for="hub-q">Search the articles</label>
      <input type="hidden" name="in" value="Articles" />
      <input id="hub-q" type="search" name="q" placeholder="Search the articles, like &quot;games for two&quot;" autocomplete="off" enterkeyhint="search" />
      <button class="button" type="submit">Search</button>
    </form>
  </PageIntro>

  <section class="container hub-block" aria-labelledby="paths-title" data-pagefind-ignore>
    <h2 id="paths-title" class="hub-title">What brings you here?</h2>
    <ul class="paths">
      {
        paths.map((p) => (
          <li class="card path">
            <h3>{p.title}</h3>
            <p class="path__line">{p.line}</p>
            <ol class="path__list">
              {p.articles.map((a) => (
                <li>
                  <a href={articleUrl(a)}>{a.data.title}</a>
                </li>
              ))}
            </ol>
            <a class="text-link path__more" href={p.more.href}>
              {p.more.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container hub-block" aria-labelledby="topics-title" data-pagefind-ignore>
    <h2 id="topics-title" class="hub-title">Browse by topic</h2>
    <ul class="topics">
      {
        tiles.map((c) => (
          <li class="card topic" style={`--tint: ${c.tint}`}>
            <h3>
              <a href={`/articles/category/${c.slug}/`}>{c.name}</a>
            </h3>
            <p class="topic__desc">{c.description}</p>
            <ul class="topic__picks">
              {c.picks.map((a) => (
                <li>
                  <a href={articleUrl(a)}>{a.data.title}</a>
                </li>
              ))}
            </ul>
            <a class="text-link" href={`/articles/category/${c.slug}/`}>
              All {c.count} articles and series
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container hub-block" aria-labelledby="newest-title">
    <h2 id="newest-title" class="hub-title">Newest</h2>
    <div class="newest" data-pagefind-ignore>
      {newest.map((a) => <ArticleCard article={a} />)}
    </div>
  </section>

  <section class="container list-section" aria-labelledby="every-title">
    <h2 id="every-title" class="hub-title">Every article</h2>
    <p class="hub-lede">Newest first. Pick a topic to narrow it down.</p>
    <ArticleList articles={articles.slice(newest.length)} feature={false} cardHeading="h3" />
  </section>
</BaseLayout>

<style>
  .hub-search {
    display: flex;
    gap: var(--space-2);
    max-width: 36rem;
    margin-top: var(--space-6);
  }

  .hub-search input[type='search'] {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.7em 1em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .hub-search input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .hub-block {
    margin-bottom: var(--space-8);
  }

  .hub-title {
    margin: 0 0 var(--space-5);
    font-size: var(--text-2xl);
  }

  .hub-lede {
    margin: calc(-1 * var(--space-4)) 0 var(--space-5);
    color: var(--color-text-muted);
  }

  .paths,
  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .path h3,
  .topic h3 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
  }

  .path__line,
  .topic__desc {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .path__list,
  .topic__picks {
    display: grid;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    padding-left: 1.3em;
    font-size: var(--text-sm);
  }

  .topic__picks {
    list-style: disc;
  }

  .path__list a,
  .topic__picks a {
    font-weight: 600;
  }

  .path__more,
  .topic .text-link {
    margin-top: auto;
    font-size: var(--text-sm);
  }

  .topic {
    border-top: 4px solid var(--tint);
  }

  .topic h3 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .topic h3 a:hover {
    color: var(--color-primary);
  }

  .newest {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }

  .list-section {
    padding-bottom: var(--space-8);
  }

  @media (max-width: 30rem) {
    .hub-search {
      flex-direction: column;
    }
  }
</style>
