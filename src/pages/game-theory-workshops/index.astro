---
// Landing page: follows the landing page rules in CLAUDE.md, like /corporate-events/.
// One outcome, one action (the inquiry form, tagged service=game-theory), what the team
// practices, three objections, legal links. Built on the free Academy course Read the Table
// (src/content/courses/game-theory.yaml); the workshop plan is docs/corporate/GAME-THEORY-WORKSHOPS.md.
import BaseLayout from '@/layouts/BaseLayout.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import PreviewNote from '@/components/PreviewNote.astro';
---

<BaseLayout
  title="Game Theory Workshops for Teams"
  description="Game theory workshops for leaders and teams, taught through tabletop games. Practice strategy, negotiation, and incentives, then apply them at work."
>
  <section class="gt-hero">
    <div class="container gt-hero__grid">
      <div>
        <p class="eyebrow">For leaders and teams</p>
        <h1>Teach your team to think two moves ahead.</h1>
        <p class="gt-hero__sub">
          Game theory workshops, taught through tabletop games. Your people practice strategy, negotiation, and
          incentives at the table, then map the real decisions in front of them the same way.
        </p>
        <a class="button" href="#inquire">Plan your strategy workshop</a>
      </div>
      <div class="gt-hero__art">
        <img
          src="/academy/game-theory/card.svg"
          alt="A game table seen from above: two hands of cards face each other across the felt, with a two by two payoff table between them"
          width="640"
          height="360"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section gt-practice" aria-labelledby="gt-practice-title">
    <div class="container">
      <h2 id="gt-practice-title">What your team practices</h2>
      <ul class="gt-practice__list">
        <li>
          <h3>Seeing the whole game</h3>
          <p>Who the players are, what each one wants, and what each one knows, before anyone makes a move.</p>
        </li>
        <li>
          <h3>Negotiating from strength</h3>
          <p>Knowing your walk-away point, making promises people believe, and finding the deal that grows the pie.</p>
        </li>
        <li>
          <h3>Designing better incentives</h3>
          <p>Spotting where a goal or a bonus rewards the wrong move, and changing the rules so the best move for each person is the best move for the team.</p>
        </li>
      </ul>
      <p class="gt-practice__course">
        Every workshop is built on <a href="/academy/game-theory/">Read the Table</a>, our free game theory course. Read a lesson to see how we teach.
      </p>
    </div>
  </section>

  <section class="section gt-points" aria-labelledby="gt-points-title">
    <div class="container">
      <h2 id="gt-points-title" class="visually-hidden">Common questions</h2>
      <ul class="gt-points__list">
        <li>
          <h3>Is game theory too academic for our people?</h3>
          <p>No math required. Every idea is learned by playing a short game first, then named and connected to real work in the debrief.</p>
        </li>
        <li>
          <h3>How is this different from a strategy talk?</h3>
          <p>Your people make real decisions with real consequences at the table, then see their own choices mapped out. They remember what they did, not what they heard.</p>
        </li>
        <li>
          <h3>What does it take from us?</h3>
          <p>A room and your team. We bring the games, run the session, and lead the debrief.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight-top" id="inquire" aria-labelledby="inquire-title">
    <div class="container gt-form">
      <div class="gt-form__intro">
        <h2 id="inquire-title">Tell us about your team.</h2>
        <p>Two short steps. We will reply by email with ideas for a session built around the decisions your team faces.</p>
        <PreviewNote>
          Levi: confirm the formats, length, and pricing for game theory workshops (the draft plan in
          docs/corporate/GAME-THEORY-WORKSHOPS.md uses the same three formats as the team workshops). No
          prices or testimonials are on the page yet.
        </PreviewNote>
      </div>
      <InquiryForm
        service="game-theory"
        goalsLabel="What decisions or skills do you want your team to sharpen?"
        goalsPlaceholder="Negotiating with partners, pricing against competitors, aligning incentives across departments..."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .gt-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .gt-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-8);
  }

  .gt-hero h1 {
    max-width: 14ch;
    font-size: var(--text-4xl);
  }

  .gt-hero__sub {
    max-width: 34rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .gt-hero__art img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
  }

  .gt-practice {
    padding-top: var(--space-6);
  }

  .gt-practice h2 {
    margin-top: 0;
    font-size: var(--text-2xl);
  }

  .gt-practice__list,
  .gt-points__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .gt-practice__list li {
    padding: var(--space-5);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .gt-points__list li {
    padding: var(--space-5);
    border-top: 3px solid var(--color-primary);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: var(--color-surface);
  }

  .gt-practice__list h3,
  .gt-points__list h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .gt-practice__list p,
  .gt-points__list p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .gt-practice__course {
    margin: var(--space-5) 0 0;
    color: var(--color-text-muted);
  }

  .gt-points {
    padding-top: 0;
  }

  .section--tight-top {
    padding-top: 0;
  }

  #inquire {
    scroll-margin-top: 5rem;
  }

  .gt-form {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .gt-form__intro h2 {
    margin-top: 0;
    font-size: var(--text-3xl);
  }

  .gt-form__intro p {
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .gt-hero__grid,
    .gt-form {
      grid-template-columns: 1fr;
    }
  }
</style>
