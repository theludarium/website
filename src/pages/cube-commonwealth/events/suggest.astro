---
// Suggest an event: a three-step form that posts to functions/api/events/suggest.ts.
// The suggestion is saved as pending and emailed to Levi, who approves it on the
// calendar admin page. Follows the landing page rules in CLAUDE.md: one outcome,
// one action, three objections, legal links. Without JavaScript all three steps
// simply show at once. The step logic is in src/scripts/calendar-suggest.ts.
// Spec: docs/calendar/SPEC.md, section 9.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { TURNSTILE_SITE_KEY } from '@/lib/config';
import { CUBE_DISCORD_URL } from '@/lib/cube-commonwealth';
import { IS_PREVIEW } from '@/lib/env';
import { CAL_API, CAL_BASE, CAL_LIMITS, EVENT_KINDS } from '@/lib/calendar/shared';

// Previews and local dev use Cloudflare's always-pass test key, as Where We Play does.
const TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = IS_PREVIEW ? TEST_SITE_KEY : TURNSTILE_SITE_KEY;
---

<BaseLayout
  title="Suggest an Event for the Cube Commonwealth Calendar"
  description="Hosting a Magic Cube draft, a class, or a meetup? Suggest it for the Cube Commonwealth events calendar. We review each one before it goes on the calendar."
>
  <div class="container sug">
    <header class="sug__head">
      <div>
        <p class="eyebrow"><a href={CAL_BASE}>Cube Commonwealth Events</a></p>
        <h1>Put your event on the calendar.</h1>
        <p class="sug__lede">Hosting a draft, a class, or a meetup? Tell us what, when, and where. Once it is approved, the whole Cube Commonwealth can find it.</p>
      </div>
      {/* Proof of the headline: a corner of the calendar with one day picked out. The kind colors match the calendar page. */}
      <svg class="sug__art" viewBox="0 0 264 188" aria-hidden="true" focusable="false">
        <defs>
          <g id="sug-cube">
            <path class="sug__cube-top" d="M0-10 8.7-5 0 0-8.7-5Z" />
            <path class="sug__cube-left" d="M-8.7-5 0 0V10L-8.7 5Z" />
            <path class="sug__cube-right" d="M8.7-5V5L0 10V0Z" />
          </g>
        </defs>
        <g class="sug__day">
          <rect x="1" y="1" width="78" height="86" rx="14" />
          <text x="13" y="25">26</text>
          <use href="#sug-cube" x="22" y="60" style="--c: var(--color-primary)" />
          <use href="#sug-cube" x="45" y="60" style="--c: var(--chart-3)" />
        </g>
        <g class="sug__day" transform="translate(92 0)">
          <rect x="1" y="1" width="78" height="86" rx="14" />
          <text x="13" y="25">27</text>
          <use href="#sug-cube" x="22" y="60" style="--c: var(--color-stone)" />
        </g>
        <g class="sug__day" transform="translate(184 0)">
          <rect x="1" y="1" width="78" height="86" rx="14" />
          <text x="13" y="25">28</text>
          <use href="#sug-cube" x="19" y="60" style="--c: var(--color-primary)" />
          <use href="#sug-cube" x="40" y="60" style="--c: var(--color-text-muted)" />
          <use href="#sug-cube" x="61" y="60" style="--c: var(--color-cta)" />
        </g>
        <g class="sug__day" transform="translate(0 100)">
          <rect x="1" y="1" width="78" height="86" rx="14" />
          <text x="13" y="25">3</text>
          <use href="#sug-cube" x="22" y="60" style="--c: var(--chart-3)" />
        </g>
        <g class="sug__day sug__day--yours" transform="translate(92 100)">
          <rect x="1.5" y="1.5" width="77" height="85" rx="14" />
          <text x="13" y="25">4</text>
          <use href="#sug-cube" transform="translate(40 54) scale(1.9)" style="--c: var(--color-primary)" />
        </g>
        <g class="sug__day" transform="translate(184 100)">
          <rect x="1" y="1" width="78" height="86" rx="14" />
          <text x="13" y="25">5</text>
          <use href="#sug-cube" x="22" y="60" style="--c: var(--color-primary)" />
          <use href="#sug-cube" x="45" y="60" style="--c: var(--color-stone)" />
        </g>
      </svg>
    </header>

    <form class="card sug__form" id="form" method="post" action={`${CAL_API}/suggest`} data-suggest-form data-pagefind-ignore>
      <p class="sug__status sug__status--ok" data-ok hidden role="status">
        Thank you. Your event is in the queue. It will appear on the calendar once it is approved.{' '}
        <a href={CAL_BASE}>Back to the calendar</a>
      </p>
      <p class="sug__status sug__status--error" data-error hidden role="alert"></p>
      <noscript><p class="sug__status sug__status--error">This form needs JavaScript for its spam check. You can also send your event to us in <a href={CUBE_DISCORD_URL}>the Discord</a>.</p></noscript>
      <p class="sug__step" data-step-label aria-live="polite" hidden></p>

      <fieldset data-step>
        <legend>The event</legend>
        <label>
          <span class="sug__name">Event title <span>Required</span></span>
          <input name="title" required maxlength={CAL_LIMITS.title} placeholder="Pauper Cube Night" autocomplete="off" />
        </label>
        <div class="sug__pair">
          <label>
            <span class="sug__name">Kind of event</span>
            <select name="kind">{EVENT_KINDS.map((k) => <option value={k.key}>{k.label}</option>)}</select>
          </label>
          <label>
            <span class="sug__name">Date <span>Required</span></span>
            <input name="date" type="date" required />
          </label>
        </div>
        <div class="sug__pair sug__pair--always">
          <label>
            <span class="sug__name">Starts <span>Required</span></span>
            <input name="start_time" type="time" required />
          </label>
          <label>
            <span class="sug__name">Ends <span>Required</span></span>
            <input name="end_time" type="time" required />
          </label>
        </div>
      </fieldset>

      <fieldset data-step>
        <legend>Where and what</legend>
        <label>
          <span class="sug__name">Place name <span>Optional</span></span>
          <input name="location_name" maxlength={CAL_LIMITS.locationName} placeholder="Game store, library, or home" autocomplete="off" />
        </label>
        <label>
          <span class="sug__name">Address <span>Optional, and public</span></span>
          <input name="location_address" maxlength={CAL_LIMITS.locationAddress} placeholder="Street and city" autocomplete="off" />
          <small>Everyone can see it once the event is approved. Leave it out for a private home.</small>
        </label>
        <label>
          <span class="sug__name">Description <span>Optional</span></span>
          <textarea name="description" rows="4" maxlength={CAL_LIMITS.description} placeholder="What should people know or bring?"></textarea>
        </label>
        <label class="sug__check">
          <input type="checkbox" name="has_draft" value="yes" checked aria-describedby="sug-draft-note" />
          People will draft a Cube at this event
        </label>
        <small id="sug-draft-note">People who are going can then suggest Cubes from the Cube Library and vote on one.</small>
      </fieldset>

      <fieldset data-step>
        <legend>You</legend>
        <p class="sug__review" data-review hidden>
          <span>You are sending</span>
          <strong data-review-title></strong>
          <span data-review-when></span>
        </p>
        <label>
          <span class="sug__name">Your name <span>Required, never public</span></span>
          <input name="name" required maxlength={CAL_LIMITS.submitterName} autocomplete="name" />
        </label>
        <label>
          <span class="sug__name">Email <span>Optional, never public</span></span>
          <input name="email" type="email" maxlength={CAL_LIMITS.email} pattern="[^\s@]+@[^\s@]+\.[^\s@]+" title="An address like you@example.com" placeholder="you@example.com" autocomplete="email" />
          <small>Only so we can ask you about this event. It is not added to a mailing list.</small>
        </label>
      </fieldset>

      <div class="sug__trap" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div>

      {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="auto"></div>}

      <div class="sug__actions">
        <button class="button button--ghost" type="button" data-back hidden>Back</button>
        <button class="button" type="button" data-next hidden>Next</button>
        <button class="button" type="submit" data-submit>Send my event for review</button>
      </div>
      <p class="sug__fine">We review every event before it goes on the calendar. <a href="/privacy/">Privacy</a> and <a href="/terms/">Terms</a></p>
    </form>

    <section class="sug__points" aria-labelledby="sug-points-title">
      <h2 id="sug-points-title" class="visually-hidden">Common questions</h2>
      <ul>
        <li>
          <h3>Who approves events?</h3>
          <p>A person, not a program. The Cube Commonwealth organizer reads every suggestion, and may tidy a detail or ask you a question first.</p>
        </li>
        <li>
          <h3>What shows publicly?</h3>
          <p>The event itself: its title, date, times, place, address, and description. Your name and email stay private.</p>
        </li>
        <li>
          <h3>What happens to my email?</h3>
          <p>It is optional. We use it only to ask you about this event. It is not added to a mailing list.</p>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import '@/scripts/calendar-suggest';
</script>

<style>
  .sug { max-width: 46rem; padding-block: var(--space-7); }
  /* The script hides steps and buttons with the hidden attribute. Layout rules below must never undo that. */
  .sug [hidden] { display: none !important; }

  .sug__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: var(--space-6); margin-bottom: var(--space-5); }
  .sug__head h1 { margin-block: var(--space-1) var(--space-3); font-size: var(--text-3xl); }
  .sug__lede { margin: 0; font-size: var(--text-lg); color: var(--color-text-muted); }

  .sug__art { width: 14rem; overflow: visible; }
  .sug__day rect { fill: var(--color-surface); stroke: var(--color-border); stroke-width: 1; }
  .sug__day text { fill: var(--color-text-muted); font-family: var(--font-body); font-size: 13px; font-weight: 650; }
  .sug__day--yours rect { fill: var(--color-accent-soft); stroke: var(--color-cta); stroke-width: 3; }
  .sug__day--yours text { fill: var(--color-text); }
  /* One mini-Cube, three faces: each use sets --c to its kind color. */
  .sug__cube-top { fill: color-mix(in srgb, var(--c) 62%, white); }
  .sug__cube-left { fill: var(--c); }
  .sug__cube-right { fill: color-mix(in srgb, var(--c) 72%, black); }

  .sug__form { display: grid; gap: var(--space-4); scroll-margin-top: 6rem; }
  .sug fieldset { display: grid; gap: var(--space-4); min-width: 0; margin: 0; padding: 0; border: 0; }
  .sug legend { margin-bottom: var(--space-3); padding: 0; font-family: var(--font-display); font-size: var(--text-xl); font-weight: 600; scroll-margin-top: 7rem; }
  /* The legend takes focus when the step changes, only so the step is announced. It is not a control. */
  .sug legend:focus { outline: none; }
  .sug label { display: grid; gap: var(--space-1); min-width: 0; font-size: var(--text-sm); font-weight: 600; }
  .sug__name span { margin-left: var(--space-1); font-size: var(--text-xs); font-weight: 400; color: var(--color-text-muted); }
  .sug small { font-size: var(--text-xs); font-weight: 400; color: var(--color-text-muted); }
  /* 48px tall for thumbs, and at least 16px type so iPhones do not zoom in on focus. */
  .sug input, .sug select, .sug textarea {
    width: 100%; min-width: 0; padding: 0.6em 0.9em; border: 1px solid var(--color-border); border-radius: var(--radius-md);
    background: var(--color-surface); color: var(--color-text); font: inherit; font-size: var(--text-base); font-weight: 400;
  }
  .sug input, .sug select { height: 3rem; }
  /* Examples in empty fields: readable in both themes, and still quieter than a real answer. */
  .sug input::placeholder, .sug textarea::placeholder { color: var(--color-text-muted); opacity: 1; }
  .sug textarea { resize: vertical; }
  /* iPhones size date and time fields to their contents and center the value. Treat them like the other fields. */
  .sug input[type='date'], .sug input[type='time'] { -webkit-appearance: none; appearance: none; }
  .sug input::-webkit-date-and-time-value { text-align: left; }
  .sug input:focus-visible, .sug select:focus-visible, .sug textarea:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }

  .sug__pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: end; gap: var(--space-4); }
  .sug .sug__check { display: flex; align-items: center; gap: var(--space-3); min-height: 2.75rem; cursor: pointer; }
  .sug .sug__check input { flex: none; width: 1.25rem; min-height: 0; height: 1.25rem; margin: 0; padding: 0; accent-color: var(--color-primary); }
  .sug .sug__check + small { margin-top: calc(-1 * var(--space-3)); }

  .sug__step { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); }
  .sug .sug__status { margin: 0; padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text); font-weight: 600; }
  .sug .sug__status--ok { background: var(--color-accent-soft); }
  .sug .sug__status--error { border-color: var(--color-accent); }
  .sug .sug__review { display: grid; gap: 2px; margin: 0; padding: var(--space-3) var(--space-4); border-radius: var(--radius-md); background: var(--color-surface-alt); color: var(--color-text); font-size: var(--text-sm); }
  .sug__review span:first-child { font-size: var(--text-xs); color: var(--color-text-muted); }
  .sug__review strong { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; overflow-wrap: anywhere; }
  .sug__trap { position: absolute; left: -9999px; }
  /* When the two buttons do not fit on one line, the main one goes on top and Back drops below it. */
  .sug__actions { display: flex; flex-wrap: wrap-reverse; gap: var(--space-3); }
  .sug__fine { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); }

  .sug__points { margin-top: var(--space-6); }
  .sug__points ul { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); gap: var(--space-4); margin: 0; padding: 0; list-style: none; }
  .sug__points li { padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); }
  .sug__points h3 { margin: 0 0 var(--space-2); font-size: var(--text-lg); }
  .sug__points p { margin: 0; font-size: var(--text-sm); color: var(--color-text-muted); }

  @media (max-width: 48rem) {
    /* On small screens the form comes first, so the picture steps aside. */
    .sug__head { grid-template-columns: minmax(0, 1fr); }
    .sug__art { display: none; }
  }
  @media (max-width: 30rem) {
    /* A little less padding, so the 300px spam check fits inside the card at 360px wide. */
    .sug__form { padding: var(--space-5) var(--space-4); }
    .sug__pair:not(.sug__pair--always) { grid-template-columns: minmax(0, 1fr); }
    /* Two time fields share one row here, so give the digits a little more room. */
    .sug input[type='time'] { padding-inline: 0.55em; }
  }
</style>
