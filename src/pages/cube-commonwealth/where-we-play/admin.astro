---
// Where We Play admin. Cloudflare Access guards this path and the admin API
// at the edge (README.md, "Where We Play"). The page is static HTML; the
// script in src/scripts/where-we-play-admin.ts fills it from the admin API.
// Previews and local dev use WWP_ADMIN_PREVIEW_TOKEN instead of Access.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SLOTS, VENUE_STATUSES, WWP_API, WWP_BASE } from '@/lib/where-we-play/shared';

const LEAFLET = {
  css: { href: 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css', integrity: 'sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=' },
  js: { src: 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js', integrity: 'sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=' },
};
---

<BaseLayout title="Where We Play admin" description="Admin for Where We Play: venues, members, rankings, map, and events." noindex>
  <Fragment slot="head">
    <link rel="stylesheet" href={LEAFLET.css.href} integrity={LEAFLET.css.integrity} crossorigin="anonymous" />
    <script is:inline src={LEAFLET.js.src} integrity={LEAFLET.js.integrity} crossorigin="anonymous" defer></script>
  </Fragment>

  <div class="wwp-admin container" data-wwp-admin data-api={`${WWP_API}/admin`} data-base={WWP_BASE} data-pagefind-ignore>
    <header class="wwp-admin__head">
      <div>
        <p class="eyebrow">Cube Commonwealth</p>
        <h1>Where We Play</h1>
      </div>
      <nav class="wwp-admin__nav" aria-label="Sections">
        <a href="#rankings">Rankings</a>
        <a href="#map">Map</a>
        <a href="#venues">Venues</a>
        <a href="#members">Members</a>
        <a href="#events">Events</a>
      </nav>
    </header>

    <p class="wwp-admin__msg" role="status" data-msg hidden></p>

    <section class="wwp-admin__auth" data-auth hidden>
      <h2>Preview access</h2>
      <p>This is a preview, so Cloudflare Access is not in front of it. Enter the preview token set in the Pages project (WWP_ADMIN_PREVIEW_TOKEN). It is kept for this tab only.</p>
      <form data-auth-form>
        <input type="password" name="token" autocomplete="off" placeholder="Preview token" required />
        <button class="button" type="submit">Open admin</button>
      </form>
    </section>

    <section class="wwp-admin__summary" data-summary aria-label="Summary"></section>

    <section id="rankings" class="wwp-admin__section" aria-labelledby="rankings-title">
      <div class="wwp-admin__section-head">
        <h2 id="rankings-title">Rankings</h2>
        <label class="wwp-admin__slot">
          Members available
          <select data-slot>
            <option value="">Everyone with a location</option>
            {SLOTS.map((slot) => <option value={slot.key}>{slot.label}</option>)}
          </select>
        </label>
      </div>
      <div data-rankings></div>
      <div class="wwp-admin__detail" data-detail hidden></div>
    </section>

    <section id="map" class="wwp-admin__section" aria-labelledby="map-title">
      <div class="wwp-admin__section-head">
        <h2 id="map-title">Map</h2>
        <label class="wwp-admin__toggle">
          <input type="checkbox" data-public-view /> Public view (members snapped to cross street or zip)
        </label>
      </div>
      <div class="wwp-map" data-map></div>
      <p class="wwp-admin__legend" data-legend></p>
    </section>

    <section id="venues" class="wwp-admin__section" aria-labelledby="venues-title">
      <div class="wwp-admin__section-head">
        <h2 id="venues-title">Venues</h2>
      </div>
      <div data-queue></div>
      <details class="wwp-admin__add">
        <summary>Add a venue</summary>
        <form class="wwp-admin__add-form" data-add-venue>
          <label>Name <input name="name" required maxlength="120" /></label>
          <label>Address <input name="address" required maxlength="200" placeholder="Street, city, IN" /></label>
          <label>Neighborhood <input name="neighborhood" maxlength="80" placeholder="Carmel" /></label>
          <label>Tables <input name="table_count" type="number" min="0" max="500" /></label>
          <label>Hours <input name="hours" maxlength="200" placeholder="Tue to Sat, 12 to 10" /></label>
          <label>Website <input name="website" maxlength="300" /></label>
          <label>Status
            <select name="status">
              {VENUE_STATUSES.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <label class="wwp-admin__check"><input type="checkbox" name="call_ahead" /> Call ahead</label>
          <label class="wwp-admin__check"><input type="checkbox" name="address_public" /> Show street address to members</label>
          <label class="wwp-admin__wide">Notes <textarea name="notes" rows="2" maxlength="3000"></textarea></label>
          <button class="button" type="submit">Add venue</button>
        </form>
      </details>
      <div data-venues></div>
    </section>

    <section id="members" class="wwp-admin__section" aria-labelledby="members-title">
      <div class="wwp-admin__section-head">
        <h2 id="members-title">Members</h2>
        <label class="wwp-admin__toggle">
          <input type="checkbox" data-show-addresses /> Show addresses
        </label>
      </div>
      <div data-members></div>
    </section>

    <section id="events" class="wwp-admin__section" aria-labelledby="events-title">
      <div class="wwp-admin__section-head">
        <h2 id="events-title">Events</h2>
      </div>
      <form class="wwp-admin__add-form wwp-admin__add-form--events" data-add-event>
        <label>Date <input name="date" type="date" required /></label>
        <label>Venue <select name="venue_id" data-event-venues><option value="">Somewhere else</option></select></label>
        <label>Headcount <input name="headcount" type="number" min="0" max="10000" value="0" required /></label>
        <label class="wwp-admin__wide">Notes <input name="notes" maxlength="3000" /></label>
        <button class="button button--ghost" type="submit">Record event</button>
      </form>
      <div data-events></div>
    </section>

    <noscript><p>The admin page needs JavaScript.</p></noscript>
  </div>
</BaseLayout>

<style is:global>
  /* The admin page is script-built, so its styles are global under .wwp-admin. */
  .wwp-admin {
    padding-block: var(--space-6) var(--space-9);
    max-width: var(--width-wide);
  }

  .wwp-admin__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .wwp-admin__head h1 {
    margin: 0;
    font-size: var(--text-3xl);
  }

  .wwp-admin__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .wwp-admin__nav a {
    padding: 0.35em 0.9em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-text);
  }

  .wwp-admin__nav a:hover {
    border-color: var(--color-primary);
  }

  .wwp-admin__msg,
  .wwp-admin__auth {
    margin: 0 0 var(--space-5);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
  }

  .wwp-admin__msg {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .wwp-admin__msg.is-error {
    background: #f3d6cf;
    color: #5a1f10;
  }

  .wwp-admin__auth h2 {
    margin-top: 0;
    font-size: var(--text-xl);
  }

  .wwp-admin__auth form {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .wwp-admin__summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }

  .wwp-stat {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .wwp-stat strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }

  .wwp-stat span {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .wwp-stat--actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .wwp-admin__section {
    margin-bottom: var(--space-8);
    scroll-margin-top: var(--space-6);
  }

  .wwp-admin__section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .wwp-admin__section-head h2 {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .wwp-admin__slot,
  .wwp-admin__toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .wwp-admin input:not([type='checkbox']),
  .wwp-admin select,
  .wwp-admin textarea {
    padding: 0.5em 0.7em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    font-size: var(--text-sm);
  }

  .wwp-admin input:focus-visible,
  .wwp-admin select:focus-visible,
  .wwp-admin textarea:focus-visible,
  .wwp-admin button:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 1px;
  }

  .wwp-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .wwp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .wwp-table th,
  .wwp-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
  }

  .wwp-table th {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .wwp-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .wwp-table .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .wwp-table tr[data-venue] {
    cursor: pointer;
  }

  .wwp-table tr[data-venue]:hover,
  .wwp-table tr.is-selected {
    background: var(--color-surface-alt);
  }

  .wwp-table td input,
  .wwp-table td select,
  .wwp-table td textarea {
    width: 100%;
    min-width: 7rem;
  }

  .wwp-table td textarea {
    min-width: 14rem;
    resize: vertical;
  }

  .wwp-table td.narrow input {
    min-width: 4rem;
    width: 4.5rem;
  }

  .wwp-table .actions {
    display: flex;
    gap: var(--space-2);
  }

  .wwp-btn {
    padding: 0.35em 0.8em;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-primary);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
  }

  .wwp-btn:hover {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .wwp-btn--danger {
    border-color: #b5543a;
    color: #b5543a;
  }

  .wwp-btn--danger:hover {
    background: #b5543a;
    color: #fff;
  }

  .wwp-btn--primary {
    background: var(--color-cta);
    border-color: var(--color-cta);
    color: var(--color-on-cta);
  }

  .wwp-status {
    display: inline-block;
    padding: 0.15em 0.6em;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    color: #fff;
    background: var(--color-stone);
  }

  .wwp-status[data-status='contacted'] { background: var(--color-cta); color: var(--color-on-cta); }
  .wwp-status[data-status='confirmed'] { background: var(--color-primary); color: var(--color-on-primary); }
  .wwp-status[data-status='played here'] { background: var(--color-text); color: var(--color-bg); }
  .wwp-status[data-status='not a fit'] { background: #b5543a; }

  .wwp-admin__detail {
    margin-top: var(--space-5);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .wwp-admin__detail h3 {
    margin: 0 0 var(--space-2);
  }

  .wwp-admin__detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-5);
  }

  .wwp-hist {
    display: grid;
    gap: 4px;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
  }

  .wwp-hist li {
    display: grid;
    grid-template-columns: 4.5rem 1fr 2rem;
    align-items: center;
    gap: var(--space-2);
  }

  .wwp-hist .bar {
    height: 0.9rem;
    border-radius: 4px;
    background: var(--color-primary);
    min-width: 2px;
  }

  .wwp-hist .bar.near {
    background: var(--color-cta);
  }

  .wwp-map {
    height: min(70vh, 36rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-surface-alt);
  }

  .wwp-map .leaflet-container {
    font: inherit;
  }

  :root[data-theme='dark'] .wwp-map .leaflet-tile {
    filter: brightness(0.75) contrast(1.05) saturate(0.7);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .wwp-map .leaflet-tile {
      filter: brightness(0.75) contrast(1.05) saturate(0.7);
    }
  }

  .wwp-admin__legend {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .wwp-admin__add {
    margin-bottom: var(--space-4);
  }

  .wwp-admin__add summary {
    cursor: pointer;
    font-weight: 600;
  }

  .wwp-admin__add-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: var(--space-3);
    align-items: end;
    margin: var(--space-3) 0 var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .wwp-admin__add-form label {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .wwp-admin__add-form .wwp-admin__check {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .wwp-admin__add-form .wwp-admin__wide {
    grid-column: 1 / -1;
  }

  .wwp-queue {
    display: grid;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .wwp-queue__item {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-cta);
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
  }

  .wwp-queue__item p {
    margin: 0;
    font-size: var(--text-sm);
  }

  .wwp-empty {
    padding: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .wwp-admin__detail-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import '@/scripts/where-we-play-admin';
</script>
