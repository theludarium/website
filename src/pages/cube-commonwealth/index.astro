---
// The Cube Commonwealth home: the community, weekly play, the Cube Quarterly Celebration (CQC)
// and its Passport, Cube content, services to come, and the plan for every Ludarium.
// Data: src/lib/cube-commonwealth.ts. Tools live below this path (where-we-play/).
import BaseLayout from '@/layouts/BaseLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import { CUBE_DISCORD_URL, CUBE_VALUES, CQC_STAMPS, CQC_CITIES } from '@/lib/cube-commonwealth';
---

<BaseLayout
  title="Cube Commonwealth: Magic Cube Community in Indianapolis"
  description="The Cube Commonwealth is The Ludarium's community for Magic: The Gathering Cube players: weekly drafts in Indianapolis, the CQC, guides, and a Discord."
>
  <section class="cc-hero">
    <div class="container cc-hero__grid">
      <div>
        <p class="eyebrow">The Ludarium: Cube Commonwealth</p>
        <h1>Cube is better together.</h1>
        <p class="lede">
          The Cube Commonwealth is a community of Magic: The Gathering Cube players. It started in Indianapolis, it
          meets every week, and it is growing toward a home in every city with a Ludarium.
        </p>
        <div class="cc-actions">
          <a class="button" href={CUBE_DISCORD_URL} rel="noopener">Join the Discord</a>
          <a class="button button--ghost" href="#cqc">The Cube Quarterly Celebration</a>
        </div>
      </div>
      <dl class="cc-stats card">
        <div>
          <dt>About 300</dt>
          <dd>members in the Indianapolis Discord</dd>
        </div>
        <div>
          <dt>8 to 12</dt>
          <dd>players at a typical weekly draft, up to 16</dd>
        </div>
        <div>
          <dt>24</dt>
          <dd>drafters at our all-day CQC events</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section cc-story" aria-labelledby="cc-story-title">
    <div class="container cc-narrow">
      <h2 id="cc-story-title">How it started</h2>
      <p>
        The Cube Commonwealth began in Indianapolis as a handful of cubers who wanted a regular night. For years we met
        every Sunday at a Panera Bread, pushed tables together, and drafted. Most weeks brought 8 to 12 players, and
        plenty of weeks brought 16.
      </p>
      <p>
        The lesson was simple: people come back when there is a place and a time they can count on. That is the
        whole idea behind The Ludarium, and the Cube Commonwealth is where it started.
      </p>
      <p class="cc-mission">Our mission: help people connect and thrive together, one Cube at a time.</p>
    </div>
  </section>

  <section class="section cc-values" aria-labelledby="cc-values-title">
    <div class="container">
      <h2 id="cc-values-title">What we care about</h2>
      <ul class="cc-grid">
        {
          CUBE_VALUES.map((v) => (
            <li class="card">
              <h3>{v.name}</h3>
              <p>{v.line}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section cc-play" aria-labelledby="cc-play-title">
    <div class="container">
      <h2 id="cc-play-title">Play with us</h2>
      <ul class="cc-grid">
        <li class="card">
          <h3>Weekly drafts</h3>
          <p>We draft every week in the Indianapolis area. The Discord always has the current night, the place, and who is coming.</p>
          <a class="text-link" href={CUBE_DISCORD_URL} rel="noopener">See this week's draft</a>
        </li>
        <li class="card">
          <h3>Help pick our next home</h3>
          <p>Share where you drive from, privately, and we find the stores, libraries, and pubs with the shortest drive for the most players.</p>
          <a class="text-link" href="/cube-commonwealth/where-we-play/">Where We Play</a>
        </li>
        <li class="card">
          <h3>New to Cube?</h3>
          <p>A Cube is a curated set of Magic cards made for drafting. Nobody buys packs, and everyone plays with the same pool.</p>
          <a class="text-link" href="/articles/what-is-a-magic-cube/">What is a Magic Cube?</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section cc-cqc" id="cqc" aria-labelledby="cc-cqc-title">
    <div class="container">
      <p class="eyebrow">Four times a year</p>
      <h2 id="cc-cqc-title">The Cube Quarterly Celebration</h2>
      <div class="cc-cqc__intro">
        <p>
          The CQC is a full day of Cube, four times a year. It began as the Cube Quarterly Championship, with 24
          drafters and a long day of pods. It is now a celebration: a party built around drafting, with food, friends,
          and pods for every level. Nobody needs to chase a trophy to have the best day of the season.
        </p>
        <p>
          Starting in 2027, we hope to share the four dates with our neighbors: {CQC_CITIES.slice(0, -1).join(', ')}, and {CQC_CITIES.at(-1)}.
          Cities and dates are being worked out now, and the Cube letter and the Discord will have them first.
        </p>
      </div>

      <div class="cc-passport card">
        <div class="cc-passport__head">
          <h3>The CQC Passport</h3>
          <p>
            Instead of season points and a champion, every attendee carries a Passport. Earn stamps for showing up and
            for making the day better for everyone. What a full Passport earns will be announced with the 2027 schedule.
          </p>
        </div>
        <ul class="cc-stamps">
          {
            CQC_STAMPS.map((s) => (
              <li>
                <span class="cc-stamp" aria-hidden="true"></span>
                <span class="cc-stamps__name">{s.name}</span>
                <span class="cc-stamps__line">{s.line}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="cc-signup card">
        <div>
          <h3>Get the CQC dates first</h3>
          <p>The Cube letter brings CQC news, Cube Commonwealth updates, and draft guides. Free, and you can leave anytime.</p>
        </div>
        <NewsletterForm id="cc-signup" letters="cube" buttonLabel="Send me CQC dates" />
      </div>
    </div>
  </section>

  <section class="section cc-learn" aria-labelledby="cc-learn-title">
    <div class="container">
      <h2 id="cc-learn-title">Get better at Cube</h2>
      <ul class="cc-grid">
        <li class="card">
          <h3>Cube articles</h3>
          <p>Draft strategy, Cube design, house rules, and reviews of new cards for Cube.</p>
          <a class="text-link" href="/articles/category/magic-and-cube/">Magic and Cube articles</a>
        </li>
        <li class="card">
          <h3>Free Academy courses</h3>
          <p>Learn to draft a Cube, or learn Magic itself from the first turn, one short lesson at a time.</p>
          <a class="text-link" href="/academy/cube-draft/">Cube Draft course</a>
          <a class="text-link" href="/academy/magic/">Magic course</a>
        </li>
        <li class="card">
          <h3>Rules help at the table</h3>
          <p>Head Judge Arbiter answers Magic rules questions mid-game, like a friendly judge.</p>
          <a class="text-link" href="/head-judge-arbiter/">Ask Head Judge Arbiter</a>
        </li>
      </ul>
    </div>
  </section>

  <section class="section cc-services" aria-labelledby="cc-services-title">
    <div class="container cc-narrow">
      <p class="eyebrow">On the way</p>
      <h2 id="cc-services-title">Cube coaching and Cube design help</h2>
      <p>
        Two services are on the way. <strong>Cube coaching</strong>: one-on-one lessons on drafting, deck building, and
        play. <strong>Cube design help</strong>: building, balancing, and writing a primer for your own Cube. If you want
        either one, say so in the Discord, and you will hear first when they open.
      </p>
    </div>
  </section>

  <section class="section cc-network" aria-labelledby="cc-network-title">
    <div class="container cc-narrow">
      <h2 id="cc-network-title">A Cube Commonwealth at every Ludarium</h2>
      <p>
        The Ludarium is building membership game lounges, starting in Indianapolis, where any group can have a
        regular table. Every Ludarium will have its own local Cube Commonwealth, so a cuber who travels can walk in,
        sit down, and draft with friends they have not met yet.
      </p>
      <p>
        Want a Cube Commonwealth in your city? Start the conversation in the <a href={CUBE_DISCORD_URL} rel="noopener">Discord</a>, and read
        about <a href="/lounges/">the lounges</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .cc-hero {
    padding-block: var(--space-9) var(--space-7);
  }

  .cc-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .cc-hero h1 {
    max-width: 12ch;
    font-size: var(--text-4xl);
  }

  .cc-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .cc-stats {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: var(--space-6);
  }

  .cc-stats dt {
    font-family: var(--font-display, inherit);
    font-size: var(--text-3xl);
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
  }

  .cc-stats dd {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }

  .cc-story,
  .cc-values,
  .cc-play,
  .cc-cqc,
  .cc-learn,
  .cc-services,
  .cc-network {
    padding-top: 0;
  }

  .section h2 {
    margin: 0 0 var(--space-5);
    font-size: var(--text-3xl);
  }

  .cc-narrow {
    max-width: 42rem;
  }

  .cc-narrow p {
    font-size: var(--text-lg);
  }

  .cc-mission {
    margin-top: var(--space-5);
    padding-left: var(--space-4);
    border-left: 4px solid var(--color-primary);
    font-weight: 600;
  }

  .cc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cc-grid h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .cc-grid p {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }

  .cc-grid .text-link {
    display: block;
    margin-top: auto;
    font-size: var(--text-sm);
  }

  .cc-grid .text-link + .text-link {
    margin-top: var(--space-1);
  }

  .cc-cqc {
    scroll-margin-top: 5.5rem;
  }

  .cc-cqc h2 {
    margin-bottom: var(--space-4);
  }

  .cc-cqc__intro {
    max-width: 42rem;
    margin-bottom: var(--space-6);
  }

  .cc-cqc__intro p {
    font-size: var(--text-lg);
  }

  .cc-passport {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-6);
    margin-bottom: var(--space-5);
  }

  .cc-passport h3,
  .cc-signup h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .cc-passport__head p,
  .cc-signup p {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 40rem;
  }

  .cc-stamps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cc-stamps li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    align-items: start;
  }

  .cc-stamp {
    grid-row: span 2;
    width: 2.5rem;
    height: 2.5rem;
    border: 2px dashed var(--color-primary);
    border-radius: 50%;
  }

  .cc-stamps__name {
    font-weight: 650;
  }

  .cc-stamps__line {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .cc-signup {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-6);
  }

  @media (max-width: 52rem) {
    .cc-hero__grid,
    .cc-signup {
      grid-template-columns: 1fr;
    }
  }
</style>
