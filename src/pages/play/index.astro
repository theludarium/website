---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/PageIntro.astro';
import { MARK_PATH, MARK_VIEWBOX } from '@/lib/brand';

const tools = [
  {
    href: '/card-catalogue/',
    name: 'The Card Catalogue',
    status: 'Live',
    blurb: 'Every game on a library shelf, sorted by six dimensions of feel. Rate what you play and get picks your whole table will enjoy.',
    cta: 'Open the catalogue',
    more: { href: '/articles/how-we-catalog-board-games-by-how-they-feel/', label: 'How it works' },
  },
  {
    href: '/rpg-demo-library/',
    name: 'RPG Demo Library',
    status: 'Coming soon',
    blurb: 'Play a short intro adventure of a pen-and-paper role-playing game, right in your browser, before you buy it.',
    cta: 'Learn more',
  },
  {
    href: '/game-night-madness/',
    name: 'Game Night Madness',
    status: 'Coming soon',
    blurb: "Build a bracket of games and let your group vote their way to tonight's winner.",
    cta: 'Learn more',
  },
];
---

<BaseLayout
  title="Play"
  description="Free tools from The Ludarium for players and game nights: the Card Catalogue, the RPG Demo Library, and Game Night Madness. No account needed."
>
  <PageIntro eyebrow="Free tools" title="Tools for your table" lede="Find the right game, try one before you buy it, and settle what to play tonight. Free, no account needed." />

  <section class="container play-list">
    {
      tools.map((t) => (
        <article class="card play-tool">
          <svg class="play-tool__mark" viewBox={MARK_VIEWBOX} aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d={MARK_PATH} />
          </svg>
          <div>
            <p class:list={['play-tool__status', { 'is-live': t.status === 'Live' }]}>{t.status}</p>
            <h2>
              <a href={t.href}>{t.name}</a>
            </h2>
            <p>{t.blurb}</p>
            <p class="play-tool__links">
              <a class="text-link" href={t.href}>
                {t.cta}
              </a>
              {t.more && <a href={t.more.href}>{t.more.label}</a>}
            </p>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .play-list {
    display: grid;
    gap: var(--space-5);
    padding-bottom: var(--space-8);
  }

  .play-tool {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-5);
    align-items: start;
  }

  .play-tool__mark {
    width: 4rem;
    color: var(--color-primary);
  }

  .play-tool h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
  }

  .play-tool h2 a {
    color: var(--color-text);
    text-decoration: none;
  }

  .play-tool h2 a:hover {
    color: var(--color-primary);
  }

  .play-tool__status {
    display: inline-block;
    margin: 0 0 var(--space-2);
    padding: 1px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-surface-alt);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .play-tool__status.is-live {
    background: var(--color-cta);
    color: var(--color-on-cta);
  }

  .play-tool__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: var(--space-3) 0 0;
    font-weight: 600;
  }

  @media (max-width: 36rem) {
    .play-tool {
      grid-template-columns: 1fr;
    }

    .play-tool__mark {
      width: 3rem;
    }
  }
</style>
