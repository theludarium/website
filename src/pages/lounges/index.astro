---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LOUNGES } from '@/lib/lounges';
import { MARK_PATH, MARK_VIEWBOX } from '@/lib/brand';

const pillars = [
  {
    title: 'Every game community',
    body: "Board gamers and card players, chess and Go clubs, mahjong tables, RPG campaigns, miniatures painters, and game designers. Clubs and game store communities meet here too.",
  },
  {
    title: 'A community center for play',
    body: 'Open tables any night, plus events that grow from each city: tournaments, design seminars, talks, and debates. Each lounge becomes what its community needs.',
  },
  {
    title: 'One membership, every city',
    body: 'Members pay for what they actually want: the space and the people. Travel to any Ludarium and walk into a community that already feels like yours.',
  },
];
---

<BaseLayout
  title="The Lounges"
  description="The Ludarium Game Lounge is a membership community center where every tabletop community meets. The first lounge is coming to Indianapolis."
>
  <section class="lounges-hero">
    <div class="container">
      <p class="eyebrow">The Ludarium Game Lounges</p>
      <h1>Where every game community meets.</h1>
      <p class="lede">
        A membership game lounge, like a coworking space built for play. Walk in on your own, and there
        is a table and someone to play with. Bring your club, and it has a home.
      </p>
      <a class="button" href={`/lounges/${LOUNGES[0].slug}/`}>Join the {LOUNGES[0].city} waitlist</a>
    </div>
  </section>

  <section class="section section--tight-top">
    <div class="container pillars">
      {
        pillars.map((p) => (
          <div class="card">
            <h2>{p.title}</h2>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Lounges</h2>
          <p>Indianapolis is first. Then a lounge in every city, all connected.</p>
        </div>
      </div>
      <div class="cities">
        {
          LOUNGES.map((lounge) => (
            <a class="card city-card" href={`/lounges/${lounge.slug}/`}>
              <svg viewBox={MARK_VIEWBOX} aria-hidden="true">
                <path fill="currentColor" fill-rule="evenodd" d={MARK_PATH} />
              </svg>
              <p class="eyebrow">Lounge No. {lounge.number}</p>
              <h3>{lounge.city}, {lounge.region}</h3>
              <p>{lounge.blurb}</p>
              <span class="card__more">{lounge.status === 'waitlist' ? 'Join the waitlist' : 'Visit'}</span>
            </a>
          ))
        }
        <div class="card city-card city-card--next">
          <p class="eyebrow">Lounge No. 002</p>
          <h3>Your city?</h3>
          <p>Want a Ludarium near you? Join the newsletter and tell us where. Demand decides what comes next.</p>
          <a class="card__more" href="/newsletter/">Join the newsletter</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lounges-hero {
    padding-block: var(--space-9) var(--space-7);
  }

  .lounges-hero h1 {
    max-width: 14ch;
    font-size: var(--text-4xl);
  }

  .lounges-hero .lede {
    margin-bottom: var(--space-6);
  }

  .section--tight-top {
    padding-top: 0;
  }

  .section--alt {
    background: var(--color-surface-alt);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
  }

  .pillars h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .cities {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
  }

  .city-card svg {
    width: 3rem;
    margin-bottom: var(--space-5);
    color: var(--color-primary);
  }

  .city-card .eyebrow {
    margin-bottom: var(--space-2);
  }

  .city-card--next {
    border-style: dashed;
    background: transparent;
  }

  .city-card--next .card__more {
    text-decoration: none;
  }
</style>
