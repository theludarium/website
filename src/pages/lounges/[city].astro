---
// One page per lounge city, generated from src/lib/lounges.ts.
// Landing page: follows the landing page rules in CLAUDE.md.
import BaseLayout from '@/layouts/BaseLayout.astro';
import LoungeFloorPlan from '@/components/LoungeFloorPlan.astro';
import PreviewNote from '@/components/PreviewNote.astro';
import WaitlistForm from '@/components/WaitlistForm.astro';
import { KIT_WAITLIST_FORMS } from '@/lib/config';
import { LOUNGES, type Lounge } from '@/lib/lounges';

export function getStaticPaths() {
  return LOUNGES.map((lounge) => ({ params: { city: lounge.slug }, props: { lounge } }));
}

interface Props {
  lounge: Lounge;
}

const { lounge } = Astro.props;
const configured = Boolean(KIT_WAITLIST_FORMS[lounge.slug]?.action);
---

<BaseLayout
  title={`${lounge.city} Game Lounge`}
  description={`The Ludarium Game Lounge is coming to ${lounge.city}: a membership community center where every game community meets. Join the waitlist to get in first.`}
>
  <section class="city-hero">
    <div class="container city-hero__grid">
      <div>
        <p class="eyebrow">Lounge No. {lounge.number} &middot; {lounge.city}, {lounge.region}</p>
        <h1>Get a seat at {lounge.city}'s home for play.</h1>
        <p class="city-hero__sub">
          A membership game lounge and community center where every game community meets: game nights,
          clubs, campaigns, and seminars. Join the waitlist for first access and a say in what we build.
        </p>
        <WaitlistForm lounge={lounge} />
        {
          !configured && (
            <PreviewNote>
              The {lounge.city} waitlist is not connected to Kit yet, so signups go nowhere. Do not merge
              to main until this note is gone.
            </PreviewNote>
          )
        }
      </div>
      <LoungeFloorPlan />
    </div>
  </section>

  <section class="section city-points" aria-labelledby="city-points-title">
    <div class="container">
      <h2 id="city-points-title" class="visually-hidden">Common questions</h2>
      <ul class="city-points__list">
        <li>
          <h3>When will it open?</h3>
          <p>When enough of {lounge.city} says yes. The waitlist tells us where to build and how big, so every signup moves it closer.</p>
        </li>
        <li>
          <h3>What will membership cost?</h3>
          <p>Pricing is not set yet. Waitlist members help shape it and hear first, before anyone else.</p>
        </li>
        <li>
          <h3>Is it only for serious gamers?</h3>
          <p>No. Newcomers, families, clubs, and lifelong players all have a seat. Walk in on your own and find a table.</p>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .city-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .city-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: start;
    gap: var(--space-7);
  }

  .city-hero h1 {
    max-width: 15ch;
    font-size: var(--text-4xl);
  }

  .city-hero__sub {
    max-width: 36rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .city-points {
    padding-top: var(--space-6);
  }

  .city-points__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .city-points__list li {
    padding: var(--space-5);
    border-top: 3px solid var(--color-primary);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: var(--color-surface);
  }

  .city-points__list h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .city-points__list p {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 60rem) {
    .city-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
