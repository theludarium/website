---
// Deep Cut product page: what the game is, what the buyer gets, and why we made it.
// Facts come from ludarium-ops/research/deep-cut/v1 (DESIGN.md, build.py). Price and checkout live in src/lib/board-games.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { SITE } from '@/lib/site';
import { BOARD_GAME_PRODUCTS } from '@/lib/board-games';
import AffiliateLink from '@/components/mdx/AffiliateLink.astro';
import AffiliateNotice from '@/components/mdx/AffiliateNotice.astro';
import storeImage from '@/assets/board-games/deep-cut.jpg';
import cover from '@/assets/board-games/deep-cut/page-1.jpg';
import investigators from '@/assets/board-games/deep-cut/page-12.jpg';
import cthulhu from '@/assets/board-games/deep-cut/page-15.jpg';
import places from '@/assets/board-games/deep-cut/page-19.jpg';
import cards from '@/assets/board-games/deep-cut/page-25.jpg';
import tokens from '@/assets/board-games/deep-cut/page-57.jpg';

const game = BOARD_GAME_PRODUCTS.find((p) => p.slug === 'deep-cut')!;
const buyLabel = `Buy the PDF, ${game.price}`;

const facts = [
  ['Players', '1 to 4'],
  ['Time', '60 to 75 minutes'],
  ['Ages', '14 and up'],
  ['Style', 'Cooperative'],
  ['Format', '58-page PDF'],
];

const pages = [
  { image: cover, alt: 'The Deep Cut cover: a Miskatonic geology file with a survey map of the quarry', caption: 'The cover and story pages, laid out as a Miskatonic University geology file.' },
  { image: investigators, alt: 'Two investigator sheets, Dana Ruiz and Dr. Priya Nair, with their madness tracks', caption: 'Six investigator sheets, each with a steady side and an Unmoored side.' },
  { image: cthulhu, alt: 'The Cthulhu Old One sheet with its health track and attack deck spaces', caption: 'Three Old One sheets: Cthulhu, the Shell Mother and the Hollow Choir.' },
  { image: places, alt: 'A sheet of place tiles: Town Common, Special Collections, Arkham High Gym and more', caption: 'Twelve place tiles: three in town, three on the quarry rim, six in the depths.' },
  { image: cards, alt: 'A sheet of attack and encounter cards', caption: 'Nineteen sheets of cards, fronts and backs, ready to cut.' },
  { image: tokens, alt: 'The token sheet: Omen tokens, horrors, Seal tokens and the Clock strip', caption: 'Omen tokens, horrors, clues, investigator pieces and the Clock.' },
];

const contents = [
  'A framing story and an 8-page rulebook with examples',
  'A one-page quick reference',
  '6 investigators, each a two-sided sheet',
  '3 Old Ones, each with its own sheet and 6 attack cards',
  '12 place tiles, 48 Encounter cards, 30 Night cards and 12 Dream cards',
  '18 Items, 16 Hunches, 3 Seals and 12 Party Madness cards for tables that want to act it out',
  '20 Omen tokens, clue and horror tokens, investigator pieces and the Clock',
  'A game log to record every night under Arkham',
];

// Optional gear for printing and storing a copy. Amazon only, tag cubecommonw0a-20; ASINs found 2026-11-19.
const AMZ = (asin: string) => `https://www.amazon.com/dp/${asin}?tag=cubecommonw0a-20`;
const gear = [
  {
    group: 'Print and cut',
    items: [
      { name: 'Hammermill 110 lb white cardstock', href: AMZ('B08DCF5B4P'), why: 'Heavy enough for cards and tiles, light enough for a home printer. One pack covers a full copy with plenty left over.' },
      { name: 'A 12-inch paper trimmer with a corner rounder', href: AMZ('B0C2HDCTWN'), why: 'Straight cuts on 19 card sheets go much faster than scissors, and rounded corners make the cards feel finished.' },
    ],
  },
  {
    group: 'Protect the cards',
    items: [
      { name: 'Dragon Shield Perfect Fit sleeves, 100 count', href: AMZ('B07ZPGFCL5'), why: 'The snuggest fit for Deep Cut cards, which are a touch under poker size. You need two packs for every card and place tile.' },
      { name: 'Ultimate Guard Twin Flip’n’Tray 200+', href: AMZ('B0B41PF7BG'), why: 'Two compartments hold every sleeved card, with small trays for tokens and a tray that flips out at the table.' },
    ],
  },
  {
    group: 'Hold everything else',
    items: [
      { name: 'Small drawstring bags, 3 by 4 inches', href: AMZ('B0G25FT83V'), why: 'One becomes your Omen Bag. The rest keep clues, horrors and investigator pieces apart.' },
      { name: 'Mini 8-grid organizer boxes', href: AMZ('B07HKWNB93'), why: 'A pocket-sized box sorts every token type, so setup takes a minute instead of ten.' },
      { name: 'JAM Paper clear snap envelopes, letter booklet size', href: AMZ('B003S84IU4'), why: 'Keeps the rulebook, quick reference, investigator sheets and Old One sheets flat and together, with room for the game log.' },
    ],
  },
];

const faqs = [
  {
    q: 'Do I need to know Lovecraft to play?',
    a: 'No. The story page tells you everything you need in a few paragraphs. If you do know the stories, you will spot Arkham, Miskatonic University and the thing that sleeps under the sea.',
  },
  {
    q: 'Can I play it alone?',
    a: 'Yes. A solo player runs two investigators, and the rulebook has a short section on how to handle the cards that assume a table of friends.',
  },
  {
    q: 'Is it connected to Arkham Horror?',
    a: 'No. Deep Cut is an original game by The Ludarium. Arkham, Miskatonic University and Cthulhu come from Lovecraft stories in the public domain. Every other name, place and character is our own.',
  },
  {
    q: 'How hard is it?',
    a: 'On Standard, a careful table should win a little more often than it loses, and about half of all games go to the final fight. Easy and Hard change only the length of the Clock, so you can move up once you know the game.',
  },
  {
    q: 'What do I need to print it?',
    a: 'A home printer and US Letter paper. Heavy paper or cardstock is best for anything you cut out. Only the card sheets print two-sided; the rulebook tells you which pages. Add scissors, a cup or bag for the Omen tokens, and a penny for the Clock. The cards fit standard card sleeves.',
  },
  {
    q: 'Can I print more than one copy?',
    a: 'Yes, print as many copies as your own table needs. Please send friends to this page instead of sharing the file, so we can keep making games.',
  },
  {
    q: 'Is there a boxed version?',
    a: 'Not yet. Deep Cut is print-and-play only for now.',
  },
];

const productLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Deep Cut',
  description: 'An original cooperative board game of cosmic horror for 1 to 4 players, sold as a 58-page print-and-play PDF.',
  image: new URL(storeImage.src, SITE.url).href,
  brand: { '@type': 'Brand', name: SITE.name },
  offers: {
    '@type': 'Offer',
    price: game.price.replace('$', ''),
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: new URL('/store/deep-cut/', SITE.url).href,
  },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout
  title="Deep Cut: A Cooperative Cosmic Horror Board Game"
  description="Deep Cut is our own cooperative print-and-play board game of cosmic horror for 1 to 4 players. Seal the hollow under an Arkham quarry before 3:12."
  image={storeImage.src}
  imageAlt="The Deep Cut cover and game sheets fanned out"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <section class="dc-hero">
    <div class="container dc-hero__grid">
      <div>
        <p class="eyebrow"><a href="/store/#board-games">Store</a> / Board game</p>
        <h1>Close the hollow before 3:12.</h1>
        <p class="lede">
          Deep Cut is our own cooperative game of cosmic horror. One evening, up to four friends, and an Old One you can
          actually beat.
        </p>
        <div class="dc-buy">
          <a class="button dc-buy__button" href={game.checkout} rel="noopener">{buyLabel}</a>
          <span class="dc-buy__note">Instant download. Print at home and play tonight.</span>
        </div>
      </div>
      <a class="dc-hero__link" href={game.checkout} rel="noopener" aria-label={`${buyLabel} on Lemon Squeezy`}>
        <Image
          class="dc-hero__image"
          src={storeImage}
          alt="The Deep Cut cover and game sheets fanned out"
          widths={[480, 800, 1200]}
          sizes="(max-width: 52rem) 100vw, 36rem"
          loading="eager"
        />
      </a>
    </div>
    <div class="container">
      <dl class="dc-facts">
        {facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section dc-story" aria-labelledby="dc-story-title">
    <div class="container dc-narrow">
      <h2 id="dc-story-title">Arkham, Massachusetts. Tonight.</h2>
      <p>
        Out past Meadow Hill is Graywater Quarry. It closed in 1988, filled with water, and became the place your mother
        told you not to swim. Last spring a data center company pumped it dry and started cutting again. In August the
        night crew went below the old shelf, the one a 1937 crew chalked NO on, and broke into a hollow.
      </p>
      <p>
        Now the Town Hall clock stops at 3:12. The tap water tastes of salt. Something under the streets is humming.
        Everyone is having the same dream.
      </p>
      <p>
        You are not heroes. You are a police sergeant, a geologist, a high school coach, a livestreamer with a drone, a
        pastor, and the old quarryman who told them so. Close the hollow by 3:12, or meet what is under it.
      </p>
    </div>
  </section>

  <section class="section dc-how" aria-labelledby="dc-how-title">
    <div class="container">
      <h2 id="dc-how-title">How it plays</h2>
      <ul class="dc-how__grid">
        <li class="card">
          <h3>Two acts, two ways to win</h3>
          <p>
            Search the town and the quarry for clues, then place three Seals in the depths before the Clock strikes 3:12.
            Miss the deadline and the Old One rises. You get three Days to bring it down, and you can still win.
          </p>
        </li>
        <li class="card">
          <h3>The Omen Bag</h3>
          <p>
            Every test is your skill plus one token from a bag. Fail, and you can push your luck and draw again, at a
            cost. As the night goes on, worse tokens go into the bag.
          </p>
        </li>
        <li class="card">
          <h3>Madness makes you stronger</h3>
          <p>
            The closer an investigator gets to breaking, the better they get at everything. The whole game turns on
            how far you dare to go. Nobody is ever knocked out of the game.
          </p>
        </li>
        <li class="card">
          <h3>Three Old Ones, three settings</h3>
          <p>
            Cthulhu, the Shell Mother and the Hollow Choir each change the night in their own way. Easy, Standard and
            Hard only change the length of the Clock, so the rules stay the same as you climb.
          </p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section dc-get" aria-labelledby="dc-get-title">
    <div class="container">
      <h2 id="dc-get-title">What you get</h2>
      <p class="dc-get__lede">
        One 58-page PDF with everything you need to print a complete copy of the game. Here are a few of the pages.
      </p>
      <ul class="dc-pages">
        {pages.map((p) => (
          <li>
            <figure>
              <Image src={p.image} alt={p.alt} widths={[300, 600]} sizes="(max-width: 36rem) 50vw, 15rem" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <div class="dc-get__cols">
        <div>
          <h3>Inside the PDF</h3>
          <ul class="dc-list">
            {contents.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div>
          <h3>You will also need</h3>
          <ul class="dc-list">
            <li>A home printer and US Letter paper, heavy paper for anything you cut out</li>
            <li>Scissors</li>
            <li>A cup or small bag for the Omen tokens</li>
            <li>A penny for the Clock</li>
          </ul>
          <p class="dc-small">The cards are a touch under poker size and fit standard card sleeves. Want a copy that lasts? See <a href="#build-your-copy">what we would use to build and store it</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section dc-gear" id="build-your-copy" aria-labelledby="dc-gear-title">
    <div class="container">
      <h2 id="dc-gear-title">Build and store your copy</h2>
      <p class="dc-get__lede">
        Deep Cut plays fine with plain paper, scissors and a cup. If you want a copy that lasts, here is what we would
        pick to print it, protect it and keep it together.
      </p>
      <AffiliateNotice />
      <div class="dc-gear__grid">
        {gear.map((g) => (
          <div class="card">
            <h3>{g.group}</h3>
            <ul class="dc-gear__list">
              {g.items.map((it) => (
                <li>
                  <AffiliateLink href={it.href} position="buy-block">{it.name}</AffiliateLink>
                  <p>{it.why}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section dc-why" aria-labelledby="dc-why-title">
    <div class="container dc-narrow">
      <h2 id="dc-why-title">Why we made it</h2>
      <p>
        Deep Cut started with research. While writing our guide to <a href="/articles/best-lovecraftian-board-games/">the best Lovecraftian board games</a>,
        we looked at how hard each one is to beat. The big cooperative games are mostly hard: long nights, and lots
        of losses while you learn. The lighter ones are quick, but often swing on
        a single roll.
      </p>
      <p>
        We wanted the space in between. A game you can finish in one evening, where the threat feels real and losing is
        always possible, but where a team that plays well should win more often than it loses. Too easy and there is no
        dread. Too hard and nobody wants to play it again.
      </p>
      <p>
        So we tuned it. Before anyone sat down to play, we ran the rules through a computer simulation, 10,000 games for
        every table size and setting, and adjusted the numbers until a careful team won about six games in ten on
        Standard. Then Levi, our founder, playtested it before we called it finished.
      </p>
      <p>
        We also wanted to go through the whole journey ourselves: design a game, test it, make it look the part, and put
        it in front of real players. Deep Cut is The Ludarium's first board game. Every copy sold helps fund the next
        one, and our first game lounge in Indianapolis.
      </p>
    </div>
  </section>

  <section class="section dc-faq" aria-labelledby="dc-faq-title">
    <div class="container dc-narrow">
      <h2 id="dc-faq-title">Questions</h2>
      {faqs.map((f) => (
        <details class="dc-faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section dc-final">
    <div class="container">
      <div class="card dc-final__card">
        <div>
          <h2>The Clock is already running.</h2>
          <p>Download Deep Cut, print it tonight, and find out what is under the quarry.</p>
        </div>
        <div class="dc-buy">
          <a class="button dc-buy__button" href={game.checkout} rel="noopener">{buyLabel}</a>
          <span class="dc-buy__note">Checkout by Lemon Squeezy. Instant download.</span>
        </div>
      </div>
      <p class="dc-small dc-final__more">Looking for more? <a href="/store/">See everything in the store</a>.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .dc-hero {
    padding-block: var(--space-9) var(--space-7);
  }

  .dc-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .dc-hero h1 {
    max-width: 13ch;
    font-size: var(--text-4xl);
  }

  .dc-hero .eyebrow a {
    color: inherit;
  }

  .dc-hero__link {
    display: block;
    border-radius: var(--radius-lg);
    transition: transform 160ms ease;
  }

  .dc-hero__link:hover {
    transform: translateY(-2px);
  }

  .dc-hero__link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .dc-hero__link {
      transition: none;
    }
  }

  .dc-hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .dc-buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }

  .dc-buy__note,
  .dc-small {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .dc-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
    margin: var(--space-8) 0 0;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .dc-facts dt {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .dc-facts dd {
    margin: var(--space-1) 0 0;
    font-weight: 600;
  }

  .dc-narrow {
    max-width: 42rem;
  }

  .dc-story,
  .dc-how,
  .dc-get,
  .dc-why,
  .dc-gear,
  .dc-faq,
  .dc-final {
    padding-top: 0;
  }

  .section h2 {
    margin: 0 0 var(--space-5);
    font-size: var(--text-3xl);
  }

  .dc-story p {
    font-size: var(--text-lg);
  }

  .dc-how__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dc-how__grid h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .dc-how__grid p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .dc-get__lede {
    max-width: 40rem;
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
  }

  .dc-pages {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(45%, 13rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
  }

  .dc-pages figure {
    margin: 0;
  }

  .dc-pages img {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    background: #fff;
  }

  .dc-pages figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .dc-get__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-7);
  }

  .dc-get__cols h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-xl);
  }

  .dc-list {
    margin: 0;
    padding-left: 1.2em;
  }

  .dc-list li + li {
    margin-top: var(--space-2);
  }

  .dc-gear .affiliate-notice {
    max-width: 40rem;
    margin: 0 0 var(--space-6);
  }

  .dc-gear__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
  }

  .dc-gear__grid h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-lg);
  }

  .dc-gear__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .dc-gear__list li + li {
    margin-top: var(--space-4);
  }

  .dc-gear__list a {
    font-weight: 650;
  }

  .dc-gear__list p {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .dc-faq__item {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-4);
  }

  .dc-faq__item summary {
    font-weight: 650;
    cursor: pointer;
  }

  .dc-faq__item p {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }

  .dc-final__card {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-7);
  }

  .dc-final__card h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-2xl);
  }

  .dc-final__card p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .dc-final__card .dc-buy {
    margin-top: 0;
  }

  .dc-final__more {
    margin-top: var(--space-5);
  }

  @media (max-width: 52rem) {
    .dc-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
