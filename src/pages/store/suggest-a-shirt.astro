---
// Landing page for shirt ideas: one job, the form. The form posts to functions/api/shirt-idea.ts,
// which saves the idea to D1 and emails Levi, then returns here with ?idea=sent or ?idea_error=.
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import ShirtIdeaForm from '@/components/ShirtIdeaForm.astro';
import { SHOP_URL } from '@/lib/merch';
import hero from '@/assets/merch/ideas-hero.jpg';
---

<BaseLayout
  title="Suggest a Board Game Shirt"
  description="Know a line every player of your game would recognize? Suggest it for a Ludarium tee or hoodie. We read every idea, and the best become new designs."
  image={hero.src}
  imageAlt="Three board game tees in brown, green and black"
>
  <section class="sh-hero">
    <div class="container sh-hero__grid">
      <div>
        <p class="eyebrow"><a href="/store/#tees">Store</a> / Tees and hoodies</p>
        <h1>Your game's best line, on a shirt.</h1>
        <p class="lede">
          Tell us the line or the moment every player of your game would recognize. The best ideas become new tees and
          hoodies, with your name on the credit if you want it.
        </p>
        <a class="button" href="#form">Suggest a shirt</a>
      </div>
      <Image
        class="sh-hero__image"
        src={hero}
        alt="Three board game tees in brown, green and black, each with a line players will recognize"
        widths={[480, 800, 1200]}
        sizes="(max-width: 52rem) 100vw, 34rem"
        loading="eager"
      />
    </div>
  </section>

  <section class="section sh-form" id="form" aria-labelledby="sh-form-title">
    <div class="container">
      <h2 id="sh-form-title">Your idea</h2>
      <p class="sh-lede">Two things are required: the game, and the line or moment. Everything else is up to you.</p>
      <ShirtIdeaForm />
    </div>
  </section>

  <section class="section sh-faq" aria-labelledby="sh-faq-title">
    <div class="container">
      <h2 id="sh-faq-title" class="visually-hidden">Good to know</h2>
      <ul class="sh-points">
        <li class="card">
          <h3>Does it have to be my own idea?</h3>
          <p>No. Shared jokes and well-known lines are welcome. We turn ideas into original designs that never use a game's name, logo or art.</p>
        </li>
        <li class="card">
          <h3>Will you add me to a mailing list?</h3>
          <p>No. Your email is optional, and we use it only to tell you if your idea becomes a shirt.</p>
        </li>
        <li class="card">
          <h3>What happens next?</h3>
          <p>We read every idea. The ones we make show up in <a href={SHOP_URL} rel="noopener">the shop</a>, credited to you if you gave a name.</p>
        </li>
      </ul>
      <p class="sh-small"><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .sh-hero {
    padding-block: var(--space-9) var(--space-7);
  }

  .sh-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .sh-hero h1 {
    max-width: 14ch;
    font-size: var(--text-4xl);
  }

  .sh-hero .eyebrow a {
    color: inherit;
  }

  .sh-hero .button {
    margin-top: var(--space-5);
  }

  .sh-hero__image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .sh-form,
  .sh-faq {
    padding-top: 0;
  }

  .sh-form {
    scroll-margin-top: 5.5rem;
  }

  .sh-form h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
  }

  .sh-lede {
    margin: 0 0 var(--space-5);
    color: var(--color-text-muted);
  }

  .sh-points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sh-points h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .sh-points p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .sh-small {
    margin-top: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .sh-hero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
