---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PreviewNote from '@/components/PreviewNote.astro';
import { STORE_URL } from '@/lib/config';
import { Image } from 'astro:assets';
import { MALAPHOR_BOOK as book } from '@/lib/books';
import cover from '@/assets/books/malaphors-cover.jpg';
import { getDemos } from '@/lib/rpg-demo-library';
import type { ImageMetadata } from 'astro';

// Adventure PDFs: one per RPG Demo Library game whose store.js entry has a
// Lemon Squeezy checkout link. Covers live in src/assets/rpg-pdfs/<demo slug>.jpg.
const covers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/rpg-pdfs/*.jpg', { eager: true });
const pdfs = getDemos()
  .filter((d) => d.product?.checkout)
  .map((d) => ({ ...d, product: d.product!, cover: covers[`/src/assets/rpg-pdfs/${d.slug}.jpg`]?.default }));
---

<BaseLayout
  title="Store"
  description="Digital goods for your table from The Ludarium, including RPG Demo Library adventure PDFs. Checkout is handled securely by Lemon Squeezy."
>
  <section class="store">
    <div class="container store__grid">
      <div>
        <p class="eyebrow">The Ludarium store</p>
        <h1>Digital goods for your table.</h1>
        <p class="lede">
          Adventure PDFs from the RPG Demo Library, and more tools for game night as we make them.
          Download instantly, play tonight.
        </p>
        {
          STORE_URL ? (
            <a class="button store__cta" href={STORE_URL} rel="noopener">
              Visit the store
            </a>
          ) : (
            <>
              <p class="store__soon">The store opens soon. Join the newsletter to hear first.</p>
              <a class="button store__cta" href="/newsletter/">Join the newsletter</a>
              <PreviewNote>
                No store link yet. Send Claude your Lemon Squeezy store URL to add the button.
              </PreviewNote>
            </>
          )
        }
        <p class="store__fine">
          Checkout is handled by Lemon Squeezy, which processes payments and sales tax securely. Everything
          is digital. We do not sell physical games.
        </p>
      </div>

      <ul class="store__points">
        <li class="card">
          <h2>Try before you buy</h2>
          <p>Play a free intro adventure in the <a href="/rpg-demo-library/">RPG Demo Library</a>, then grab the full PDF if you love it.</p>
        </li>
        <li class="card">
          <h2>Open-license games</h2>
          <p>We publish adventures for open-license role-playing games, made to share at any table.</p>
        </li>
        <li class="card">
          <h2>Supports the lounge</h2>
          <p>Every purchase helps fund The Ludarium Game Lounge in Indianapolis.</p>
        </li>
      </ul>
    </div>
  </section>

  {
    pdfs.length > 0 && (
      <section class="section store-pdfs" aria-labelledby="store-pdfs-title">
        <div class="container">
          <h2 id="store-pdfs-title">Adventure PDFs</h2>
          <p class="store-pdfs__lede">
            Each one is a complete solo adventure plus the rules you need to play it. Play Act One free first, then
            keep going.
          </p>
          <ul class="store-pdfs__grid">
            {pdfs.map((d) => (
              <li class="card store-pdf">
                {d.cover && (
                  <Image src={d.cover} alt={`Cover of ${d.product.name}`} widths={[200, 400]} sizes="200px" />
                )}
                <div class="store-pdf__body">
                  <p class="eyebrow">{d.product.game}</p>
                  <h3>{d.product.name}</h3>
                  <p class="store-pdf__meta">
                    PDF{d.product.pages ? `, ${d.product.pages} pages` : ''}
                  </p>
                  <div class="store-pdf__actions">
                    <a class="button" href={d.product.checkout} rel="noopener">
                      Buy the PDF, {d.product.price}
                    </a>
                    <a href={d.href}>Play Act One free</a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section store-books" aria-labelledby="store-books-title">
    <div class="container">
      <h2 id="store-books-title">Books</h2>
      <a class="card store-book" href={`/books/${book.slug}/`}>
        <Image src={cover} alt={`Cover of ${book.title}`} widths={[160, 320]} sizes="160px" />
        <div>
          <h3>{book.title}</h3>
          <p>{book.blurb}</p>
          <span class="card__more">Paperback and Kindle on Amazon</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .store {
    padding-block: var(--space-9) var(--space-8);
  }

  .store__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .store h1 {
    max-width: 14ch;
    font-size: var(--text-4xl);
  }

  .store__cta {
    margin-top: var(--space-5);
  }

  .store__soon {
    margin-top: var(--space-5);
    font-weight: 600;
  }

  .store__fine {
    max-width: 30rem;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .store__points {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .store__points h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .store-pdfs {
    padding-top: 0;
  }

  .store-pdfs h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
  }

  .store-pdfs__lede {
    max-width: 40rem;
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
  }

  .store-pdfs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .store-pdf {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .store-pdf img {
    flex: none;
    width: 6.5rem;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
  }

  .store-pdf h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .store-pdf .eyebrow {
    margin: 0 0 var(--space-1);
  }

  .store-pdf__meta {
    margin: var(--space-1) 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .store-pdf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .store-pdf__actions a:not(.button) {
    font-size: var(--text-sm);
  }

  .store-books {
    padding-top: 0;
  }

  .store-books h2 {
    margin: 0 0 var(--space-5);
    font-size: var(--text-2xl);
  }

  .store-book {
    flex-direction: row;
    align-items: center;
    gap: var(--space-6);
    max-width: 48rem;
  }

  .store-book img {
    flex: none;
    width: 7.5rem;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 52rem) {
    .store__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .store-book {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
