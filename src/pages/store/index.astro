---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PreviewNote from '@/components/PreviewNote.astro';
import { STORE_URL } from '@/lib/config';
import { Image } from 'astro:assets';
import { MALAPHOR_BOOK as book } from '@/lib/books';
import cover from '@/assets/books/malaphors-cover.jpg';
import { getDemos } from '@/lib/rpg-demo-library';
import type { ImageMetadata } from 'astro';
import { TEACH_CARD_PACKS, TEACH_CARD_BUNDLE } from '@/lib/teach-cards';
import { ONE_PAGER_PRODUCTS } from '@/lib/one-pagers';
import onePagerBundle from '@/assets/one-pagers/bundle.jpg';
import onePagerKit from '@/assets/one-pagers/kit.jpg';
import { BOARD_GAME_PRODUCTS } from '@/lib/board-games';
import deepCut from '@/assets/board-games/deep-cut.jpg';
import { SHOP_URL } from '@/lib/merch';
import teesImage from '@/assets/merch/tees.jpg';
const boardGameImages: Record<string, ImageMetadata> = { 'deep-cut': deepCut };

const onePagerImages: Record<string, ImageMetadata> = { bundle: onePagerBundle, kit: onePagerKit };

// Adventure PDFs: one per RPG Demo Library game whose store.js entry has a
// Lemon Squeezy checkout link. Covers live in src/assets/rpg-pdfs/<demo slug>.jpg.
const covers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/rpg-pdfs/*.jpg', { eager: true });
const pdfs = getDemos()
  .filter((d) => d.product?.checkout)
  .map((d) => ({ ...d, product: d.product!, cover: covers[`/src/assets/rpg-pdfs/${d.slug}.jpg`]?.default }));

// Teach-card packs: one per Academy course in src/lib/teach-cards.ts, plus the bundle.
const cardImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/teach-cards/*.jpg', { eager: true });
const cardPacks = [...TEACH_CARD_PACKS, TEACH_CARD_BUNDLE].map((p) => ({
  ...p,
  image: cardImages[`/src/assets/teach-cards/${p.slug}.jpg`]?.default,
}));
---

<BaseLayout
  title="Store"
  description="Digital goods for your table from The Ludarium: print-and-play board games, one-page RPGs, teach cards, RPG Demo Library adventure PDFs, plus tees and hoodies with inside jokes from the table."
>
  <section class="store">
    <div class="container store__grid">
      <div>
        <p class="eyebrow">The Ludarium store</p>
        <h1>Digital goods for your table.</h1>
        <p class="lede">
          Printable teach cards, adventure PDFs from the RPG Demo Library, and more tools for game night as we make
          them.
          Download instantly, play tonight.
        </p>
        {
          STORE_URL ? (
            <a class="button store__cta" href={STORE_URL} rel="noopener">
              Visit the store
            </a>
          ) : (
            <>
              <p class="store__soon">The store opens soon. Join the newsletter to hear first.</p>
              <a class="button store__cta" href="/newsletter/">Join the newsletter</a>
              <PreviewNote>
                No store link yet. Send Claude your Lemon Squeezy store URL to add the button.
              </PreviewNote>
            </>
          )
        }
        <p class="store__fine">
          Digital goods check out through Lemon Squeezy, which processes payments and sales tax securely.
          Tees and hoodies are printed to order and shipped by Fourthwall.
        </p>
      </div>

      <ul class="store__points">
        <li class="card">
          <h2>Try before you buy</h2>
          <p>Play a free intro adventure in the <a href="/rpg-demo-library/">RPG Demo Library</a>, then grab the full PDF if you love it.</p>
        </li>
        <li class="card">
          <h2>Open-license games</h2>
          <p>We publish adventures for open-license role-playing games, made to share at any table.</p>
        </li>
        <li class="card">
          <h2>Supports the lounge</h2>
          <p>Every purchase helps fund The Ludarium Game Lounge in Indianapolis.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section store-pdfs" id="board-games" aria-labelledby="store-boardgames-title">
    <div class="container">
      <h2 id="store-boardgames-title">Board games</h2>
      <p class="store-pdfs__lede">Our own games, ready to print at home: a PDF with the rules, every card and every token.</p>
      <ul class="store-pdfs__grid">
        {BOARD_GAME_PRODUCTS.map((p) => (
          <li class="card store-pdf store-card">
            <Image src={boardGameImages[p.slug]} alt={p.alt} widths={[200, 400]} sizes="200px" />
            <div class="store-pdf__body">
              <p class="eyebrow">{p.eyebrow}</p>
              <h3>{p.name}</h3>
              <p class="store-pdf__meta">{p.blurb}</p>
              <div class="store-pdf__actions">
                <a class="button" href={p.checkout} rel="noopener">
                  Buy the PDF, {p.price}
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section store-pdfs" id="one-pagers" aria-labelledby="store-onepagers-title">
    <div class="container">
      <h2 id="store-onepagers-title">One-page RPGs</h2>
      <p class="store-pdfs__lede">
        Complete tabletop roleplaying games on a single printable sheet. Start with <a href="/rpg-demo-library/games/under-the-couch/">Under the Couch</a>, free in your browser, and read our <a href="/articles/one-page-rpgs/">guide to one-page RPGs</a> if you are new to them.
      </p>
      <ul class="store-pdfs__grid">
        {ONE_PAGER_PRODUCTS.map((p) => (
          <li class="card store-pdf store-card">
            <Image src={onePagerImages[p.slug]} alt={p.alt} widths={[200, 400]} sizes="200px" />
            <div class="store-pdf__body">
              <p class="eyebrow">{p.eyebrow}</p>
              <h3>{p.name}</h3>
              <p class="store-pdf__meta">{p.blurb}</p>
              <div class="store-pdf__actions">
                <a class="button" href={p.checkout} rel="noopener">
                  Buy the PDF, {p.price}
                </a>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section store-pdfs" aria-labelledby="store-cards-title">
    <div class="container">
      <h2 id="store-cards-title">Teach cards</h2>
      <p class="store-pdfs__lede">
        Print-and-cut cards that put the rules in every player's hand, with a ten-minute teach script for the host.
        Each pack pairs with a free <a href="/academy/">Academy</a> course.
      </p>
      <ul class="store-pdfs__grid">
        {cardPacks.map((p) => (
          <li class="card store-pdf store-card">
            {p.image && <Image src={p.image} alt={p.slug === 'bundle' ? 'Teach card sheets for all four games' : `A sheet of ${p.game} teach cards`} widths={[200, 400]} sizes="200px" />}
            <div class="store-pdf__body">
              <p class="eyebrow">{p.game}</p>
              <h3>{p.name}</h3>
              <p class="store-pdf__meta">{p.blurb}</p>
              <div class="store-pdf__actions">
                <a class="button" href={p.checkout} rel="noopener">
                  Buy the PDF, {p.price}
                </a>
                {p.slug !== 'bundle' && <a href={`/academy/${p.slug}/`}>Free course</a>}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {
    pdfs.length > 0 && (
      <section class="section store-pdfs" aria-labelledby="store-pdfs-title">
        <div class="container">
          <h2 id="store-pdfs-title">Adventure PDFs</h2>
          <p class="store-pdfs__lede">
            Each one is a complete solo adventure plus the rules you need to play it. Play Act One free first, then
            keep going.
          </p>
          <ul class="store-pdfs__grid">
            {pdfs.map((d) => (
              <li class="card store-pdf">
                {d.cover && (
                  <Image src={d.cover} alt={`Cover of ${d.product.name}`} widths={[200, 400]} sizes="200px" />
                )}
                <div class="store-pdf__body">
                  <p class="eyebrow">{d.product.game}</p>
                  <h3>{d.product.name}</h3>
                  <p class="store-pdf__meta">
                    PDF{d.product.pages ? `, ${d.product.pages} pages` : ''}
                  </p>
                  <div class="store-pdf__actions">
                    <a class="button" href={d.product.checkout} rel="noopener">
                      Buy the PDF, {d.product.price}
                    </a>
                    <a href={d.href}>Play Act One free</a>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section store-pdfs" id="tees" aria-labelledby="store-tees-title">
    <div class="container">
      <h2 id="store-tees-title">Tees and hoodies</h2>
      <p class="store-pdfs__lede">Inside jokes from the table, for the people who get them. Printed to order and shipped to your door.</p>
      <ul class="store-pdfs__grid">
        <li class="card store-pdf store-card">
          <Image src={teesImage} alt="A brown tee printed with a small bird, a lightning bolt and the words Always bolt the bird" widths={[200, 400]} sizes="200px" />
          <div class="store-pdf__body">
            <p class="eyebrow">The Ludarium shop</p>
            <h3>25 designs, tees and hoodies</h3>
            <p class="store-pdf__meta">Tees $25, hoodies $45. Inspired by the games we teach in the Academy.</p>
            <div class="store-pdf__actions">
              <a class="button" href={SHOP_URL} rel="noopener">Shop tees and hoodies</a>
            </div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section store-books" aria-labelledby="store-books-title">
    <div class="container">
      <h2 id="store-books-title">Books</h2>
      <a class="card store-book" href={`/books/${book.slug}/`}>
        <Image src={cover} alt={`Cover of ${book.title}`} widths={[160, 320]} sizes="160px" />
        <div>
          <h3>{book.title}</h3>
          <p>{book.blurb}</p>
          <span class="card__more">Paperback and Kindle on Amazon</span>
        </div>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .store {
    padding-block: var(--space-9) var(--space-8);
  }

  .store__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .store h1 {
    max-width: 14ch;
    font-size: var(--text-4xl);
  }

  .store__cta {
    margin-top: var(--space-5);
  }

  .store__soon {
    margin-top: var(--space-5);
    font-weight: 600;
  }

  .store__fine {
    max-width: 30rem;
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .store__points {
    display: grid;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .store__points h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .store-pdfs {
    padding-top: 0;
  }

  .store-pdfs h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-2xl);
  }

  .store-pdfs__lede {
    max-width: 40rem;
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
  }

  .store-pdfs__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .store-pdf {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .store-pdf img {
    flex: none;
    width: 6.5rem;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
  }

  .store-pdf h3 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .store-pdf .eyebrow {
    margin: 0 0 var(--space-1);
  }

  .store-pdf__meta {
    margin: var(--space-1) 0 var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .store-pdf__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .store-pdf__actions a:not(.button) {
    font-size: var(--text-sm);
  }

  .store-card img {
    width: 8rem;
    box-shadow: none;
  }

  .store-books {
    padding-top: 0;
  }

  .store-books h2 {
    margin: 0 0 var(--space-5);
    font-size: var(--text-2xl);
  }

  .store-book {
    flex-direction: row;
    align-items: center;
    gap: var(--space-6);
    max-width: 48rem;
  }

  .store-book img {
    flex: none;
    width: 7.5rem;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 52rem) {
    .store__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 36rem) {
    .store-book {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
