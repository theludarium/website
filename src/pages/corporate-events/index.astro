---
// Landing page: follows the landing page rules in CLAUDE.md.
// One outcome, one action (the inquiry form), three objections, legal links.
import BaseLayout from '@/layouts/BaseLayout.astro';
import InquiryForm from '@/components/InquiryForm.astro';
import PreviewNote from '@/components/PreviewNote.astro';
import TableScene from '@/components/TableScene.astro';
---

<BaseLayout
  title="Corporate Events"
  description="Leadership and team training taught through tabletop games. Hands-on workshops that build trust, communication, and better decisions. Plan one for your team."
>
  <section class="ce-hero">
    <div class="container ce-hero__grid">
      <div>
        <p class="eyebrow">For teams</p>
        <h1>Build a team that trusts each other.</h1>
        <p class="ce-hero__sub">
          Leadership and team training, taught through tabletop games. Hands-on workshops where your
          people practice communication, decisions, and leadership, then connect it straight back to
          their work.
        </p>
        <a class="button" href="#inquire">Plan your team's workshop</a>
      </div>
      <div class="ce-hero__art">
        <TableScene />
      </div>
    </div>
  </section>

  <section class="section ce-points" aria-labelledby="ce-points-title">
    <div class="container">
      <h2 id="ce-points-title" class="visually-hidden">Common questions</h2>
      <ul class="ce-points__list">
        <li>
          <h3>Is this just a game day?</h3>
          <p>No. Every session targets a skill your team needs, and a guided debrief connects what happened at the table to how your team works.</p>
        </li>
        <li>
          <h3>Our people are not gamers.</h3>
          <p>They do not need to be. Every game is taught in minutes and chosen for first-timers. That is part of the point.</p>
        </li>
        <li>
          <h3>What does it take from us?</h3>
          <p>A room and your team. We bring the games, run the session, and lead the debrief.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section--tight-top" id="inquire" aria-labelledby="inquire-title">
    <div class="container ce-form">
      <div class="ce-form__intro">
        <h2 id="inquire-title">Tell us about your team.</h2>
        <p>Two short steps. We will reply by email with ideas for a session that fits your goals.</p>
        <PreviewNote>
          Levi: confirm the workshop formats, typical length, and how you price them, and send any
          testimonials once you have them. The objections above assume you bring all materials.
        </PreviewNote>
      </div>
      <InquiryForm />
    </div>
  </section>
</BaseLayout>

<style>
  .ce-hero {
    padding-block: var(--space-8) var(--space-6);
  }

  .ce-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-8);
  }

  .ce-hero h1 {
    max-width: 13ch;
    font-size: var(--text-4xl);
  }

  .ce-hero__sub {
    max-width: 34rem;
    margin-bottom: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .ce-hero__art {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-lg);
  }

  .ce-points {
    padding-top: var(--space-6);
  }

  .ce-points__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ce-points__list li {
    padding: var(--space-5);
    border-top: 3px solid var(--color-primary);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background: var(--color-surface);
  }

  .ce-points__list h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }

  .ce-points__list p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .section--tight-top {
    padding-top: 0;
  }

  #inquire {
    scroll-margin-top: 5rem;
  }

  .ce-form {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-7);
    align-items: start;
  }

  .ce-form__intro h2 {
    margin-top: 0;
    font-size: var(--text-3xl);
  }

  .ce-form__intro p {
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .ce-hero__grid,
    .ce-form {
      grid-template-columns: 1fr;
    }
  }
</style>
