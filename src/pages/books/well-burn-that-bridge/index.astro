---
// Product page for the malaphor field guide. Amazon sells and ships it; every
// buy button is a plain Amazon link (no affiliate tags, so no disclosure).
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { MALAPHOR_BOOK as book } from '@/lib/books';
import cover from '@/assets/books/malaphors-cover.jpg';
import gus from '@/assets/books/malaphors/friend-gus.jpg';
import pete from '@/assets/books/malaphors/friend-pete.jpg';
import teddy from '@/assets/books/malaphors/friend-teddy.jpg';
import walt from '@/assets/books/malaphors/friend-walt.jpg';
import stripBridges from '@/assets/books/malaphors/strip-bridges.jpg';
import stripBirds from '@/assets/books/malaphors/strip-birds.jpg';
import stripElephant from '@/assets/books/malaphors/strip-elephant.jpg';

const shareImage = await getImage({ src: cover, width: 800, format: 'jpg' });
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: book.title,
  alternativeHeadline: book.subtitle,
  author: { '@type': 'Person', name: book.author },
  description: book.blurb,
  image: new URL(shareImage.src, Astro.site).href,
  url: pageUrl,
  inLanguage: 'en',
  genre: ['Humor', 'Language', 'Linguistics'],
  datePublished: book.published,
  workExample: [
    {
      '@type': 'Book',
      bookFormat: 'https://schema.org/Paperback',
      isbn: book.isbn,
      numberOfPages: book.pages,
      publisher: { '@type': 'Organization', name: book.publisher },
      url: book.paperbackUrl,
    },
    { '@type': 'Book', bookFormat: 'https://schema.org/EBook', url: book.kindleUrl },
  ],
};

const parts = [
  { name: 'The Parents', text: 'The two idioms that collided.' },
  { name: 'Where They Came From', text: 'The real origin of each, with the popular myths called out by name.' },
  { name: 'How They Collided', text: 'Why these two, out of every idiom in your head, ended up in one sentence.' },
  {
    name: 'The Scorecard',
    text: 'Sense-o-Meter, Mental Image and Seamlessness, totaled into a tier: Bronze Bear, Silver Lining, or the rare Golden Pope.',
  },
  { name: 'The strip', text: 'Four old friends at a game table who never let one slide.' },
];

const friends = [
  {
    name: 'Gus',
    text: 'Says most of the malaphors. Has never noticed a single one.',
    image: gus,
    alt: 'Gus, bald with a big mustache, his shirt dotted with rain, waving a hand mid-sentence.',
  },
  {
    name: 'Pete',
    text: 'Writes every one down in a pocket notebook. Can read back what you said in March.',
    image: pete,
    alt: 'Pete, in round glasses, writing in his notebook at the table.',
  },
  {
    name: 'Teddy',
    text: 'Pictures every blend literally, so you will see the Pope in the woods.',
    image: teddy,
    alt: 'Teddy, curly-haired and wide-eyed, holding a drink at the table.',
  },
  {
    name: 'Walt',
    text: 'Knows where every idiom came from. Or thinks he does.',
    image: walt,
    alt: 'Walt, gray-haired with glasses on his forehead, holding a die and a coffee mug.',
  },
];

const chapters = [
  { name: 'Same Meaning, Different Words', text: 'The classics, plus blends so good they replaced their parents.' },
  { name: 'Same Shape, Same Beat', text: 'Idioms built on the same frame.' },
  { name: 'The Pivot Word', text: 'One shared word lets a sentence switch tracks halfway through.' },
  { name: 'Shared Imagery', text: 'Animals, kitchens, bodies and weather, where the pictures do the blending.' },
  { name: 'Crossed Wires', text: 'Parents that disagree. The funniest collisions in the book.' },
  { name: 'Multi-Car Pileups', text: 'Three or more idioms at once.' },
  { name: 'On Purpose', text: 'The deliberate ones, and everything credited to Yogi Berra.' },
];
---

<BaseLayout
  title={book.title}
  description="A funny, fact-checked field guide to 148 malaphors, mash-ups of two idioms, with real origins, scores and a comic strip for every entry. Paperback and Kindle."
  image={shareImage.src}
  imageAlt={`Cover of ${book.title} by ${book.author}`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="bk-hero">
    <div class="container bk-hero__grid">
      <div class="bk-hero__cover">
        <Image
          src={cover}
          alt={`Cover of ${book.title}: four friends around a green card table`}
          widths={[300, 600]}
          sizes="(max-width: 48rem) 70vw, 300px"
          loading="eager"
        />
      </div>

      <div class="bk-hero__copy">
        <p class="eyebrow">A field guide to malaphors</p>
        <h1>{book.title}</h1>
        <p class="bk-hero__sub">{book.subtitle}</p>
        <p class="bk-hero__by">by {book.author}</p>
        <p class="bk-hero__hook">
          "It's not rocket surgery." Somebody says it in a meeting. Nobody blinks. The point lands, and one person at
          the table starts grinning and cannot stop. That is a malaphor: two idioms that collide in one sentence and
          somehow still make sense. This book collects 148 of them.
        </p>
        <div class="bk-actions">
          <a class="button" href={book.paperbackUrl} rel="noopener" target="_blank">Buy the paperback on Amazon<span class="visually-hidden"> (opens in a new tab)</span></a>
          <a class="button button--ghost" href={book.kindleUrl} rel="noopener" target="_blank">Kindle edition<span class="visually-hidden"> (opens in a new tab)</span></a>
        </div>
        <p class="bk-hero__meta">Full color, {book.pages} pages. Sold and shipped by Amazon.</p>
      </div>
    </div>
  </section>

  <section class="section bk-inside" aria-labelledby="inside-title">
    <div class="container bk-inside__grid">
      <div>
        <h2 id="inside-title">Every entry is a specimen.</h2>
        <p class="lede">Each malaphor gets the full treatment, in five parts.</p>
        <ol class="bk-parts">
          {
            parts.map((p) => (
              <li>
                <strong>{p.name}.</strong> {p.text}
              </li>
            ))
          }
        </ol>
      </div>

      <figure class="bk-sample">
        <Image
          src={stripBridges}
          alt="Comic strip, two panels. Gus points at a model bridge on the table while Teddy counts. Gus: “Easy, Rembrandt. Hubris. The Greeks wrote whole plays about it. Don't count your bridges before you cross them.” Teddy, with three bridges in front of him: “There are three. Is counting hubris now?” Walt, holding his mug: “In those plays, Gus, the man giving that speech dies first.”"
          widths={[640, 1280]}
          sizes="(max-width: 56rem) 100vw, 640px"
        />
        <figcaption>
          <p class="bk-sample__title">Don't count your bridges before you cross them.</p>
          <p>
            <em>The Parents:</em> Don't count your chickens before they hatch + Don't cross that bridge until you come
            to it
          </p>
          <p>
            <em>How They Collided:</em> No shared word, but a shared frame, "don't [verb] your [X] before [Y]." The
            chickens dropped out and the bridges took their place. The advice is still sound. It is just no longer
            about poultry.
          </p>
          <p class="bk-sample__tier">Bronze Bear</p>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section bk-table" aria-labelledby="table-title">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="table-title">Meet the table.</h2>
          <p>Four old friends, one game night, and no malaphor goes unpunished.</p>
        </div>
      </div>
      <ul class="bk-friends">
        {
          friends.map((f) => (
            <li class="bk-friend">
              <Image class="bk-friend__art" src={f.image} alt={f.alt} widths={[160, 320]} sizes="160px" />
              <div>
                <h3>{f.name}</h3>
                <p>{f.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section bk-strips" aria-labelledby="strips-title">
    <div class="container">
      <h2 id="strips-title" class="visually-hidden">Two more strips from the book</h2>
      <div class="bk-strips__grid">
        <Image
          src={stripBirds}
          alt="Comic strip, two panels. Gus points at a square on the board. Gus: “One move, two bonuses. Economics. Kill two birds in the bush.” Teddy pictures Gus holding a stone beside a bush. Teddy: “No birds. Just a rock and a hunch.” Walt: “It turns up in a 1655 quarrel with Hobbes...” Pete: “Nasty, brutish, and short. Like his plans.”"
          widths={[640, 1280]}
          sizes="(max-width: 56rem) 100vw, 580px"
        />
        <Image
          src={stripElephant}
          alt="Comic strip, four panels. A big box sits on the table. Gus: “Fine. I bought the big one. Two hundred miniatures. A man needs a hobby. The 800-pound elephant in the room.” Teddy pictures a baby elephant in a party hat sitting on a chair. Walt: “Where does an eight-hundred-pound gorilla sleep, Gus?” Gus: “Anywhere it wants. Usually during your stories.” Teddy: “He's only a baby. He's wearing a party hat. We're keeping him.” Pete: “That's what Gus said about the last six.”"
          widths={[640, 1280]}
          sizes="(max-width: 56rem) 100vw, 580px"
        />
      </div>
    </div>
  </section>

  <section class="section bk-science" aria-labelledby="science-title">
    <div class="container bk-science__grid">
      <div>
        <h2 id="science-title">Under the jokes, real science.</h2>
        <p>
          Chapter 1 explains why your brain does this, using decades of research on slips of the tongue: how idioms
          are stored as whole chunks, why two phrases with the same meaning race each other to your mouth, and why the
          loser sometimes leaks into the winner. Short "Brain Bit" sidebars teach one more idea at a time.
        </p>
        <p>
          The origins were fact-checked against historical dictionaries and phrase archives. Where an origin is
          disputed, the book says so. Where a popular story is false, it says that too, with some pleasure.
        </p>
      </div>
      <div>
        <h3 class="bk-chapters__title">The chapters sort malaphors by how they collide</h3>
        <ol class="bk-chapters">
          {
            chapters.map((c) => (
              <li>
                <strong>{c.name}.</strong> {c.text}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section bk-buy" aria-labelledby="buy-title">
    <div class="container">
      <div class="bk-buy__panel">
        <div class="bk-buy__copy">
          <h2 id="buy-title">Read it front to back, or one entry while the pasta water boils.</h2>
          <p>For word lovers, trivia fans, and anyone who has ever sat through a meeting.</p>
          <div class="bk-actions">
            <a class="button" href={book.paperbackUrl} rel="noopener" target="_blank">Buy the paperback on Amazon<span class="visually-hidden"> (opens in a new tab)</span></a>
            <a class="bk-buy__kindle" href={book.kindleUrl} rel="noopener" target="_blank">Or get the Kindle edition<span class="visually-hidden"> (opens in a new tab)</span></a>
          </div>
        </div>
        <dl class="bk-details">
          <div><dt>Author</dt><dd>{book.author}</dd></div>
          <div><dt>Format</dt><dd>{book.format}</dd></div>
          <div><dt>Pages</dt><dd>{book.pages}</dd></div>
          <div><dt>ISBN</dt><dd>{book.isbn} (paperback)</dd></div>
          <div><dt>Publisher</dt><dd>{book.publisher}</dd></div>
          <div><dt>Published</dt><dd>{book.publishedLabel}</dd></div>
        </dl>
      </div>
      <p class="bk-send">
        Heard one in the wild? <a href="/malaphors/">Send us your malaphor</a> and it could be in the next volume.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .bk-hero {
    padding-block: var(--space-8) var(--space-7);
  }

  .bk-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 19rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-8);
  }

  .bk-hero__cover img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lg), 0 2px 6px rgb(31 27 22 / 0.2);
    transform: rotate(-2deg);
  }

  .bk-hero h1 {
    margin: 0;
    max-width: 16ch;
    font-size: var(--text-4xl);
    line-height: var(--leading-tight);
  }

  .bk-hero__sub {
    margin: var(--space-3) 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-xl);
    color: var(--color-text-muted);
  }

  .bk-hero__by {
    margin: var(--space-3) 0 var(--space-5);
    font-weight: 650;
  }

  .bk-hero__hook {
    max-width: 36rem;
    margin: 0 0 var(--space-6);
    color: var(--color-text-muted);
  }

  .bk-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .bk-hero__meta {
    margin: var(--space-4) 0 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* What's inside */
  .bk-inside__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: var(--space-8);
  }

  .bk-inside h2,
  .bk-science h2,
  .bk-buy h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-3xl);
  }

  .bk-parts,
  .bk-chapters {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
    padding-left: 1.3em;
  }

  .bk-parts li,
  .bk-chapters li {
    padding-left: var(--space-2);
    color: var(--color-text-muted);
  }

  .bk-parts strong,
  .bk-chapters strong {
    color: var(--color-text);
  }

  .bk-sample {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .bk-sample img,
  .bk-strips img {
    display: block;
    width: 100%;
    height: auto;
  }

  .bk-sample figcaption {
    padding: var(--space-5) var(--space-6) var(--space-6);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .bk-sample figcaption p {
    margin: 0 0 var(--space-3);
  }

  .bk-sample figcaption em {
    color: var(--color-text);
  }

  .bk-sample__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--color-text);
  }

  .bk-sample .bk-sample__tier {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  /* Meet the table */
  .bk-table {
    background: var(--color-surface-alt);
  }

  .bk-friends {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bk-friend {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .bk-friend__art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radius-lg);
    background: var(--brand-parchment);
  }

  .bk-friends h3 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .bk-friends p {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* More strips */
  .bk-strips__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .bk-strips img {
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  /* Science and chapters */
  .bk-science__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .bk-science p {
    color: var(--color-text-muted);
  }

  .bk-chapters__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  /* Buy band, Walnut in both themes like the book module on /malaphors/ */
  .bk-buy__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
    padding: var(--space-7);
    border: 1px solid rgb(246 239 227 / 0.08);
    border-radius: var(--radius-card);
    background: var(--brand-walnut);
    color: var(--brand-parchment);
    box-shadow: var(--shadow-lg);
  }

  .bk-buy h2 {
    color: var(--brand-parchment);
  }

  .bk-buy__copy p {
    margin: 0 0 var(--space-6);
    color: rgb(246 239 227 / 0.85);
  }

  .bk-buy .button {
    background: var(--brand-lamplight);
    border-color: var(--brand-lamplight);
    color: var(--brand-walnut);
  }

  .bk-buy .button:hover {
    background: var(--brand-parchment);
    border-color: var(--brand-parchment);
  }

  .bk-buy__kindle {
    color: var(--brand-parchment);
    font-weight: 600;
    text-underline-offset: 0.2em;
  }

  .bk-buy__kindle:hover {
    color: var(--brand-lamplight);
  }

  .bk-buy a:focus-visible {
    outline: 3px solid var(--brand-lamplight);
    outline-offset: 3px;
  }

  .bk-details {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: rgb(246 239 227 / 0.06);
    font-size: var(--text-sm);
  }

  .bk-details div {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }

  .bk-details dt {
    font-weight: 700;
    color: var(--brand-lamplight);
  }

  .bk-details dd {
    margin: 0;
    color: rgb(246 239 227 / 0.9);
  }

  .bk-send {
    margin: var(--space-6) 0 0;
    text-align: center;
    color: var(--color-text-muted);
  }

  @media (max-width: 56rem) {
    .bk-hero__grid,
    .bk-inside__grid,
    .bk-science__grid,
    .bk-buy__panel {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .bk-hero__cover {
      width: min(70%, 16rem);
      margin-inline: auto;
    }

    .bk-friends {
      grid-template-columns: 1fr;
    }

    .bk-strips__grid {
      grid-template-columns: 1fr;
    }

    .bk-buy__panel {
      padding: var(--space-6) var(--space-5);
    }
  }

  @media (max-width: 30rem) {
    .bk-friend {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      gap: var(--space-4);
    }

    .bk-actions .button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bk-hero__cover img {
      transform: none;
    }
  }
</style>
