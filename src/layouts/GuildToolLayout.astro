---
// Page shell for the Guild of Game Guides toolkit (src/lib/guild-tools.ts).
// Public tools are indexed; kit tools (sent with the email course) are noindex
// and left out of the sitemap. On screen: a back link, a print button and the
// program signup. In print: only the sheet.
import BaseLayout from '@/layouts/BaseLayout.astro';
import CourseForm from '@/components/CourseForm.astro';
import { guildTool, type GuildToolSlug } from '@/lib/guild-tools';

interface Props {
  tool: GuildToolSlug;
  title: string;
  description: string;
  /** The lesson that teaches the tool, for the back link. */
  lesson?: { href: string; title: string };
  printable?: boolean;
}

const { tool, title, description, lesson, printable = true } = Astro.props;
const info = guildTool(tool);
---

<BaseLayout title={title} description={description} noindex={info.access === 'kit'}>
  <div class="container tool-bar" data-pagefind-ignore>
    <nav class="tool-bar__crumbs" aria-label="Breadcrumb">
      <a href="/academy/guild/">Guild of Game Guides</a>
      <span aria-hidden="true">/</span>
      <a href="/academy/guild/toolkit/">Toolkit</a>
    </nav>
    {printable && <button class="button button--ghost" type="button" onclick="window.print()">Print</button>}
  </div>

  <article class="container tool-sheet">
    <header class="tool-sheet__head">
      <p class="eyebrow">The Ludarium Guild of Game Guides &middot; Toolkit</p>
      <h1>{info.name}</h1>
      <p class="tool-sheet__lede">{info.blurb}</p>
    </header>
    <slot />
    <p class="tool-sheet__foot">theludarium.com/academy/guild &middot; The game is the reason. The people are the point.</p>
  </article>

  <aside class="container tool-after" data-pagefind-ignore>
    {lesson && (
      <p>
        Learn how to use it: <a href={lesson.href}>{lesson.title}</a>
      </p>
    )}
    <div class="tool-after__signup">
      <h2>Get the whole toolkit, and the training, free.</h2>
      <p>35 short lessons on teaching any board game, with every printable. Finish with the capstone to earn the title Expert Game Guide.</p>
      <CourseForm course="guild" id="tool-signup" buttonLabel="Start the training, free" />
    </div>
  </aside>
</BaseLayout>

<style>
  .tool-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-5) 0;
  }

  .tool-bar__crumbs {
    display: flex;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }

  .tool-sheet {
    max-width: 52rem;
    margin-block: var(--space-6);
    padding: var(--space-7) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .tool-sheet__head h1 {
    margin: var(--space-2) 0;
    font-size: var(--text-3xl);
  }

  .tool-sheet__lede {
    margin: 0 0 var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .tool-sheet__foot {
    margin: var(--space-7) 0 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .tool-after {
    max-width: 52rem;
    margin-bottom: var(--space-9, var(--space-8));
  }

  .tool-after__signup {
    margin-top: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    background: var(--color-accent-soft);
  }

  .tool-after__signup h2 {
    margin-top: 0;
    font-size: var(--text-2xl);
  }

  @media print {
    @page {
      size: letter;
      margin: 0.5in;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.consent),
    :global(.skip-link),
    :global(.preview-note),
    .tool-bar,
    .tool-after {
      display: none !important;
    }

    :global(body) {
      background: #fff !important;
      color: #2b1e16 !important;
    }

    .tool-sheet {
      max-width: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: #fff;
      font-size: 10.5pt;
    }

    .tool-sheet__head h1 {
      font-size: 20pt;
    }

    .tool-sheet__lede {
      font-size: 11pt;
      margin-bottom: 12pt;
    }
  }
</style>
