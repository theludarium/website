---
import '@fontsource-variable/fraunces';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { SITE } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Root-relative or absolute URL of the share image. Defaults to the branded card at /og/default.png. */
  image?: string;
  imageAlt?: string;
  /** Set for article pages: switches Open Graph to "article" and adds publish times. */
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    section: string;
    tags: string[];
  };
}

const { title, description = SITE.description, noindex = false, image, imageAlt, article } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.shortMtp}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image ?? '/og/default.png', Astro.site).href;
const imageAltText = imageAlt ?? (image ? undefined : `${SITE.name}: ${SITE.tagline}`);

// Site-wide structured data: who publishes the site, and the site itself.
const siteStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE.url}/#organization`,
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/brand/ludarium-logo.png`,
    slogan: SITE.tagline,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    name: SITE.name,
    url: SITE.url,
    publisher: { '@id': `${SITE.url}/#organization` },
    inLanguage: 'en-US',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} articles`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f6efe3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c140f" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={imageUrl} />
    {imageUrl.includes('/og/') && <meta property="og:image:width" content="1200" />}
    {imageUrl.includes('/og/') && <meta property="og:image:height" content="630" />}
    {imageAltText && <meta property="og:image:alt" content={imageAltText} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {imageAltText && <meta name="twitter:image:alt" content={imageAltText} />}
    <script type="application/ld+json" set:html={JSON.stringify(siteStructuredData)} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime.toISOString()} />
          {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
          <meta property="article:section" content={article.section} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <slot name="head" />

    <script is:inline>
      // Apply a saved theme choice before paint so there is no flash.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.dataset.theme = saved;
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
