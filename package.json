{
  "name": "theludarium",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "node scripts/rpg-demo-library.mjs fetch && node scripts/game-night-madness.mjs fetch && astro dev",
    "build": "node scripts/rpg-demo-library.mjs fetch && node scripts/game-night-madness.mjs fetch && astro build && node scripts/rpg-demo-library.mjs copy && node scripts/game-night-madness.mjs copy && pagefind --site dist && node scripts/check-seo.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test 'tests/**/*.test.ts'",
    "dev:functions": "wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply ludarium-visitors --local",
    "db:migrate": "wrangler d1 migrations apply ludarium-visitors --remote"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/mdx": "8.1.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/alegreya-sc": "5.3.0",
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/grenze": "5.3.0",
    "@fontsource/limelight": "5.3.0",
    "@fontsource/pirata-one": "5.3.0",
    "@fontsource/rye": "5.3.0",
    "@fontsource/uncial-antiqua": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource/fraunces": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "22.20.5",
    "pagefind": "^1.5.2",
    "satori": "0.62.0",
    "typescript": "6.0.3",
    "wrangler": "4.151.3"
  }
}
