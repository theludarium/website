{
  "name": "ludarium-ludometer-worker",
  "version": "0.1.0",
  "private": true,
  "description": "The Ludometer: The Ludarium's weekly game index. Daily BGG Hotness snapshots, first-party events, and a Monday score.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply ludometer --local",
    "db:migrate": "wrangler d1 migrations apply ludometer --remote"
  },
  "dependencies": {
    "fast-xml-parser": "4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20250214.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "wrangler": "3.109.2"
  }
}
